private DBXmlDataTable addFOCPrdIntoPrdList(OfficeEngine Eng, string distPromoDistCd, string promoCd, int focPrdIndex, DataRow drPromoToApply, out DataTable dtRecvPrdList)
{
    DataRowCollection drNewOrdPrds = dtOrdPrd.Rows;

    dtRecvPrdList = null;
    DBXmlDataTable dbXmldtFocPrds = getSelFocPrdList2(Eng
                                                    , drPromoToApply["DIST_CD"].ToString()
                                                    , drPromoToApply["PROMO_CD"].ToString()
                                                    );

    foreach (DataRow curRow in dbXmldtFocPrds.Rows)
    {
        DataRow newRow = dtPromoFocPrd.NewRow();
        newRow["PROMO_CD"] = drPromoToApply["PROMO_CD"].ToString();
        newRow["FOC_PRD_CD"] = curRow["PRD_CD"].ToString();
        dtPromoFocPrd.Rows.Add(newRow);
    }

    string sql = @"
    EXEC USP_160_getPromoFocList
         @PROMO_DIST_CD	 = @PROMO_DIST_CD
        ,@PROMO_CD		 = @PROMO_CD
        ,@DIST_CD		 = @DIST_CD
        ,@WHS_CD		 = @WHS_CD
        ,@focPrdIndex	 = @focPrdIndex
        ,@SelFocList_XML = @SelFocList_XML
        ,@CUST_CD        = @CUST_CD
        ,@TXN_DT         = @TXN_DT
        ,@PRDLISTXML     = @PRDLISTXML
        ,@TXN_KEY        = @TXN_KEY
    ";

    string wh = "";
    if (sel_WHS_CD != null)
        wh = sel_WHS_CD;
    else
        wh = txt_WHS_CD;

    DataTable dt = null;

    ///confirm???
//    if (this.gFeatures.gIndiaTax == true)
//    {
        DBSqlParameter[] param = {
                new DBSqlParameter("@PROMO_DIST_CD", distPromoDistCd )
               ,new DBSqlParameter("@PROMO_CD", promoCd )
               ,new DBSqlParameter("@DIST_CD", this.gSession.gDistCd )
               ,new DBSqlParameter("@WHS_CD", wh )
               ,new DBSqlParameter("@focPrdIndex", focPrdIndex )
               ,new DBSqlParameter("@SelFocList_XML", gcs_Promo_Global.GetXmlFormXmlDataTable(dbXmldtFocPrds) )
               ,new DBSqlParameter("@CUST_CD", Cust_cd )
               ,new DBSqlParameter("@TXN_DT", TxnDt )
               ,new DBSqlParameter("@PRDLISTXML", gcs_Promo_Global.GetXmlFormXmlDataTable(this.dtOrdPrd))
               ,new DBSqlParameter("@TXN_KEY", this.InvKey )};
        try
        {
            dt = Eng.DB.LoadDataTable("", sql, param, "Table1");
        }
        catch
        {
            Eng.API.Alert(Eng.Localization.GetText("Error found when getting added FOC Product Listing."));
        }
//    }
//    else
//    {
//        DBSqlParameter[] param = {
//            new DBSqlParameter("@PROMO_DIST_CD", distPromoDistCd )
//           ,new DBSqlParameter("@PROMO_CD", promoCd )
//           ,new DBSqlParameter("@DIST_CD",  this.gSession.gDistCd )
//           ,new DBSqlParameter("@WHS_CD", wh )
//           ,new DBSqlParameter("@focPrdIndex", focPrdIndex )
//           ,new DBSqlParameter("@SelFocList_XML", gcs_Promo_Global.GetXmlFormXmlDataTable(dbXmldtFocPrds) )
//           ,new DBSqlParameter("@CUST_CD", Cust_cd )
//           ,new DBSqlParameter("@TXN_DT", TxnDt )
//           ,new DBSqlParameter("@PRDLISTXML", gcs_Promo_Global.GetXmlFormXmlDataTable(this.dtOrdPrd))
//           ,new DBSqlParameter("@TXN_KEY", "" )};
//        try
//        {
//            dt = Eng.DB.LoadDataTable("", sql, param, "Table1");
//        }
//        catch
//        {
//            Eng.API.Alert(Eng.Localization.GetText("Error found when getting added FOC Product Listing."));
//        }
//    }

    dtRecvPrdList = dt;
    int increase = 0;

    string[] cols = GetOrdPrdColNames(txnMode);
    string PRD_CD_PREVIOUS = "";
    string UOM_CD_PREVIOUS = "";

    string PRD_CD_CURRENT = "";
    string UOM_CD_CURRENT = "";

    string MRP_PREVIOUS = "";//RETURN BY BATCH
    string MRP_CURRENT = "";

    DataRow fodDr_Previous = null;

    string PROMO_INDEX_CURRENT = "";
    string PROMO_INDEX_PREVIOUS = "";

    //Invoice Management for India Environment only
    if (this.gFeatures.gIndiaTax && this.gFeatures.gIndiaInvInd == true && this.txnMode == Enum.TxnMode.INVOICE_EDIT && isInvoicePicked == "True")
    {
        sql = @"SELECT * FROM TXN_INV_ALLOCFOC WHERE INV_KEY=@INV_KEY AND PROMO_CD=@PROMO_CD";
        DataTable dtAllocFoc = null;
        DBSqlParameter[] param2 = {
            new DBSqlParameter("@INV_KEY", invoice_key),
            new DBSqlParameter("@PROMO_CD", drPromoToApply["PROMO_CD"].ToString())
        };

        try
        {
            dtAllocFoc = Eng.DB.LoadDataTable("", sql, param2, "Table1");
            if (dtAllocFoc.Rows.Count > 0)
            {
                if (promo_editRetPrdTable != null)
                {
                    int totalSMLPRD = 0;
                    int totalSMLRETPRD = 0;
                    DataTable tmpRetPrdXmlTable = promo_editRetPrdTable.Copy();
                    foreach (DataRow dr in tmpRetPrdXmlTable.Rows)
                    {
                        if (dr["PRD_SLSTYPE"].ToString() == "F")
                        {
                            totalSMLPRD = 0;
                            totalSMLRETPRD = 0;
                            for (int uom_lvl = 1; uom_lvl <= 4; uom_lvl++)
                            {
                                totalSMLPRD += Convert.ToInt32(Convert.ToInt32(dr["PRD_QTY_" + uom_lvl]) * gcs_Promo_Global.ToInt(dr["CONV_FACTOR_SML_" + uom_lvl].ToString()));
                                totalSMLRETPRD += Convert.ToInt32(Convert.ToInt32(dr["PRD_RET_QTY_" + uom_lvl]) * gcs_Promo_Global.ToInt(dr["CONV_FACTOR_SML_" + uom_lvl].ToString()));
                            }

                            dr["PRD_QTY_1"] = totalSMLPRD - totalSMLRETPRD;
                            dr["PRD_QTY_2"] = 0;
                            dr["PRD_QTY_3"] = 0;
                            dr["PRD_QTY_4"] = 0;
                        }
                    }

                    foreach (DataRow drow in dtAllocFoc.Rows)
                    {
                        foreach (DataRow drow2 in dt.Rows)
                        {
                            if (drow["PRD_CD"].ToString() == drow2["PRD_CD"].ToString() && drow2["PRD_SLSTYPE"].ToString() == "F" && drow["PROMO_INDEX"].ToString() == drow2["PROMO_INDEX"].ToString()
                            && gcs_Promo_Global.ToDecimal(drow["MRP"].ToString()) == gcs_Promo_Global.ToDecimal(drow2["MRP"].ToString()))
                            {
                                foreach (DataRow drEditRet in tmpRetPrdXmlTable.Rows)
                                {
                                    if (drEditRet["PRD_CD"].ToString() == drow2["PRD_CD"].ToString()
                                           && drEditRet["PRD_SLSTYPE"].ToString() == drow2["PRD_SLSTYPE"].ToString()
                                           && gcs_Promo_Global.ToDecimal(drEditRet["MRP"].ToString()) == gcs_Promo_Global.ToDecimal(drow2["MRP"].ToString()))
                                    {
                                        string[] oriPrdQty = { null, drEditRet["PRD_QTY_1"].ToString(), drEditRet["PRD_QTY_2"].ToString(), drEditRet["PRD_QTY_3"].ToString(), drEditRet["PRD_QTY_4"].ToString() };
                                        int[] iUomConv = { -1, gcs_Promo_Global.ToInt(drEditRet["CONV_FACTOR_SML_1"].ToString()), gcs_Promo_Global.ToInt(drEditRet["CONV_FACTOR_SML_2"].ToString()), gcs_Promo_Global.ToInt(drEditRet["CONV_FACTOR_SML_3"].ToString()), gcs_Promo_Global.ToInt(drEditRet["CONV_FACTOR_SML_4"].ToString()) };
                                        string[] sUomCd = { null, drEditRet["PRD_UOM_1"].ToString(), drEditRet["PRD_UOM_2"].ToString(), drEditRet["PRD_UOM_3"].ToString(), drEditRet["PRD_UOM_4"].ToString() };

                                        //start the UOM convertion
                                        for (int lvl = 1; lvl < 4; lvl++)
                                        {
                                            int convqty = 0;
                                            if ((lvl + 1) <= 4)
                                            {
                                                int nextconvf = iUomConv[lvl + 1];
                                                int nextqty = gcs_Promo_Global.ToInt(oriPrdQty[lvl + 1]);
                                                if (nextconvf > 0)
                                                {
                                                    int smlqty = gcs_Promo_Global.ToInt(oriPrdQty[lvl]) * iUomConv[lvl];
                                                    int qtyf = smlqty / nextconvf;
                                                    int qtyr = smlqty % nextconvf;

                                                    oriPrdQty[lvl] = iUomConv[lvl] == 0 ? "0" : "" + (qtyr / iUomConv[lvl]);
                                                    if (qtyf > 0)
                                                    {
                                                        nextqty += qtyf;
                                                        oriPrdQty[lvl + 1] = "" + nextqty;
                                                    }
                                                }
                                            }
                                        }

                                        for (int uom_lvl = 4; uom_lvl > 0; uom_lvl--)
                                        {
                                            if (drow2["UOM" + uom_lvl + "_UOM_CD"].ToString() == drEditRet["PRD_UOM_" + uom_lvl].ToString())
                                            {
                                                drow2["UOM" + uom_lvl + "_PRD_QTY"] = oriPrdQty[uom_lvl];
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        catch
        {
            Eng.API.Alert(Eng.Localization.GetText("Error found when getting allocate FOC product."));
        }
    } //End Invoice Management for India Environment only

