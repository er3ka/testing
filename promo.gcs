// 1. Get a list of Promotion customer entitled
//    > dtPromoEntitled - result table that will store a list of promotion that this order entitle to
//    > dtOrdPrd - parameter that store the list of product ordered (from grid)
//    > dtOrdPromoTemp - result table that will store which product entitle to which promotion

//Feature 48240:Auto Allocation
DBXmlDataTable getFOCPromoDetailByPromo(string promoCd){
    DBXmlDataTable dtPromoDetail = new DBXmlDataTable();
    dtPromoDetail.LoadFromDataTable(this.dtFOCPromoDetailAll.Clone());

    foreach(DataRow drPromoDetail in dtFOCPromoDetailAll.Select("PROMO_CD='" + promoCd + "'" )){
        DataRow drNew = dtPromoDetail.NewRow();
        foreach(DataColumn col in dtFOCPromoDetailAll.Columns){
            drNew[col.ColumnName] = drPromoDetail[col.ColumnName];
        }
        dtPromoDetail.Rows.Add(drNew);
    }
    return dtPromoDetail;
}

//Feature 48240:Auto Allocation
DBXmlDataTable getAllocFocListByPromo(string promoCd){
    DBXmlDataTable dtAllocFocList = new DBXmlDataTable();
    dtAllocFocList.LoadFromDataTable(this.dtPromoAllocFocListAll.Clone());

    foreach(DataRow drAllocFocList in dtPromoAllocFocListAll.Select("PROMO_CD='" + promoCd + "'" )){
        DataRow drNew = dtAllocFocList.NewRow();
        foreach(DataColumn col in dtAllocFocList.Columns){
            drNew[col.ColumnName] = drAllocFocList[col.ColumnName];
        }
        dtAllocFocList.Rows.Add(drNew);
    }
    return dtAllocFocList;
}

private void getAssignFocPrdList(OfficeEngine Eng, string promoDistCd, string promoCd, out DBXmlDataTable dtFocPrd, out DBXmlDataTable dtFocMappingPrd, out DBXmlDataTable dtFocMaxCount)
{
    dtFocPrd = null;
    dtFocMappingPrd = null;
    dtFocMaxCount = null;

    //iTransfer tr = (iTransfer)Eng.API.FindLivePage("pag_T_SelPromo");

    //if( tr != null )
    //{
    string[] promoParam = new string[2] { promoDistCd, promoCd };
    object inParam = (object)promoParam;

    //Dictionary<string, DBXmlDataTable> focPromo = (Dictionary<string, DBXmlDataTable>)tr.Transfer("focPromo",inParam);
    //Dictionary<string, DBXmlDataTable> focPromoMappingPrd = (Dictionary<string, DBXmlDataTable>)tr.Transfer("focPromoMappingPrd",inParam);
    Dictionary<string, DBXmlDataTable> focPromo = this.focPromo;
    Dictionary<string, DBXmlDataTable> focPromoMappingPrd = this.focPromoProduct;

    if (focPromo.ContainsKey(promoCd) && focPromoMappingPrd.ContainsKey(promoCd))
    {
        dtFocPrd = focPromo[promoCd];
        dtFocPrd.DefaultView.Sort = "PRD_CD ASC";
        dtFocPrd.AcceptChanges();

        dtFocMappingPrd = focPromoMappingPrd[promoCd];
        dtFocMappingPrd.DefaultView.Sort = "PRD_CD ASC";
        dtFocMappingPrd.AcceptChanges();
    }
    //}

    if (dtFocPrd == null || dtFocMappingPrd == null)
    {
        string prdList = gcs_Promo_Global.GetXmlFormXmlDataTable(PrdList(Eng));

        bool maxCountFlag = false;
        int maxCount = 0;
        if (this.dtPromoMaxCount != null)
        {
            DataRow[] drMaxCount = this.dtPromoMaxCount.Select("PROMO_CD='" + promoCd + "'");
            if (drMaxCount.Length > 0 && drMaxCount[0]["PROMO_CD"].ToString() != "")
            {
                maxCountFlag = true;
                maxCount = Convert.ToInt32(drMaxCount[0]["MAX_COUNT"].ToString());
            }
        }

        string sql =
            @"EXEC USP_160_getPromoEntitledFocList
                @LANG_CD, @DIST_CD, @CUST_CD, @TXN_DT, @PROMO_DIST_CD, @PROMO_CD, @PRD_XML, @MAX_COUNT, @MAX_COUNT_FLAG, 1, 1";

        DBSqlParameter[] param = new DBSqlParameter[]{
            new DBSqlParameter("@LANG_CD", this.gSession.gLangCd ),
            new DBSqlParameter("@DIST_CD", this.gSession.gDistCd ),
            new DBSqlParameter("CUST_CD", this.Cust_cd),
            new DBSqlParameter("TXN_DT", this.TxnDt),
            new DBSqlParameter("PROMO_DIST_CD", promoDistCd),
            new DBSqlParameter("PROMO_CD", promoCd),
            new DBSqlParameter("PRD_XML", prdList),
            new DBSqlParameter("@MAX_COUNT", maxCount),
            new DBSqlParameter("@MAX_COUNT_FLAG", maxCountFlag)

        };

        DataSet ds = Eng.DB.LoadDataSet("", sql, param, new string[] { "tbl1", "tbl2" });

        dtFocMappingPrd = new DBXmlDataTable();
        dtFocMappingPrd.Columns.Add("PROMO_CD");
        dtFocMappingPrd.Columns.Add("PROMO_INDEX");
        dtFocMappingPrd.Columns.Add("PRD_CD");
        dtFocMappingPrd.Columns.Add("UOM_CD");

        foreach (DataRow dr in ds.Tables[0].Rows)
        {
            DataRow drFocMappingPrd = dtFocMappingPrd.NewRow();
            drFocMappingPrd["PROMO_CD"] = dr["PROMO_CD"];
            drFocMappingPrd["PROMO_INDEX"] = dr["PROMO_INDEX"];
            drFocMappingPrd["PRD_CD"] = dr["PRD_CD"];
            drFocMappingPrd["UOM_CD"] = dr["UOM_CD"];
            dtFocMappingPrd.Rows.Add(drFocMappingPrd);
        }

        dtFocMaxCount = new DBXmlDataTable();
        dtFocMaxCount.Columns.Add("PROMO_CD");
        dtFocMaxCount.Columns.Add("MAX_COUNT");

        dtFocMaxCount.LoadFromDataTable(ds.Tables[1]);

        if (dtFocMaxCount.Rows.Count > 0)
        {
            foreach (DataRow drMC in dtFocMaxCount.Rows)
            {
                string checkMC = "false";
                if (this.dtPromoMaxCountUsed != null)
                {
                    DataRow[] drMCUsed = this.dtPromoMaxCountUsed.Select("PROMO_CD='" + drMC["PROMO_CD"].ToString() + "'");
                    if (drMCUsed.Length > 0)
                    {
                        checkMC = "true";
                    }
                }

                if (checkMC == "false")
                {
                    DataRow drPromoMaxCountUsed = dtPromoMaxCountUsed.NewRow();
                    drPromoMaxCountUsed["PROMO_CD"] = drMC["PROMO_CD"];
                    drPromoMaxCountUsed["MAX_COUNT"] = maxCount;
                    drPromoMaxCountUsed["MAX_COUNT_USED"] = drMC["MAX_COUNT_GIVEN"];
                    dtPromoMaxCountUsed.Rows.Add(drPromoMaxCountUsed);
                }
            }
        }
        if(orderRecalcProcess){
            dtFocPrd = this.getAllocFocListByPromo(promoCd); //Feature 48240:Auto Allocation// getPromoFocListFromDB( Eng , promoDistCd , promoCd );
        }else{
            dtFocPrd = getPromoFocListFromDB( Eng , promoDistCd , promoCd );
        }

    }
}


private DBXmlDataTable PrdList(OfficeEngine Eng)
{
    DBXmlDataTable tmp_Dt = new DBXmlDataTable();
    tmp_Dt.Columns.Add("PRD_CD");
    tmp_Dt.Columns.Add("UOM1_UOM_CD");
    tmp_Dt.Columns.Add("UOM2_UOM_CD");
    tmp_Dt.Columns.Add("UOM3_UOM_CD");
    tmp_Dt.Columns.Add("UOM4_UOM_CD");
    tmp_Dt.Columns.Add("UOM1_PRD_QTY");
    tmp_Dt.Columns.Add("UOM2_PRD_QTY");
    tmp_Dt.Columns.Add("UOM3_PRD_QTY");
    tmp_Dt.Columns.Add("UOM4_PRD_QTY");
    tmp_Dt.Columns.Add("GROSS_AMT");

    //added for india environment only
    if (this.gFeatures.gIndiaTax == true)
    {
        tmp_Dt.Columns.Add("MRP");
    }

    decimal grossAmt = decimal.Zero;

    //Optimization for Product Type Check for All Products using single connection
    if(!this.dtOrdPrd.Columns.Contains("PRD_TYPE"))
    {
        this.dtOrdPrd.Columns.Add("PRD_TYPE", typeof(string));
    }

    string allPrds_Cd = "";
    foreach (DataRow dr in this.dtOrdPrd.Rows)
    {
        if(allPrds_Cd == "")
        {
            allPrds_Cd = dr["PRD_CD"].ToString();
        }
        else
        {
            allPrds_Cd = allPrds_Cd + ", " + dr["PRD_CD"].ToString();
        }
    }

    if(allPrds_Cd != "")
    {
        string sql = @"SELECT PRD_CD, ISNULL(PRD_TYPE,'') AS PRD_TYPE FROM MST_PRD A (NOLOCK) INNER JOIN [dbo].[GetSplitList](',', @ALL_PRD_CD) B ON A.PRD_CD = B.ListItem WHERE SYNCOPERATION <> 'D'";

        DBSqlParameter[] param = new DBSqlParameter[1];
        param[0] = new DBSqlParameter("ALL_PRD_CD", allPrds_Cd);

        DataTable tbl = Eng.DB.LoadDataTable("", sql, param, "Table1");

        if (tbl.Rows.Count > 0)
        {
            foreach(DataRow drPT in tbl.Rows)
            {
                foreach(DataRow drOrdPrd in this.dtOrdPrd.Select("PRD_CD = '"+drPT["PRD_CD"].ToString()+"'"))
                {
                    drOrdPrd["PRD_TYPE"] = drPT["PRD_TYPE"].ToString();
                }
            }
        }
        else
        {
            foreach(DataRow drOrdPrd in this.dtOrdPrd.Rows)
            {
                drOrdPrd["PRD_TYPE"] = "";
            }
        }
    }
    //Till Here Product Type check for All Products using single connection

    foreach (DataRow dr in this.dtOrdPrd.Rows)
    {
        if (this.gFeatures.gIndiaTax == true) //more condition for india
        {
            if (dr["PRD_SLSTYPE"].Equals("F") || dr["PRD_SLSTYPE"].Equals("P") || (dr["CHARGEFOC_IND"] != null && dr["CHARGEFOC_IND"].Equals("True")))
                continue;//filter out Foc and Sample Product and CHARGEFOC_IND = 1
        }
        else
        {
            if (dr["PRD_SLSTYPE"].Equals("F") || dr["PRD_SLSTYPE"].Equals("P"))
                continue;//filter out Foc and Sample Product
            //if (dr["PARENT_PRD"].ToString() == "" && dr["PARENT_UOM"].ToString() == "" && CheckPrdType(Eng, dr["PRD_CD"].ToString()) == "M")
            if (dr["PARENT_PRD"].ToString() == "" && dr["PARENT_UOM"].ToString() == "" && dr["PRD_TYPE"].ToString() == "M")
                continue;//filter out Component Product
        }

        if ((txnMode == Enum.TxnMode.INVOCE_NEW || txnMode == Enum.TxnMode.INVOICE_EDIT || txnMode == Enum.TxnMode.ORDER_NEW || txnMode == Enum.TxnMode.ORDER_EDIT) && !dr["SBY_PROMO"].Equals(string.Empty))
            continue;//filter out SBY Product
        DataRow newRow = tmp_Dt.NewRow();
        newRow["PRD_CD"] = dr["PRD_CD"];
        newRow["UOM1_UOM_CD"] = dr["UOM1_UOM_CD"];
        newRow["UOM2_UOM_CD"] = dr["UOM2_UOM_CD"];
        newRow["UOM3_UOM_CD"] = dr["UOM3_UOM_CD"];
        newRow["UOM4_UOM_CD"] = dr["UOM4_UOM_CD"];
        newRow["UOM1_PRD_QTY"] = dr["UOM1_PRD_QTY"];
        newRow["UOM2_PRD_QTY"] = dr["UOM2_PRD_QTY"];
        newRow["UOM3_PRD_QTY"] = dr["UOM3_PRD_QTY"];
        newRow["UOM4_PRD_QTY"] = dr["UOM4_PRD_QTY"];

        if (this.gFeatures.gIndiaTax == true) //more column for india
            newRow["MRP"] = dr["MRP"];

        //gross amt is needed for promotion with amount type
        grossAmt = decimal.Zero;
        for (int i = 4; i > 0; i--)
        {
            if (dr["UOM" + i + "_GROSS_AMT"].ToString() != "" && gcs_Promo_Global.ToDecimal(dr["UOM" + i + "_GROSS_AMT"]) > decimal.Zero)
            {
                grossAmt = grossAmt + gcs_Promo_Global.ToDecimal(dr["UOM" + i + "_GROSS_AMT"]);
            }
        }
        newRow["GROSS_AMT"] = grossAmt;

        tmp_Dt.Rows.Add(newRow);
    }

    //Optimization for Product Type Check
    if(this.dtOrdPrd.Columns.Contains("PRD_TYPE"))
    {
        this.dtOrdPrd.Columns.Remove("PRD_TYPE");
    }

    return tmp_Dt;
}

private string CheckPrdType(OfficeEngine Eng, string prd_cd)
{
    string sql = @"SELECT PRD_TYPE FROM MST_PRD
            WHERE PRD_CD = @PRD_CD
            AND SYNCOPERATION <>'D'";

    DBSqlParameter[] param = new DBSqlParameter[1];
    param[0] = new DBSqlParameter("PRD_CD", prd_cd);

    try
    {
        DataTable tbl = Eng.DB.LoadDataTable("", sql, param, "Table1");

        if (tbl.Rows.Count > 0)
        {
            return tbl.Rows[0]["PRD_TYPE"].ToString();
        }
        else
        {
            return "";
        }
    }
    catch
    {
        Eng.API.Alert(Eng.Localization.GetText("Error found when getting Product Type."));
        return "";
    }
}


private decimal getheSameUOMPrdQty(DataRow drOrdPrd, string buyUOM_CD)
{
    //20111228 BeeTze fix promotion issue
    decimal prdQty = decimal.Zero;
    decimal buyUomConvFactor = decimal.Zero;
    for (int lvl = 1; lvl <= 4; lvl++)
    {
        if (drOrdPrd["UOM" + lvl + "_UOM_CD"].Equals(buyUOM_CD))
        {
            buyUomConvFactor = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
        }
        prdQty += gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
    }
    if (buyUomConvFactor > decimal.Zero)
        // 20121012 SungChun fix promotion issue not calculate dist_amt correctly
        return prdQty / buyUomConvFactor;
    else
        return decimal.Zero;
}


private DBXmlDataTable getPromoFocListFromDB(OfficeEngine Eng, string promoDistCd, string promoCd)
{
    bool maxCountFlag = false;
    int maxCount = 0;
    if (this.dtPromoMaxCount != null)
    {
        DataRow[] drMaxCount = this.dtPromoMaxCount.Select("PROMO_CD='" + promoCd + "'");
        if (drMaxCount.Length > 0 && drMaxCount[0]["PROMO_CD"].ToString() != "")
        {
            maxCountFlag = true;
            maxCount = Convert.ToInt32(drMaxCount[0]["MAX_COUNT"].ToString());
        }
    }

    string prdList = gcs_Promo_Global.GetXmlFormXmlDataTable(PrdList(Eng));
    string sql = @"
        DECLARE @TYPE AS CHAR(1)

        SET @TYPE = ISNULL((
        SELECT TYPE FROM MST_PROMO (NOLOCK)
        WHERE PROMO_CD = @PROMO_CD
        AND DIST_CD = @PROMO_DIST_CD),'')

        IF @TYPE = 'D'
        BEGIN
            EXEC USP_160_getPromoEntitledAllocFocList
                    @LANG_CD = @LANG_CD
                   ,@DIST_CD = @DIST_CD
                   ,@CUST_CD = @CUST_CD
                   ,@TXN_DT  = @TXN_DT
                   ,@PROMO_DIST_CD = @PROMO_DIST_CD
                   ,@PROMO_CD = @PROMO_CD
            	   ,@PRD_XML = @PRD_XML
            	   ,@MAX_COUNT = @MAX_COUNT
            	   ,@MAX_COUNT_FLAG = @MAX_COUNT_FLAG
        END
        ELSE
        BEGIN
            EXEC USP_160_getRebateAllocFocList
        	    @DIST_CD = @DIST_CD
	           ,@CUST_CD = @CUST_CD
               ,@PROMO_DIST_CD = @PROMO_DIST_CD
               ,@PROMO_CD = @PROMO_CD
        END
        ";
    DBSqlParameter[] param = new DBSqlParameter[] {
                new DBSqlParameter("@LANG_CD", this.gSession.gLangCd )
               ,new DBSqlParameter("@DIST_CD", this.gSession.gDistCd )
               ,new DBSqlParameter("@CUST_CD", this.Cust_cd )
               ,new DBSqlParameter("@TXN_DT", this.TxnDt )
               ,new DBSqlParameter("@PROMO_DIST_CD", promoDistCd )
               ,new DBSqlParameter("@PROMO_CD", promoCd )
               ,new DBSqlParameter("@PRD_XML", prdList)
               ,new DBSqlParameter("@MAX_COUNT", maxCount)
               ,new DBSqlParameter("@MAX_COUNT_FLAG", maxCountFlag)
    };
    DBXmlDataTable dbXmlDt = new DBXmlDataTable();
    try
    {
        //dbXmlDt.Load(Eng.DB.ExecuteReader("", sql, param));
        DataSet ds = Eng.DB.LoadDataSet("", sql, param, new string[] {"tbl1"});
        dbXmlDt.LoadFromDataTable(ds.Tables[0]);
    }
    catch { }

    return dbXmlDt;
}



private void updateFocPromoTotalBuy(string promoCd)
{
    DataTable dtPromoIdx = new DataTable();
    dtPromoIdx.Columns.Add("PROMO_INDEX");

    foreach (DataRow dr in dtOrdPromo.Rows)
    {
        DataRow[] promoIdxExists = dtPromoIdx.Select("PROMO_INDEX='" + dr["PROMO_INDEX"].ToString() + "'");
        if (promoIdxExists.Length <= 0)
        {
            DataRow drPromoIdx = dtPromoIdx.NewRow();
            drPromoIdx["PROMO_INDEX"] = dr["PROMO_INDEX"];
            dtPromoIdx.Rows.Add(drPromoIdx);
        }
    }

    foreach (DataRow drPromoIdx in dtPromoIdx.Rows)
    {
        DataRow[] foundDrs = dtOrdPromo.Select("PROMO_CD='" + promoCd + "' AND PROMO_INDEX='" + drPromoIdx["PROMO_INDEX"].ToString() + "' AND PRD_SLSTYPE='S'");

        decimal sumBuy = decimal.Zero;
        foreach (DataRow dr in foundDrs)
        {
            sumBuy += gcs_Promo_Global.ToDecimal(dr["PRD_BUY"]);
        }
        foreach (DataRow dr in foundDrs)
        {
            dr["TTL_BUY"] = sumBuy.ToString("F" + this.gSetting.amtDecimal);
        }
    }
}


// 4. Insert Promotion FOC Product
private void addPromoFOCPrd(OfficeEngine Eng)
{
    int focPrdIndex = 0;
    int ordPrdIndex = 0;

	//Feature 48240:Auto Allocation
    if (!this.orderRecalcProcess){
        dtSelectedFocList.Clear();
    }
    foreach (DataRow drPromoToApply in dtPromoToApply.Select("", "PROMO_SEQ ASC")) // 0
    {
        //if( popupSelectPromo( Eng , drPromoToApply ) )
        //return;



    	//Feature 48240:Auto Allocation
        if (this.orderRecalcProcess && this.dtOrderRecalcQPS != null && this.dtOrderRecalcQPS.Select("PROMO_CD='" +drPromoToApply["PROMO_CD"].ToString()+ "'").Length <=0){
            if(!checkAssginedFOCORProduct( drPromoToApply["PROMO_CD"].ToString())){
                if( dtPromoSelectedPrev == null )
                    dtPromoSelectedPrev = dtPromoSelected;
                if (this.orderRecalcProcess){
                    DataRow[] drResultTxn = tblOderRecalcResult.Select("TXN_KEY='" + this.InvKey + "'");
                    if (drResultTxn.Length <= 0){
                    	DataRow drResultNew = tblOderRecalcResult.NewRow();
                    	drResultNew["TXN_KEY"] = this.InvKey;
                    	drResultNew["STATUS"] = "F";
                    	drResultNew["ERR_MESSAGE"] = "Manual allocation for FOC. \nPlease Open Order and click on Promotion Button and re-select FOC.\n";
                    	drResultNew["ERR_MESSAGE2"] = drPromoToApply["PROMO_CD"].ToString() + " -  " + drPromoToApply["PROMO_DESC"].ToString();
                    	tblOderRecalcResult.Rows.Add(drResultNew);
                    }
                }
                return;
            }
        }


        DataRow[] drsSelectedFOC = dtSelectedFocList.Select("PROMO_CD='" + drPromoToApply["PROMO_CD"].ToString() + "'");
        foreach(DataRow drSelectedFOC in drsSelectedFOC){
           dtSelectedFocList.Rows.Remove(drSelectedFOC);
        }
		//Feature 48240:Auto Allocation

        focPrdIndex = 0;
        ordPrdIndex = 0;
        string promo_cd = drPromoToApply["PROMO_CD"].ToString();
        foreach (DataRow drOrdPromo in dtOrdPromoDiscApplied.Select("PROMO_CD = '" + promo_cd + "'", "PRD_INDEX DESC"))
        {
            string prd_Cd = drOrdPromo["PRD_CD"].ToString();
            string filter = "(PRD_CD = '" + prd_Cd + "' OR PARENT_PRD = '" + prd_Cd + "')"
                          + " AND PRD_SLSTYPE = 'S'" + filterOutSBY();
            if(this.gFeatures.gIndiaTax)
                filter = "(PRD_CD = '" + prd_Cd + "') AND PRD_SLSTYPE = 'S'" + filterOutSBY();

            if(((DataRow[])dtOrdPromo.Select("PROMO_CD <> '" + promo_cd + "' AND PRD_SLSTYPE = 'F'")).Length > 0)// other promo foc added//90403
            {
                foreach(DataRow drPromo2 in dtOrdPromo.Select("PROMO_CD = '" + promo_cd + "'","PRD_INDEX DESC"))//95339
                {
                    int cur_prdIndex = Convert.ToInt32(drPromo2["PRD_INDEX"]);
                    prd_Cd = drPromo2["PRD_CD"].ToString();
                    filter = "(PRD_CD = '" + prd_Cd + "' OR PARENT_PRD = '" + prd_Cd + "')"
                          + " AND PRD_SLSTYPE = 'S'" + filterOutSBY();
                    if(this.gFeatures.gIndiaTax)
                        filter = "(PRD_CD = '" + prd_Cd + "') AND PRD_SLSTYPE = 'S'" + filterOutSBY();

                    int exst_prdIndex = 0;
                    foreach(DataRow drOrd2 in dtOrdPrd.Select(filter, "PRD_INDEX DESC"))
                    {
                        exst_prdIndex = Convert.ToInt32(drOrd2["PRD_INDEX"]);
                        break;
                    }

                    if(cur_prdIndex > exst_prdIndex)
                    {
                        focPrdIndex = cur_prdIndex + 1;
                        ordPrdIndex = cur_prdIndex + 1;
                    }
                    else
                    {
                        focPrdIndex = exst_prdIndex + 1;
                        ordPrdIndex = exst_prdIndex + 1;
                    }
                    break;
                }
            }
            else
            {
                foreach (DataRow drOrdPrd in dtOrdPrd.Select(filter, "PRD_INDEX DESC")) // 2
                {
                    focPrdIndex = Convert.ToInt32(drOrdPrd["PRD_INDEX"]) + 1;
                    ordPrdIndex = Convert.ToInt32(drOrdPrd["PRD_INDEX"]) + 1;
                    break;
                } // 2
            }
            break;
        } // 1

        if (focPrdIndex == 0)
        {
            foreach (DataRow drOrdPrd in dtOrdPrd.Select(""))
            {
                focPrdIndex = Convert.ToInt32(drOrdPrd["PRD_INDEX"]);
                ordPrdIndex = Convert.ToInt32(drOrdPrd["PRD_INDEX"]);
            }
            focPrdIndex = focPrdIndex + 1;
            ordPrdIndex = ordPrdIndex + 1;
        }

        DataTable dtRecvPrdList = null;
        DBXmlDataTable focPrds = addFOCPrdIntoPrdList(Eng
                                                     , drPromoToApply["DIST_CD"].ToString()
                                                     , drPromoToApply["PROMO_CD"].ToString()
                                                     , focPrdIndex
                                                     , drPromoToApply
                                                     , out dtRecvPrdList
                                                     );

        decimal sumFocListPrc = decimal.Zero;
        DataTable tblTmp = focPrds.DefaultView.ToTable();
        tblTmp.DefaultView.Sort = "LinkPromoIdx DESC, PRD_CD ASC, UOM_CD ASC";

        tblTmp = tblTmp.DefaultView.ToTable();

        string foc_prd_cd_prev = "";
        string foc_uom_cd_prev = "";

        string foc_promo_idx_prev = "";

        DataTable dtSumFOCListPrc = new DataTable();
        dtSumFOCListPrc.Columns.Add("PROMO_INDEX");
        dtSumFOCListPrc.Columns.Add("DISC_AMT");

        DataRow dr_prev = null;
        foreach (DataRow dr in tblTmp.Rows)
        {
            // Insert into dtOrdPromo
            string foc_prd_cd = dr["PRD_CD"].ToString();
            string foc_uom_cd = dr["UOM_CD"].ToString();

            string foc_promo_idx = Convert.ToString(dr["LinkPromoIdx"]);
            decimal foc_qty = gcs_Promo_Global.ToDecimal(dr["FOC_QTY"]);
            decimal foc_listprc = getOrdPrdFocListPrc(foc_prd_cd, int.Parse(foc_promo_idx), dtRecvPrdList);
            decimal disc_amt = foc_qty * foc_listprc;

            if (foc_prd_cd == foc_prd_cd_prev && dr_prev != null
                && foc_promo_idx == foc_promo_idx_prev)
            {
                string disc_amt_prev = dr_prev["DISC_AMT"].ToString();
                if (disc_amt_prev != "")
                    disc_amt_prev = (disc_amt + gcs_Promo_Global.ToDecimal(disc_amt_prev)).ToString("F" + this.gSetting.amtDecimal);
                else
                    disc_amt_prev = disc_amt.ToString("F" + this.gSetting.amtDecimal);

                dr_prev["DISC_AMT"] = disc_amt_prev;
            }
            else
            {
                DataRow newOrdPromo = dtOrdPromo.NewRow();
                newOrdPromo["PRD_CD"] = foc_prd_cd;
                newOrdPromo["PRD_INDEX"] = focPrdIndex++;
                newOrdPromo["PRD_SLSTYPE"] = "F";
                newOrdPromo["PROMO_CD"] = drPromoToApply["PROMO_CD"];
                newOrdPromo["PROMO_INDEX"] = foc_promo_idx;
                newOrdPromo["PROMO_SEQ"] = drPromoToApply["PROMO_SEQ"];
                newOrdPromo["MECHANIC_TYPE"] = "1";
                newOrdPromo["DISC_PERC"] = "0.00";
                newOrdPromo["DISC_AMT"] = disc_amt.ToString("F" + this.gSetting.amtDecimal);
                newOrdPromo["DISC_SPENT_AMT"] = "0.00";

                //match with TXN_ORDPRD.PRD_INDEX
                bool existsFocPrdIdx = false;
                foreach (DataRow drOrdPromo in dtOrdPromo.Rows)
                {
                    if (drOrdPromo["PRD_CD"].ToString() != newOrdPromo["PRD_CD"].ToString()
                        && drOrdPromo["PROMO_CD"].ToString() == newOrdPromo["PROMO_CD"].ToString()
                        && drOrdPromo["PRD_SLSTYPE"].ToString() == newOrdPromo["PRD_SLSTYPE"].ToString()
                        && drOrdPromo["PRD_INDEX"].ToString() == ordPrdIndex.ToString())
                    {
                        ordPrdIndex++; //add ORDPRD INDEX by 1 for different FOC products in promotion
                        newOrdPromo["ORDPRD_INDEX"] = ordPrdIndex;
                        newOrdPromo["ORDPRD_INDEX_TMP"] = ordPrdIndex;
                        existsFocPrdIdx = true;
                        newOrdPromo["MSL_IND"] = drOrdPromo["PRD_CD"].ToString();// fix 48191
                        break;
                    }
                    else if (drOrdPromo["PRD_CD"].ToString() == newOrdPromo["PRD_CD"].ToString()
                        && drOrdPromo["PROMO_CD"].ToString() == newOrdPromo["PROMO_CD"].ToString()
                        && drOrdPromo["PRD_SLSTYPE"].ToString() == newOrdPromo["PRD_SLSTYPE"].ToString())
                    {
                        newOrdPromo["ORDPRD_INDEX"] = drOrdPromo["PRD_INDEX"].ToString();
                        newOrdPromo["ORDPRD_INDEX_TMP"] = drOrdPromo["PRD_INDEX"].ToString();
                        existsFocPrdIdx = true;
                        newOrdPromo["MSL_IND"] = drOrdPromo["PRD_CD"].ToString();// fix 48191
                        break;
                    }
                }
                if (existsFocPrdIdx == false)
                {
                    newOrdPromo["ORDPRD_INDEX"] = ordPrdIndex;
                    newOrdPromo["ORDPRD_INDEX_TMP"] = ordPrdIndex;
                }
                newOrdPromo["AVG_SLS"] = "0.00";
                dtOrdPromo.Rows.Add(newOrdPromo);

                foc_prd_cd_prev = foc_prd_cd;
                foc_uom_cd_prev = foc_uom_cd;

                foc_promo_idx_prev = foc_promo_idx;

                dr_prev = newOrdPromo;
            }

            DataRow[] sumFOCListPrcExists = dtSumFOCListPrc.Select("PROMO_INDEX='" + foc_promo_idx + "'");
            if (sumFOCListPrcExists.Length <= 0)
            {
                DataRow drSumFOCListPrc = dtSumFOCListPrc.NewRow();
                drSumFOCListPrc["PROMO_INDEX"] = foc_promo_idx;
                drSumFOCListPrc["DISC_AMT"] = disc_amt.ToString("F" + this.gSetting.amtDecimal);
                dtSumFOCListPrc.Rows.Add(drSumFOCListPrc);
            }
            else
            {
                foreach (DataRow drSumFOCListPrc in dtSumFOCListPrc.Select("PROMO_INDEX='" + foc_promo_idx + "'"))
                {
                    decimal temp_disc_amt = decimal.Zero;
                    temp_disc_amt = gcs_Promo_Global.ToDecimal(drSumFOCListPrc["DISC_AMT"]) + gcs_Promo_Global.ToDecimal(disc_amt.ToString("F" + this.gSetting.amtDecimal));
                    drSumFOCListPrc["DISC_AMT"] = temp_disc_amt.ToString("F" + this.gSetting.amtDecimal);
                }
            }

            sumFocListPrc += gcs_Promo_Global.ToDecimal(disc_amt.ToString("F" + this.gSetting.amtDecimal));

            DataRow selFocPrd = dtSelectedFocList.NewRow();
            selFocPrd["PROMO_CD"] = drPromoToApply["PROMO_CD"];
            selFocPrd["PRD_CD"] = dr["PRD_CD"];
            selFocPrd["PRD_DESC"] = dr["PRD_DESC"];
            selFocPrd["UOM_CD"] = dr["UOM_CD"];
            selFocPrd["UOM_DESC"] = dr["UOM_DESC"];
            selFocPrd["FOC_QTY"] = dr["FOC_QTY"];
            selFocPrd["IsOrg"] = dr["IsOrg"];
            selFocPrd["LinkPrdcatCd"] = dr["LinkPrdcatCd"];
            selFocPrd["LinkPromoIdx"] = dr["LinkPromoIdx"];
            selFocPrd["LinkPrdCatLevel"] = dr["FOC_PRDCAT_LEVEL"];
            selFocPrd["PROMO_FREQ"] = dr["PROMO_FREQ"];
            selFocPrd["Tier"] = dr["Tier"];
            selFocPrd["PRD_INDEX"] = dr_prev["PRD_INDEX"];//RETURN BY BATCH
            ///confirm???
            if (this.gFeatures.gIndiaTax == true)
            {
                if(tblTmp.Columns.Contains("MRP"))//96064//96042
                    selFocPrd["MRP"] = dr["MRP"];
                else
                    selFocPrd["MRP"] = decimal.Zero;
            }
            else
            {
                selFocPrd["ORI_FOC_QTY"] = dr["ORI_FOC_QTY"];
            }
            dtSelectedFocList.Rows.Add(selFocPrd);

            if (((DataRow[])dtPromoDetail.Select("PROMO_CD = '" + drPromoToApply["PROMO_CD"].ToString()
                + "' AND PROMO_INDEX = '" + dr["LinkPromoIdx"].ToString() + "' AND PRD_CD = '"
                + dr["PRD_CD"].ToString() + "' AND PRD_INDEX = '" + dr_prev["PRD_INDEX"].ToString() + "'")).Length <= 0)
            {
                DataRow drPromoDtl = dtPromoDetail.NewRow();
                drPromoDtl["PROMO_CD"] = drPromoToApply["PROMO_CD"];
                drPromoDtl["PROMO_INDEX"] = dr["LinkPromoIdx"];
                drPromoDtl["PRD_CD"] = dr["PRD_CD"];
                drPromoDtl["PRD_INDEX"] = dr_prev["PRD_INDEX"];
                dtPromoDetail.Rows.Add(drPromoDtl);
            }
        }

        //Update record that Selling Product with PRD_INDEX
        foreach (DataRow dr in dtOrdPromo.Select("PRD_SLSTYPE='S'"))
        {
            string filter = "     PRD_CD      = '" + dr["PRD_CD"].ToString() + "'"
                          + " AND PRD_SLSTYPE = 'S'";
            ///confirm???
            if (this.gFeatures.gIndiaTax == true)
            {
                filter = filter + " AND PRD_INDEX   = '" + dr["ORDPRD_INDEX"].ToString() + "'"
                                  + filterOutSBY();
            }
            else
            {
                filter = filter + filterOutSBY();
            }
            dr["PRD_INDEX"] = dtOrdPrd.Select(filter)[0]["PRD_INDEX"];
        }

        hideFOCPrice(dtOrdPrd);

        //Update Ratio Assignment
        DataRow lastDr = null;
        decimal sumUsedDiscAmt = decimal.Zero;

        foreach (DataRow drSumFOCListPrc in dtSumFOCListPrc.Rows)
        {
            foreach (DataRow dr in dtOrdPromo.Select("PROMO_CD='" + promo_cd + "' AND PROMO_INDEX='" + drSumFOCListPrc["PROMO_INDEX"].ToString() + "' AND PRD_SLSTYPE='S'"))
            {
                dr["TTL_DISC_AMT"] = drSumFOCListPrc["DISC_AMT"];
                decimal spentAmt = (gcs_Promo_Global.ToDecimal(dr["PRD_BUY"]) / gcs_Promo_Global.ToDecimal(dr["TTL_BUY"]) * gcs_Promo_Global.ToDecimal(drSumFOCListPrc["DISC_AMT"]));
                if (spentAmt.ToString() == "NaN")
                    spentAmt = 0;
                dr["DISC_SPENT_AMT"] = spentAmt.ToString("F" + this.gSetting.amtDecimal);

                lastDr = dr;
                sumUsedDiscAmt += gcs_Promo_Global.ToDecimal(dr["DISC_AMT"]);
            }
        }
    }  // 0
       ///this.calcOrdPrdPromoDisc(Eng,obj,taxList,dtOrdPrd, dtPromoEntitled, dtOrdPromo, dtOrdPromoDiscApplied, dtSDiscList,dtPromoUnitDiscCalc,dtPromoDiscExceeded,taxDetail,txnMode, sales_disc_ind, cust_grp_disc_perc,promo_price_group,CustDisc,this.gSetting.amtDecimal,gTxnUOMDisplayFormat);
    this.calcOrdPrdPromoDisc(Eng, this.dtOrdPrd);
    if (this.dist_price_ind == true)//pricing
    {
        this.calc_hq = true;
        this.calcOrdPrdPromoDisc(Eng, this.dtOrdPrdHq);
        this.calc_hq = false;
    }
}

private void hideFOCPrice(DataTable dtOrdPrd)
{
    foreach (DataRow drOrdPrd in dtOrdPrd.Select("PRD_SLSTYPE = 'F'"))
    {
        drOrdPrd["PRD_LISTPRC"] = "0";
    }
}

private decimal getOrdPrdFocListPrc(string prdCd, int promo_idx, DataTable dtRecvPrdList)
{
    DataRow[] foundDr = dtRecvPrdList.Select("PRD_CD = '" + prdCd + "' AND PROMO_INDEX = " + promo_idx.ToString());
    return gcs_Promo_Global.ToDecimal(foundDr[0]["PRD_LISTPRC"]);
}

//Feature 48240:Auto Allocation
DataSet getFOCPrdListByPromo(string promoCd){

    DataTable tblFocPrdMapping = dsPromoEntitiledFocListAll.Tables[0].Clone();
    DataTable tblFocMaxCount = dsPromoEntitiledFocListAll.Tables[1].Clone();
    DataTable tblFocEntitled = dsPromoEntitiledFocListAll.Tables[2].Clone();

    foreach(DataRow drFocPrdMapping in dsPromoEntitiledFocListAll.Tables[0].Select("PROMO_CD='" + promoCd + "'" )){
        DataRow drNew = tblFocPrdMapping.NewRow();
        foreach(DataColumn col in tblFocPrdMapping.Columns){
            drNew[col.ColumnName] = drFocPrdMapping[col.ColumnName];
        }
        tblFocPrdMapping.Rows.Add(drNew);
    }

    foreach(DataRow drFocMaxCount in dsPromoEntitiledFocListAll.Tables[1].Select("PROMO_CD='" + promoCd + "'" )){
        DataRow drNew = tblFocMaxCount.NewRow();
        foreach(DataColumn col in tblFocMaxCount.Columns){
            drNew[col.ColumnName] = drFocMaxCount[col.ColumnName];
        }
        tblFocMaxCount.Rows.Add(drNew);
    }

    foreach(DataRow drFocEntitled in dsPromoEntitiledFocListAll.Tables[2].Select("PROMO_CD='" + promoCd + "'" )){
        DataRow drNew = tblFocEntitled.NewRow();
        foreach(DataColumn col in tblFocEntitled.Columns){
            drNew[col.ColumnName] = drFocEntitled[col.ColumnName];
        }
        tblFocEntitled.Rows.Add(drNew);
    }


    DataSet ds = new DataSet();
    ds.Tables.Add(tblFocPrdMapping);
    ds.Tables.Add(tblFocMaxCount);
    ds.Tables.Add(tblFocEntitled);
    return ds;
}

//Feature 48240:Auto Allocation
bool checkAssginedFOCORProduct(string promoCd)
{
    DataSet dsEntitledFOCList = this.getFOCPrdListByPromo(promoCd);
    DataTable dtEntitledFOCList = null;

    DataTable dtPromoDetails = this.getFOCPromoDetailByPromo(promoCd);

    if (dsEntitledFOCList == null || dsEntitledFOCList.Tables.Count < 2)
        return false;

    if (dtPromoDetails == null || dtPromoDetails.Rows.Count <= 0)
        return false;

    dtEntitledFOCList = dsEntitledFOCList.Tables[2];

    if (dtEntitledFOCList.Rows.Count <= 0)
        return false;

    DataRow[] drFOCLists = dtEntitledFOCList.Select("FOC_QTY <> 0");

    if (drFOCLists.Length <= 0)
        return false;

    if (this.dtSelectedFocList == null || dtSelectedFocList.Rows.Count <= 0)
        return false;

    string strTier = "";
    string focPrdCatLvl = "";
    string focPrdCatCd = "";
    string focUomCd = "";
    int focFactorValue = 0;
    int focQty = 0;

    DBXmlDataTable focPrd = new DBXmlDataTable();
    focPrd.LoadFromDataTable(this.dtSelectedFocList.Clone());
    if (!focPrd.Columns.Contains("FOC_PRDCAT_LEVEL")){
        focPrd.Columns.Add("FOC_PRDCAT_LEVEL");
    }
    int assignedFOCQty = 0;
    foreach(DataRow drFOCList in drFOCLists){
        strTier = drFOCList["PROMO_INDEX"].ToString();
        DataRow[] drPromoDetails = dtPromoDetails.Select("PROMO_INDEX='" + strTier + "'");

        if (drPromoDetails.Length <= 0)
            return false;

        focFactorValue = gcs_Promo_Global.ToInt( drPromoDetails[0]["FACTOR_VALUE"].ToString());
//        if (focFactorValue != 0)
//            return false;

        focPrdCatLvl = drFOCList["FOC_PRDCAT_LEVEL"].ToString();
        focPrdCatCd = drFOCList["FOC_PRDCAT_CD"].ToString();
        focUomCd = drFOCList["FOC_UOM_CD"].ToString();
        if (focFactorValue != 0){
            focQty += gcs_Promo_Global.ToInt(drFOCList["FOC_QTY"].ToString());
        }else{
            focQty = gcs_Promo_Global.ToInt(drFOCList["FOC_QTY"].ToString());
        }
        //assignedFOCQty = 0;
        foreach(DataRow drAssignedFOC in this.dtSelectedFocList.Select("PROMO_CD='" + promoCd + "'" +
            " AND LinkPromoIdx = '" + strTier + "' AND UOM_CD='" + focUomCd + "'")){

            DataRow[] dtCheck = focPrd.Select("PROMO_CD ='"+ promoCd +"' AND PRD_CD='"+ drAssignedFOC["PRD_CD"].ToString()+"' AND UOM_CD='"+ drAssignedFOC["UOM_CD"].ToString()+"' AND LinkPromoIdx='"+ drAssignedFOC["LinkPromoIdx"].ToString()+"'");
            if(dtCheck.Length == 0){
                assignedFOCQty += gcs_Promo_Global.ToInt( drAssignedFOC["FOC_QTY"].ToString());
               // if (gcs_Global.ToInt( drAssignedFOC["AVAILABLE_STK"].ToString()) < gcs_Global.ToInt( drAssignedFOC["FOC_QTY"].ToString()))
               //     return false;

                DataRow newFocRow = focPrd.NewRow();
                foreach(DataColumn col in this.dtSelectedFocList.Columns){
                    newFocRow[col.ColumnName] = drAssignedFOC[col.ColumnName];
                }
                newFocRow["FOC_PRDCAT_LEVEL"] = drAssignedFOC["LinkPrdCatLevel"];
                focPrd.Rows.Add(newFocRow);
            }
        }
    }
    if(assignedFOCQty != focQty)
            return false;

    if( this.assignFOCProductList.ContainsKey( promoCd ) )
    {
        assignFOCProductList[ promoCd ] = focPrd;
    }
    else{
        assignFOCProductList.Add(promoCd, focPrd);
    }
    return true;
}


