internal void applyValidTierPromo()
{
    this.prepareAllOrdPromoDisc();
    this.updateAllOrdPrdDisc(this.Eng);
}

private void prepareAllOrdPromoDisc()
{
	DataTable dtPromoEntitled = this.dtPromoEntitled;
	DataTable dtPromoEntitledDtl = this.dtPromoEntitledDtl;
	DataTable dtOrdPromoDiscApplied = this.dtOrdPromoDiscApplied;
	DBXmlDataTable dtOrdPromoMappingPrd = this.dtOrdPromoMappingPrd;
	DataTable dtOrdPrd = this.dtOrdPrd;

	for (int i=0;i<2;i++)
	{
		if (i == 1 && this.dist_price_ind == false)
			break;
		else if (i == 1 && this.dist_price_ind == true)
		{
			dtPromoEntitled = this.dtPromoEntitledHq;
			dtPromoEntitledDtl = this.dtPromoEntitledDtlHq;
			dtOrdPromoDiscApplied = this.dtOrdPromoDiscAppliedHq;
			dtOrdPromoMappingPrd = this.dtOrdPromoMappingPrdHq;
			dtOrdPrd = this.dtOrdPrdHq;
		}

        string prepPromo = string.Empty;

		foreach (DataRow drPromoEntitledDtl in dtPromoEntitledDtl.Rows)
		{
			// current promo code
			string promo_Cd = drPromoEntitledDtl["PROMO_CD"].ToString();

			// for FOC
			if (drPromoEntitledDtl["MECHANIC_TYPE"].Equals("1"))
			{
				//If mix(foc and discAmt) promo ,only get max tier promo detail
				if (isMixFocPromoDtl(promo_Cd, dtPromoEntitledDtl))
				{
					prepPromo = promo_Cd;
				}
			}

			//only apply max tier promo detail
			if (prepPromo == promo_Cd)
				continue;

			// If the Single/Multiple Promotion=Single, then only one Promotion can be applied per Product
			// Note: drPromoEntitledDtl is already sorted by seq (start from lowest category seq)
			// Check product has been used in other promotion
			if (this.single_promo.Contains("S"))
			{
				bool notApplyPromo = false;

				foreach (DataRow drOrdPromoMappingPrd in dtOrdPromoMappingPrd.Select("PROMO_CD = '" + promo_Cd + "'"))
				{
					string prd_Cd = drOrdPromoMappingPrd["PRD_CD"].ToString();
					DataRow[] dr_prd = dtOrdPromoDiscApplied.Select("PRD_CD = '" + prd_Cd + "'");
					if (dr_prd.Length > 0)
					{
						notApplyPromo = true;
						break;
					}
				}
				if (notApplyPromo)
					continue;
			}

			decimal ttlGrossAmt = decimal.Zero;
			foreach (DataRow drOrdPromoMappingPrd in dtOrdPromoMappingPrd.Select("PROMO_CD = '" + promo_Cd + "'"))
			{
				string prd_Cd = drOrdPromoMappingPrd["PRD_CD"].ToString();
				string filter = " PRD_CD = '" + prd_Cd + "'"
							  + " AND PROMO_IND     = 'True'"
							  + " AND PRD_SLSTYPE   = 'S'"
							  + filterOutSBY();

				if (this.gFeatures.gIndiaTax)
				{
					filter += " AND ISNULL(CHARGEFOC_IND,'False') <> 'True'";
					string schemeMRP = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_MRP"].ToString();
					if (schemeMRP == "True")
					{
						filter = filter + " AND MRP = " + drOrdPromoMappingPrd["MRP"].ToString();
					}
				}

				//Add Discount value to product listing
				foreach (DataRow drOrdPrd in dtOrdPrd.Select(filter))
				{
					string schemeTDR = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_TDR"].ToString();
					string promoSql = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["PROMO_SEQ"].ToString();
					filter = "     PROMO_CD      = '" + drPromoEntitledDtl["PROMO_CD"].ToString() + "'" +
							 " AND PRD_CD        = '" + drOrdPromoMappingPrd["PRD_CD"].ToString() + "'" +
							 " AND PROMO_SEQ     = '" + promoSql + "'" +
							 " AND MECHANIC_TYPE = '" + drPromoEntitledDtl["MECHANIC_TYPE"].ToString() + "'" +
							 " AND TTLBUY_QTY    = '" + drPromoEntitledDtl["TTLBUY_QTY"].ToString() + "'" +
							 " AND FACTOR_VALUE  = '" + drPromoEntitledDtl["FACTOR_VALUE"].ToString() + "'" +
							 " AND APPLY_ON      = '" + drPromoEntitledDtl["APPLY_ON"].ToString() + "'" +
							 " AND PRD_INDEX     = '" + drOrdPrd["PRD_INDEX"].ToString() + "'";

					if (dtOrdPromoDiscApplied.Select(filter).Length <= 0)
					{
						decimal prdGrossAmt = decimal.Zero;
						if(schemeTDR == "True")
						{
							decimal uom1GrossAmtTax = decimal.Zero;
							decimal uom2GrossAmtTax = decimal.Zero;
							decimal uom3GrossAmtTax = decimal.Zero;
							decimal uom4GrossAmtTax = decimal.Zero;
							uom1GrossAmtTax = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_GROSS_AMT"]) * (1 + (gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100))).ToString("F" + this.gSetting.amtDecimal));
							uom2GrossAmtTax = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(drOrdPrd["UOM2_GROSS_AMT"]) * (1 + (gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100))).ToString("F" + this.gSetting.amtDecimal));
							uom3GrossAmtTax = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(drOrdPrd["UOM3_GROSS_AMT"]) * (1 + (gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100))).ToString("F" + this.gSetting.amtDecimal));
							uom4GrossAmtTax = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(drOrdPrd["UOM4_GROSS_AMT"]) * (1 + (gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100))).ToString("F" + this.gSetting.amtDecimal));
							prdGrossAmt = uom1GrossAmtTax + uom2GrossAmtTax + uom3GrossAmtTax + uom4GrossAmtTax;
							//prdGrossAmt = gcs_Global.ToDecimal((prdGrossAmt * (1 + (gcs_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100))).ToString("F"+Global.amtDecimal));
						}
						else
						{
							prdGrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_GROSS_AMT"]) +
										  gcs_Promo_Global.ToDecimal(drOrdPrd["UOM2_GROSS_AMT"]) +
										  gcs_Promo_Global.ToDecimal(drOrdPrd["UOM3_GROSS_AMT"]) +
										  gcs_Promo_Global.ToDecimal(drOrdPrd["UOM4_GROSS_AMT"]);
						}
						ttlGrossAmt = ttlGrossAmt + prdGrossAmt;

						DataRow drOrdPromoDiscApplied = dtOrdPromoDiscApplied.NewRow();
						drOrdPromoDiscApplied["PROMO_CD"] = promo_Cd;
						drOrdPromoDiscApplied["PRD_CD"] = drOrdPromoMappingPrd["PRD_CD"];
						drOrdPromoDiscApplied["PROMO_SEQ"] = promoSql;
						drOrdPromoDiscApplied["MECHANIC_TYPE"] = drPromoEntitledDtl["MECHANIC_TYPE"];
						drOrdPromoDiscApplied["TTLBUY_QTY"] = drPromoEntitledDtl["TTLBUY_QTY"];
						drOrdPromoDiscApplied["FACTOR_VALUE"] = drPromoEntitledDtl["MECHANIC_TYPE"].ToString() == "1" ? decimal.Zero : drPromoEntitledDtl["FACTOR_VALUE"];
						drOrdPromoDiscApplied["APPLY_ON"] = drPromoEntitledDtl["APPLY_ON"];
						drOrdPromoDiscApplied["PRD_INDEX"] = drOrdPrd["PRD_INDEX"];
						drOrdPromoDiscApplied["PROMO_INDEX"] = drPromoEntitledDtl["PROMO_INDEX"];
						drOrdPromoDiscApplied["ACCU_TTLBUY_QTY"] = drPromoEntitledDtl["ACCU_TTLBUY_QTY"];
						drOrdPromoDiscApplied["ACCU_TTLBUY_AMT"] = drPromoEntitledDtl["ACCU_TTLBUY_AMT"];
						drOrdPromoDiscApplied["ACCU_DISCAMT"] = drPromoEntitledDtl["ACCU_DISCAMT"];
						drOrdPromoDiscApplied["ACCU_DISCAMT_TAX"] = drPromoEntitledDtl["ACCU_DISCAMT_TAX"];
						drOrdPromoDiscApplied["LAST_ENT_TTLBUY"] = drPromoEntitledDtl["LAST_ENT_TTLBUY"];
						drOrdPromoDiscApplied["COUNT_DISCPRD"] = drPromoEntitledDtl["COUNT_DISCPRD"];
						drOrdPromoDiscApplied["PRD_GROSS_AMT"] = prdGrossAmt;
						drOrdPromoDiscApplied["TBUY_QTY"] = drPromoEntitledDtl["TBUY_QTY"];
						drOrdPromoDiscApplied["TBUY_AMT"] = drPromoEntitledDtl["TBUY_AMT"];
						drOrdPromoDiscApplied["FOR_EVERY"] = drPromoEntitledDtl["FOR_EVERY"];
						drOrdPromoDiscApplied["FOR_EVERY_RECUR_COUNT"] = drPromoEntitledDtl["FOR_EVERY_RECUR_COUNT"];
						drOrdPromoDiscApplied["TTLBUY_ENTITLED"] = drPromoEntitledDtl["TTLBUY_ENTITLED"];
						dtOrdPromoDiscApplied.Rows.Add(drOrdPromoDiscApplied);
					}
				}

				foreach (DataRow dr in dtOrdPromoDiscApplied.Select("PROMO_CD='" + promo_Cd + "'"))
				{
					dr["TTL_GROSS_AMT"] = ttlGrossAmt;
				}
			}

			// update as previous promo
			if (prepPromo != promo_Cd)
			{
				prepPromo = promo_Cd;
			}
		}


		if (dtOrdPromoDiscApplied.Rows.Count > 0)
		{
	        DataTable tmpPromoMaxCountUsed = this.dtPromoMaxCountUsed.Copy();
		    int index = 0;
			// Delete promotion(value or %) which is not apply to any product from max count used DataTable
			foreach (DataRow drPromoMaxCountUsed in tmpPromoMaxCountUsed.Rows)
			{
				if (dtOrdPromoDiscApplied.Select("PROMO_CD='" + drPromoMaxCountUsed["PROMO_CD"].ToString() + "'").Length <= 0)
				{
					dtPromoMaxCountUsed.Rows.RemoveAt(index);
			    }
			    index++;
			}

			List<DataRow> delRows = new List<DataRow>();
			foreach (DataRow dr in dtOrdPromoDiscApplied.Rows)
			{
				if (dr["MECHANIC_TYPE"].ToString() == "1")
					delRows.Add(dr);
			}
			foreach (DataRow dr in delRows)
				dtOrdPromoDiscApplied.Rows.Remove(dr);
		}
	}
}

private string filterOutSBY()
{
    if (this.txnMode == Enum.TxnMode.INVOCE_NEW || this.txnMode == Enum.TxnMode.INVOICE_EDIT ||
        this.txnMode == Enum.TxnMode.ORDER_NEW || this.txnMode == Enum.TxnMode.ORDER_EDIT)
        return " AND SBY_PROMO = ''";
    else
        return string.Empty;

}

private bool isMixFocPromoDtl(string promoCd, DataTable dtPromoEntitledDtl)
{
    bool bHasFoc = false;
    bool bHasNonFoc = false;
    foreach (DataRow dr in dtPromoEntitledDtl.Select("PROMO_CD='" + promoCd + "'"))
    {
        if (dr["MECHANIC_TYPE"].Equals("1"))
            bHasFoc = true;
        else if (!dr["MECHANIC_TYPE"].Equals("1"))
            bHasNonFoc = true;
    }
    return bHasFoc && bHasNonFoc;
}

/*
    補註:
    在 dtOrdPrd 裡面的 "PRD_DISC" 猜測原本用意是為了Promotion 所使用 dicsAmount 暫存值
    但在 Multi-Promotion,則無義
*/
// Update discount amount for every product
// Only cpu for drOrdPromoTempApplied
// Old Name:updateOrdPrdDisc
private void updateAllOrdPrdDisc(OfficeEngine Eng)
{
    DataTable dtAll = null;
	DataTable dtPromo = null;
	DataTable dtPromoApplied = null;
	DataTable dtInvLvlPromoPerUOM = null;
	DBXmlDataTable dtOrdPromoMappingPrd = null;
	DBXmlDataTable dtPromoEntitled = null;
    this.calc_hq = false;
    for (int i=0; i<2; i++)//pricing
    {
        if (this.gFeatures.gIndiaTax || i == 0)
		{
            dtAll = this.dtOrdPrd;
            dtPromo = this.dtOrdPromo;
            dtPromoApplied = this.dtOrdPromoDiscApplied;
            dtInvLvlPromoPerUOM = this.dtInvLvlPromoPerUOM;
            dtOrdPromoMappingPrd = this.dtOrdPromoMappingPrd;
            dtPromoEntitled = this.dtPromoEntitled;
            this.calc_hq = false;
        }
		else if (!this.gFeatures.gIndiaTax && i == 1 && this.dist_price_ind == true)
        {
			dtAll = this.dtOrdPrdHq;
            dtPromo = this.dtOrdPromoHq;
            dtPromoApplied = this.dtOrdPromoDiscAppliedHq;
            dtInvLvlPromoPerUOM = this.dtInvLvlPromoPerUOMHq;
            dtOrdPromoMappingPrd = this.dtOrdPromoMappingPrdHq;
            dtPromoEntitled = this.dtPromoEntitledHq;
            this.calc_hq = true;
		}

        if (i == 1 && this.dist_price_ind == false && dtOrdPrdHq == null)
            break;

		dtPromoApplied.DefaultView.Sort = "PROMO_SEQ ASC,MECHANIC_TYPE ASC";
		dtPromoApplied.AcceptChanges();
		dtInvLvlPromoPerUOM.Clear();

		// sum up chnl group discount of each uom
		decimal sum1 = 0;
		decimal sum2 = 0;
		decimal sum3 = 0;
		decimal sum4 = 0;

		decimal tmpCustChnlDiscTtl = 0;
		if (!this.gFeatures.gIndiaTax)
		{
			foreach (DataRow drOPrd in dtAll.Rows)
			{
				if(drOPrd.Table.Columns.Contains("CUST_CHNL_DISC"))
				{
					sum1 += gcs_Promo_Global.ToDecimal(drOPrd["UOM1_CUST_CHNL_DISC"]);
					sum2 += gcs_Promo_Global.ToDecimal(drOPrd["UOM2_CUST_CHNL_DISC"]);
					sum3 += gcs_Promo_Global.ToDecimal(drOPrd["UOM3_CUST_CHNL_DISC"]);
					sum4 += gcs_Promo_Global.ToDecimal(drOPrd["UOM4_CUST_CHNL_DISC"]);
				}
			}
			tmpCustChnlDiscTtl = sum1 + sum2 + sum3 + sum4;
		}
		decimal totalDiscAmt = decimal.Zero; //fix 57970

		string[] uomPrdDisc = new string[4];
		foreach (DataRow drOrdPromoDiscApplied in dtPromoApplied.Select())
		{
			string promo_Cd = drOrdPromoDiscApplied["PROMO_CD"].ToString();
			string prd_Cd = drOrdPromoDiscApplied["PRD_CD"].ToString();
			string buyUOM_CD = dtPromoEntitled.Select("PROMO_CD='" + promo_Cd + "'")[0]["TTLBUY_UOM_CD"].ToString();
			string buyType = dtPromoEntitled.Select("PROMO_CD='" + promo_Cd + "'")[0]["DTL_TYPE"].ToString();
			string schemeQPS = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_QPS"].ToString();
			string discMethod = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["DISC_METHOD"].ToString();
			string promoType = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["TYPE"].ToString();
			string schemeDynamic = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_DYNAMIC"].ToString();
			string schemeProrata = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_PRORATA"].ToString();
			string schemeRange = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_RANGE"].ToString();
			string schemeTDR = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_TDR"].ToString(); //TODO:;TDR
			string schemeCOMBI = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_COMBI"].ToString();
			string schemeFOREVERY = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["FOR_EVERY_FLAG"].ToString();
			string avg_Sls = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["AVG_SLS"].ToString();
			string msl_Ind = dtOrdPromoMappingPrd.Select("PROMO_CD = '" + promo_Cd + "' AND PRD_CD ='" + prd_Cd + "'")[0]["MSL_IND"].ToString();
			string ttlbuy_type = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["TTLBUY_TYPE"].ToString();
			string promo_progress = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["PROMO_PROGRESS"].ToString();

			decimal qpsAccuDiscAmtTax = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["ACCU_DISCAMT_TAX"]);

			string filter = "     PRD_CD        = '" + prd_Cd + "'"
						  //+ " AND PRINCIPAL_IND = 'P'" // remove by sung chun - Distributor code unable to apply promo due to principal_ind
						  + " AND PROMO_IND     = 'True'"
						  + " AND PRD_SLSTYPE   = 'S'"
						  + " AND PRD_INDEX   = '" + drOrdPromoDiscApplied["PRD_INDEX"].ToString() + "'" // add in prd_index to avoid duplicate records
						  + filterOutSBY();

			// filter out chargable foc (invoice management feature) && scheme TDR for india
			if (this.gFeatures.gIndiaTax)
			{
				schemeTDR = dtPromoEntitled.Select("PROMO_CD = '" + promo_Cd + "'")[0]["SCHEME_TDR"].ToString();
				filter += " AND ISNULL(CHARGEFOC_IND,'False') <> 'True'";
				uomPrdDisc = new string[4];
			}
			else
				schemeTDR = "False"; //fix STD QPS not apply on CN/Return

			DataRow[] rows = dtAll.Select(filter);


			decimal allProductGrossAmtWithTax = 0;

			if (this.gFeatures.gIndiaTax && schemeTDR == "True")
			{//TODO:TDR
				//use for TDR
				allProductGrossAmtWithTax = this.CalculateAllProductGrossAmtTax(dtAll.Select());
			}

			foreach (DataRow drOrdPrd in rows)
			{
				decimal promoDiscAmt = decimal.Zero;
				string mechanicType = drOrdPromoDiscApplied["MECHANIC_TYPE"].ToString();
				string applyOn = drOrdPromoDiscApplied["APPLY_ON"].ToString();
				decimal factorValue = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["FACTOR_VALUE"]);
				decimal prd_disc = decimal.Zero;
				decimal prd_disc_uom = decimal.Zero;
				decimal grossRatio = decimal.Zero;

				decimal qpsNewAccuDiscAmt = decimal.Zero;
				decimal qpsDiffAccuDiscAmt = decimal.Zero;
				decimal qpsEntTtlBuy = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTLBUY_ENTITLED"]);
				decimal qpsNewAccuTtlBuyQty = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["ACCU_TTLBUY_QTY"]);
				decimal qpsNewAccuTtlBuyAmt = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["ACCU_TTLBUY_AMT"]);
				decimal qpsAccuDiscAmt = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["ACCU_DISCAMT"]);
				decimal qpsLastEntTtlBuy = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["LAST_ENT_TTLBUY"]);
				decimal qpsCountDiscPrd = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["COUNT_DISCPRD"]);
				decimal prdListPrcDisc = decimal.Zero;
				decimal listAccuPrcDisc = decimal.Zero;//fix 57970
				decimal prdListPrc = decimal.Zero;
				decimal unit_disc = decimal.Zero;
				decimal totalDisc = decimal.Zero;
				decimal uomXPrdQty, uomXUomConvfactor;
				decimal ProrataBuyQty = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TBUY_QTY"]);
				decimal ProrataBuyAmt = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TBUY_AMT"]);
				decimal promoForEveryEnt = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["FOR_EVERY"]);
				decimal promoForEveryRecurCount = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["FOR_EVERY_RECUR_COUNT"]);
				decimal defUomConvFactor = gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);
				decimal ttlBuy_Qty = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTLBUY_QTY"]); //TODO:TDR2

				decimal prd_rate = decimal.Zero;
				decimal custDiscAmt = decimal.Zero;
				decimal rateAfterDisc = decimal.Zero;
				decimal roundedMRP = decimal.Zero;
				decimal InvPromoDiscAmt = decimal.Zero;

				decimal prdGrossTotalTax = 0;
				decimal prdDiscTDR = 0;
				decimal amtOrQty = gethePrdAmount(drOrdPrd, defUomConvFactor);
				decimal prdGrossAmtTax =0;
				decimal prdTax = 0;
				decimal custChnlDiscPerc = decimal.Zero;

				//fix 52955
				if(schemeRange == "True")
				{
					if(buyType == "Q")
						qpsEntTtlBuy = ProrataBuyQty;

					else if (buyType == "A")
						qpsEntTtlBuy = ProrataBuyAmt;
				}

				if(drOrdPrd.Table.Columns.Contains("CUST_CHNL_DISC_PERC"))
					custChnlDiscPerc = gcs_Promo_Global.ToDecimal(drOrdPrd["CUST_CHNL_DISC_PERC"]);

				//Use gross amt with tax to calculate
				if (this.gFeatures.gIndiaTax && schemeTDR == "True")
				{//TODO:TDR
					if (schemeFOREVERY == "True")
					{
						if(promoForEveryEnt == 0)
							promoForEveryRecurCount = 1;
						else if (buyType == "A")
							promoForEveryRecurCount = (decimal)EnhancedMath.RoundDown((double)(allProductGrossAmtWithTax / promoForEveryEnt), 0);
					}

					prdTax = gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"]); //TODO:TDR7
					prdGrossAmtTax = GetProductGrossAmtWithTax(drOrdPrd, prdTax); //TODO:TDR7
				}
				else if(schemeFOREVERY == "True" && schemeProrata == "False")//87172
				{
				    if (buyType == "A")
						promoForEveryRecurCount = (decimal)EnhancedMath.RoundDown((double)(ProrataBuyAmt / promoForEveryEnt), 0);
				    else if (buyType == "Q")
						promoForEveryRecurCount = (decimal)EnhancedMath.RoundDown((double)(ProrataBuyQty / promoForEveryEnt), 0);
				}

				if (this.gFeatures.gIndiaTax)
				{
					prd_rate = obj.Rate;
					roundedMRP = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["MRP"]).ToString("F" + this.gSetting.amtDecimal));
				}

				if (applyOn == "1") //Per UOM
				{
					if (mechanicType == "2") //Discount by Value
					{
						if (schemeQPS == "False")
						{
							prd_disc = factorValue;
							promoDiscAmt = factorValue * amtOrQty;
							unit_disc = prd_disc;

							if (schemeProrata == "False") //Pro-rata No
							{
								if (buyType == "Q") // Buy Type = Quantity
								{
									prd_disc = factorValue;
									//promoDiscAmt = getPrdProRataDiscQ(Eng, drOrdPrd, buyUOM_CD, qpsEntTtlBuy, ProrataBuyQty, factorValue, prd_Cd, mechanicType); //69847
									promoDiscAmt = getPrdProRataDiscQ(Eng, drOrdPrd, buyUOM_CD, qpsEntTtlBuy, ProrataBuyQty, factorValue, prd_Cd, mechanicType, applyOn, schemeFOREVERY, promoForEveryEnt); //69847//10061
									prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
								}
								else if (buyType == "A")
								{
									prd_disc = factorValue;
									promoDiscAmt = getPrdProRataDiscA(Eng, drOrdPrd, buyUOM_CD, qpsEntTtlBuy, ProrataBuyAmt, factorValue, prd_Cd, mechanicType, schemeTDR, schemeFOREVERY, promoForEveryEnt, promo_progress, ProrataBuyQty);//80182
									prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
								}

								if (schemeCOMBI == "True")
								{
									///forevery
									if (schemeFOREVERY == "True")
										prd_disc = factorValue * promoForEveryRecurCount;
									else
										prd_disc = factorValue;

									if (this.gFeatures.gIndiaTax)
									{
										///forevery
										if (schemeFOREVERY == "True")
											promoDiscAmt = factorValue * promoForEveryRecurCount;
										else
											promoDiscAmt = factorValue;
									}
									else
									{
										promoDiscAmt = 0;
									}
								}

								if (this.gFeatures.gIndiaTax && schemeTDR == "True")
								{
									decimal ttl_tax_sum = decimal.Zero;
									DataRow[] drsTaxSum = dtPrdTaxSum.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "' AND (MRP='" + drOrdPrd["MRP"].ToString() + "' OR MRP='" + roundedMRP + "')");
									if (drsTaxSum.Length > 0)
									{
										ttl_tax_sum = gcs_Promo_Global.ToDecimal(drsTaxSum[0]["TAX_SUM"].ToString());
									}
									else
									{
										obj.PRD_CD = drOrdPrd["PRD_CD"].ToString();
										obj.HSN_CD = drOrdPrd["HSN_CD"].ToString();
										obj.MRP = gcs_Promo_Global.ToDecimal(drOrdPrd["MRP"].ToString());
										SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTr = obj.CalculateTax(taxList);

										DataRow newPrdTax = dtPrdTaxSum.NewRow();
										newPrdTax["PRD_CD"] = drOrdPrd["PRD_CD"].ToString();
										newPrdTax["MRP"] = drOrdPrd["MRP"].ToString();
										newPrdTax["TAX_SUM"] = obj.TaxSumPerc;
										if (dtAll != dtOrdPrdHq)
										dtPrdTaxSum.Rows.Add(newPrdTax);
										ttl_tax_sum = obj.TaxSumPerc;
									}
									if (buyType == "Q" || schemeCOMBI == "True")
										prd_disc = prd_disc / (1 + (ttl_tax_sum / 100));
									cust_disc_amt = (prd_rate - prd_disc) * (CustDisc / 100);
								}
							}
							else if (schemeProrata == "True") //Pro-rata Yes
							{
								if (this.gFeatures.gIndiaTax)
								{
									if (schemeTDR == "True")
									{
										decimal ttl_tax_sum = decimal.Zero;
										DataRow[] drsTaxSum = dtPrdTaxSum.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "' AND (MRP='" + drOrdPrd["MRP"].ToString() + "' OR MRP='" + roundedMRP + "')");
										if (drsTaxSum.Length > 0)
										{
											ttl_tax_sum = gcs_Promo_Global.ToDecimal(drsTaxSum[0]["TAX_SUM"].ToString());
										}
										else
										{
											obj.PRD_CD = drOrdPrd["PRD_CD"].ToString();
											obj.HSN_CD = drOrdPrd["HSN_CD"].ToString();
											obj.MRP = gcs_Promo_Global.ToDecimal(drOrdPrd["MRP"].ToString());
											SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTr = obj.CalculateTax(taxList);
											DataRow newPrdTax = dtPrdTaxSum.NewRow();
											newPrdTax["PRD_CD"] = drOrdPrd["PRD_CD"].ToString();
											newPrdTax["MRP"] = drOrdPrd["MRP"].ToString();
											newPrdTax["TAX_SUM"] = obj.TaxSumPerc;
											if (dtAll != dtOrdPrdHq)
											dtPrdTaxSum.Rows.Add(newPrdTax);
											ttl_tax_sum = obj.TaxSumPerc;
										}
										prd_disc = prd_disc / (1 + (ttl_tax_sum / 100));
										cust_disc_amt = (prd_rate - prd_disc) * (CustDisc / 100);
									}

									promoDiscAmt = 0;
									for (int lvl = 1; lvl <= 4; lvl++)
									{
										if (!drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") && drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() != "" && gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) > decimal.Zero)
										{
											string prdQty1 = drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString();
											string prdConvSml = drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString();
											promoDiscAmt += gcs_Promo_Global.ToDecimal((prd_disc * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) / defUomConvFactor).ToString("F" + this.gSetting.amtDecimal));
										}
									}
								}
								else
								{
									prd_disc = factorValue;
									promoDiscAmt = factorValue * gethePrdAmount(drOrdPrd, defUomConvFactor);
								}
							}

							for (int lvl = 1; lvl <= 4; lvl++)
							{
								uomXUomConvfactor = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_CONVFACTOR") || drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString() == "")
								? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
								uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
								? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
								if (uomXPrdQty > decimal.Zero)
								{
									prdListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
										? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
									prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
										? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);
									unit_disc = prd_disc * uomXUomConvfactor / defUomConvFactor;
									drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;

									if (schemeTDR == "True") //TODO:TDR3
									{
										prdListPrc = gcs_Promo_Global.ToDecimal(prdListPrc * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100));
										decimal sml = gcs_Promo_Global.ToDecimal(drOrdPrd[string.Format("UOM{0}_ORG_QTY",lvl)]);
										decimal tax = gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"]);
										decimal defUomQty = sml / defUomConvFactor;
										decimal disc = 0;

										if(buyType == "Q")
										{
											decimal part1 = 0;
											decimal part2 = 0;
											if(schemeProrata == "True")
											{
												part1 = defUomQty * factorValue;
												part2 = 1;
											}
											else
											{
												part1 = defUomQty / ProrataBuyQty * factorValue;

												if(schemeFOREVERY == "True")
													part2 = (decimal)EnhancedMath.RoundDown((double)(ProrataBuyQty / promoForEveryEnt),0) * ttlBuy_Qty;
												else part2 = ttlBuy_Qty;
											}
											//disc = Math.Round((part1 * part2) / (1 + (tax/100)), 4);
											disc = gcs_Promo_Global.ToDecimal(((part1 * part2) / (1 + (tax/100))).ToString("F" + this.gSetting.amtDecimal));
										}
										else
										{
											decimal part1 = 0 ;
											decimal part2 = 0;
											if(schemeProrata == "True")
											{
												part1 = defUomQty * factorValue;
												part2 = 1;
											}
											else
											{
												part1 = defUomQty / allProductGrossAmtWithTax * factorValue;

												if(schemeFOREVERY == "True")
													part2 = (decimal)EnhancedMath.RoundDown((double)(allProductGrossAmtWithTax / promoForEveryEnt),0) * ttlBuy_Qty;
												else part2 = ttlBuy_Qty;
											}
											//disc = Math.Round((part1 * part2) / (1 + (tax/100)), 4);
											disc = gcs_Promo_Global.ToDecimal(((part1 * part2) / (1 + (tax/100))).ToString("F" + this.gSetting.amtDecimal));
										}

										unit_disc = disc / defUomQty;

										drOrdPrd[string.Format("UOM{0}_DISC_AMT",lvl)] = disc; //will be zerorized later.
									}
									if (this.gFeatures.gIndiaTax)
									{
										//rateAfterDisc = Math.Round(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]), 4);
										rateAfterDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]).ToString("F4"));
										custDiscAmt = custDiscAmt + gcs_Promo_Global.ToDecimal((obj.CUST_DISC_AMT * (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]))).ToString("F" + this.gSetting.amtDecimal));
										uomPrdDisc[lvl - 1] = unit_disc.ToString();
									}
								}
							}
							if (this.gFeatures.gIndiaTax)
							{
								if (drOrdPrd.Table.Columns.Contains("CUST_DISC_AMT"))
								{
									drOrdPrd["CUST_DISC_AMT"] = gcs_Promo_Global.ToDecimal(custDiscAmt.ToString("F" + this.gSetting.amtDecimal));
								}
							}
						}
						else
						{
							if (buyType == "Q")
							{
								if (schemeProrata == "False")
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsEntTtlBuy * factorValue).ToString("F" + this.gSetting.amtDecimal));
								else if (schemeProrata == "True")    // chin tong qps prorata = yes
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsNewAccuTtlBuyQty * factorValue).ToString("F" + this.gSetting.amtDecimal));

								qpsDiffAccuDiscAmt = qpsNewAccuDiscAmt - qpsAccuDiscAmt;
								qpsDiffAccuDiscAmt = getQpsDiffAccuDiscAmt(promo_Cd, factorValue, qpsNewAccuDiscAmt, qpsAccuDiscAmt, qpsDiffAccuDiscAmt);
								if(gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]) > 0)
								    promoDiscAmt = (qpsDiffAccuDiscAmt * gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]));
								prd_disc = promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor);
							}
							else if (buyType == "A")
							{
								if (schemeProrata == "False")
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsNewAccuTtlBuyQty / qpsNewAccuTtlBuyAmt * qpsEntTtlBuy * factorValue).ToString("F" + this.gSetting.amtDecimal));
								else if (schemeProrata == "True")    // chin tong qps prorata = yes
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsNewAccuTtlBuyQty * factorValue).ToString("F" + this.gSetting.amtDecimal));

								qpsDiffAccuDiscAmt = qpsNewAccuDiscAmt - qpsAccuDiscAmt;
								qpsDiffAccuDiscAmt = getQpsDiffAccuDiscAmt(promo_Cd, factorValue, qpsNewAccuDiscAmt, qpsAccuDiscAmt, qpsDiffAccuDiscAmt);
								promoDiscAmt = (qpsDiffAccuDiscAmt * gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]));
								prd_disc = promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor);
							}

							// apply TDR to QPS
							if (this.gFeatures.gIndiaTax && schemeTDR == "True")
							{
								decimal ttl_tax_sum = decimal.Zero;
								DataRow[] drsTaxSum = dtPrdTaxSum.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "' AND (MRP='" + drOrdPrd["MRP"].ToString() + "' OR MRP='" + roundedMRP + "')");
								if (drsTaxSum.Length > 0)
								{
									ttl_tax_sum = gcs_Promo_Global.ToDecimal(drsTaxSum[0]["TAX_SUM"].ToString());
								}
								else
								{
									obj.PRD_CD = drOrdPrd["PRD_CD"].ToString();
									obj.HSN_CD = drOrdPrd["HSN_CD"].ToString();
									obj.MRP = gcs_Promo_Global.ToDecimal(drOrdPrd["MRP"].ToString());
									SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTr = obj.CalculateTax(taxList);
									DataRow newPrdTax = dtPrdTaxSum.NewRow();
									newPrdTax["PRD_CD"] = drOrdPrd["PRD_CD"].ToString();
									newPrdTax["MRP"] = drOrdPrd["MRP"].ToString();
									newPrdTax["TAX_SUM"] = obj.TaxSumPerc;
									if (dtAll != dtOrdPrdHq)
									dtPrdTaxSum.Rows.Add(newPrdTax);
									ttl_tax_sum = obj.TaxSumPerc;
								}
								promoDiscAmt = promoDiscAmt / (1 + (ttl_tax_sum / 100));
								prd_disc = prd_disc / (1 + (ttl_tax_sum / 100));
								cust_disc_amt = (prd_rate - prd_disc) * (CustDisc / 100);
							}
						}
					}
					if (mechanicType == "3")//Discount by Percentage
					{
						for (int lvl = 1; lvl <= 4; lvl++)
						{
							uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
							   ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
							if (uomXPrdQty > decimal.Zero)
							{
								prdListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
									? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
								if (schemeTDR == "True")
									prdListPrc = gcs_Promo_Global.ToDecimal(prdListPrc * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100));
								prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
									? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);
								decimal prdListPrc2 = prdListPrc;
	//                            if (discMethod == "True")
	//                                prdListPrc = prdListPrcDisc;
	//                            prdListPrc = cpuPromoPriceGroup(prdListPrc,custChnlDiscPerc);
								//fix 57970 handle cust group disc
								listAccuPrcDisc = prdListPrc - prdListPrcDisc;
								prdListPrc = cpuPromoPriceGroup(prdListPrc,custChnlDiscPerc);
								if (discMethod == "True")
									prdListPrc = prdListPrc - listAccuPrcDisc;

								if (prdListPrc2 == gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_LISTPRC"]))
									prd_disc = gcs_Promo_Global.ToDecimal((prdListPrc * factorValue / 100));
								prd_disc_uom = gcs_Promo_Global.ToDecimal((prdListPrc * factorValue / 100));
								promoDiscAmt = promoDiscAmt + gcs_Promo_Global.ToDecimal((prd_disc_uom * uomXPrdQty).ToString("F" + this.gSetting.amtDecimal));
								unit_disc = prd_disc_uom;
								drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;

								if (this.gFeatures.gIndiaTax)
								{
									//rateAfterDisc = Math.Round(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]), 4);
									rateAfterDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]).ToString("F4"));// + this.gSetting.amtDecimal);
									custDiscAmt = custDiscAmt + gcs_Promo_Global.ToDecimal((obj.CUST_DISC_AMT * (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]))).ToString("F" + this.gSetting.amtDecimal));
									uomPrdDisc[lvl - 1] = unit_disc.ToString();
								}
							}
						}
						if (this.gFeatures.gIndiaTax)
						{
							if (drOrdPrd.Table.Columns.Contains("CUST_DISC_AMT"))
							{
								drOrdPrd["CUST_DISC_AMT"] = gcs_Promo_Global.ToDecimal(custDiscAmt.ToString("F" + this.gSetting.amtDecimal));
							}
						}
					}
				}
				else// Per Total Invoice
				{
					if (mechanicType == "2")//Discount by Value
					{
						if (applyOn == "2") //Per Product
						{
							decimal tax = 0; //TODO:TDR2

							if (schemeQPS == "False")
							{
								decimal prdamt = gethePrdAmount(drOrdPrd, defUomConvFactor); //qty or amt

								if(buyType == "A" && schemeTDR == "True")
								{
									tax = gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"]);
									prdamt = tax * (1 + (tax/100));
								}

								if (prdamt == decimal.Zero)
								{
									prd_disc = 0;
								}
								else
								{
									///forevery
									if (schemeFOREVERY == "True")
										prd_disc = gcs_Promo_Global.ToDecimal((factorValue * promoForEveryRecurCount) / prdamt);
									else
										prd_disc = gcs_Promo_Global.ToDecimal((factorValue) / prdamt);
								}
								///forevery
								if (schemeFOREVERY == "True")
									promoDiscAmt = factorValue * promoForEveryRecurCount;
								else
									promoDiscAmt = factorValue;
							}
							else
							{
								///forevery
								if (schemeFOREVERY == "True")
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsCountDiscPrd * factorValue * promoForEveryRecurCount).ToString("F" + this.gSetting.amtDecimal));
								else
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsCountDiscPrd * factorValue).ToString("F" + this.gSetting.amtDecimal));

								qpsDiffAccuDiscAmt = qpsNewAccuDiscAmt - qpsAccuDiscAmt;
								qpsDiffAccuDiscAmt = getQpsDiffAccuDiscAmt(promo_Cd, factorValue, qpsNewAccuDiscAmt, qpsAccuDiscAmt, qpsDiffAccuDiscAmt);
								promoDiscAmt = (qpsDiffAccuDiscAmt * gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]));
								prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
                                this.UpdateBenefit(promo_Cd, promoDiscAmt ,promoDiscAmt);//64769
							}

							if(this.gFeatures.gIndiaTax && schemeTDR == "True")
							{
								tax = gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"]);
								prdGrossAmtTax = GetProductGrossAmtWithTax(drOrdPrd, tax);
							}
							// per product disc amt will segregate to all UOMs
							for (int lvl = 1; lvl <= 4; lvl++)
							{
								uomXUomConvfactor = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_CONVFACTOR") || drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString() == "")
								? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
								uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
								? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
								if (uomXPrdQty > decimal.Zero)
								{
									prdListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
										? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
									if (schemeTDR == "True")
										prdListPrc = gcs_Promo_Global.ToDecimal(prdListPrc * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100));
									prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
										? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);
									unit_disc = prd_disc / defUomConvFactor;
									drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;

									if (this.gFeatures.gIndiaTax)//TODO:TDR2
									{
										if(schemeTDR == "True")
										{
											decimal prdGrs = prdListPrc * uomXPrdQty;
											decimal part1 = prdGrs / prdGrossAmtTax * factorValue;
											decimal part2 = 0;

											if(buyType == "Q"){
												if(schemeFOREVERY == "True")
													part2 = (decimal)EnhancedMath.RoundDown((double)(ProrataBuyQty/promoForEveryEnt),0);
												else part2 = 1;
											}
											else
											{
												if(schemeFOREVERY == "True")
													part2 = (decimal)EnhancedMath.RoundDown((double)(allProductGrossAmtWithTax/promoForEveryEnt),0);
												else part2 = 1;
											}

											//decimal disc = Math.Round(part1 * part2 / (1 + (tax/100)),4);
											decimal disc = gcs_Promo_Global.ToDecimal(((part1 * part2) / (1 + (tax/100))).ToString("F" + this.gSetting.amtDecimal));
											prd_disc = unit_disc = disc / uomXPrdQty;
											//promoDiscAmt += disc;
											promoDiscAmt = disc;
											drOrdPrd["UOM" + lvl + "_DISC_AMT"] = disc;
										}
										//rateAfterDisc = Math.Round(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]), 4);
										rateAfterDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]).ToString("F4"));// + this.gSetting.amtDecimal);
										custDiscAmt = custDiscAmt + gcs_Promo_Global.ToDecimal((obj.CUST_DISC_AMT * (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]))).ToString("F" + this.gSetting.amtDecimal));
										uomPrdDisc[lvl - 1] = unit_disc.ToString();
									}
								}
							}
							if (this.gFeatures.gIndiaTax)
							{
								if (drOrdPrd.Table.Columns.Contains("CUST_DISC_AMT"))
								{
									drOrdPrd["CUST_DISC_AMT"] = gcs_Promo_Global.ToDecimal(custDiscAmt.ToString("F" + this.gSetting.amtDecimal));
								}
							}
						}
						else if (applyOn == "3") //Per Tier
						{
							grossRatio = decimal.Zero;
							decimal prdUomGrossAmt = decimal.Zero;
							decimal ttlGrossAmt = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]);
							promoDiscAmt = decimal.Zero;

							// get tier total disc amount
							if (schemeProrata == "False")
							{
								///forevery
								if (schemeFOREVERY == "True")
									totalDisc = factorValue * promoForEveryRecurCount;
								else
									totalDisc = factorValue;
							}
							else
							{
								// not multiple with promoForEveryRecurCount coz rounding issue
								if (buyType == "Q")
								{
									///forevery
									if (schemeFOREVERY == "True" && schemeRange == "False")//TODO:TDR
										totalDisc = (ProrataBuyQty / promoForEveryEnt) * factorValue;
									else
										totalDisc = (ProrataBuyQty / qpsEntTtlBuy) * factorValue;//fix Bug 58872
										//totalDisc = (ProrataBuyQty / ProrataBuyQty) * factorValue;
								}
								else if (buyType == "A")
								{
									//TODO:TDR
									decimal amt = 0;

									if (schemeTDR == "True")
										amt = allProductGrossAmtWithTax;
									else amt = ProrataBuyAmt;

									///forevery
									if (schemeFOREVERY == "True" && schemeRange == "False")//TODO:TDR
										totalDisc = (amt / promoForEveryEnt) * factorValue;
									else
										totalDisc = (amt / qpsEntTtlBuy) * factorValue;//fix Bug 58872
										//totalDisc = (amt / amt) * factorValue;
								}
							}

							// accumulate each uom disc amt for this sku
							for (int lvl = 1; lvl <= 4; lvl++)
							{
								uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
													? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
								if (uomXPrdQty > decimal.Zero)
								{
									prdUomGrossAmt = (drOrdPrd.IsNull("UOM" + lvl + "_GROSS_AMT") || drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString() == "")
										? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);
									if (schemeTDR == "True")
										prdUomGrossAmt = gcs_Promo_Global.ToDecimal(prdUomGrossAmt * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100));
									if (ttlGrossAmt > 0)
									{
	//                                    if (schemeTDR == "True")
	//                                        grossRatio = prdUomGrossAmt / allProductGrossAmtWithTax;
	//                                    else
											grossRatio = prdUomGrossAmt / ttlGrossAmt;
									}
									else grossRatio = 0;
									promoDiscAmt += gcs_Promo_Global.ToDecimal((totalDisc * grossRatio).ToString("F" + this.gSetting.amtDecimal));
                                    drOrdPrd["UOM" + lvl + "_DISC_AMT"] = gcs_Promo_Global.ToDecimal((totalDisc * grossRatio).ToString("F" + this.gSetting.amtDecimal)) / (1 + (prdTax/100));
                                    
									if(schemeTDR == "True" && schemeQPS == "True") //TODO:TDR7
									{
										decimal benefit= 0;
										if(schemeProrata == "True")
											benefit = ProrataBuyQty / promoForEveryEnt * factorValue;
										else benefit = (decimal)EnhancedMath.RoundDown((double)(ProrataBuyQty / promoForEveryEnt), 0) * ttlBuy_Qty * factorValue;

										decimal grossAmtTax = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]) * (1 + (prdTax/100));
										decimal benefitGiven = benefit - qpsAccuDiscAmt;
										decimal part1 = grossAmtTax * benefitGiven / allProductGrossAmtWithTax;
										decimal part2 = part1 / (1 + (prdTax / 100));
										decimal qty = gethePrdAmount(drOrdPrd, defUomConvFactor);

										promoDiscAmt = qpsNewAccuDiscAmt = part2;
										prd_disc = part2 / qty;
										this.UpdateBenefit(promo_Cd, benefit , part2);

										drOrdPrd["UOM" + lvl + "_DISC_AMT"] = part2;
									}
								}
							}
							prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));

							if (schemeQPS == "True" && schemeTDR == "False")
							{
								if (this.gFeatures.gIndiaTax)
									qpsNewAccuDiscAmt = totalDisc;
								else
									qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal(totalDisc.ToString("F" + this.gSetting.amtDecimal));
								qpsDiffAccuDiscAmt = qpsNewAccuDiscAmt - qpsAccuDiscAmt;
								qpsDiffAccuDiscAmt = getQpsDiffAccuDiscAmt(promo_Cd, factorValue, qpsNewAccuDiscAmt, qpsAccuDiscAmt, qpsDiffAccuDiscAmt);

								// update final given total disc amt
								totalDisc = qpsDiffAccuDiscAmt;

                                if(gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"])>0)
								    promoDiscAmt = (qpsDiffAccuDiscAmt * gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]));
								prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
                                this.UpdateBenefit(promo_Cd, promoDiscAmt, promoDiscAmt);//64769
                            }
							if (schemeCOMBI == "True")
							{
								grossRatio = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]);
								///forevery
								if (schemeFOREVERY == "True")
									totalDisc = factorValue * promoForEveryRecurCount;
								else
									totalDisc = factorValue;

								promoDiscAmt = totalDisc * grossRatio;
								prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
							}
							//unit_disc = prd_disc / defUomConvFactor; //fix 52955

							if (this.gFeatures.gIndiaTax && schemeTDR == "True")
							{
								//promoDiscAmt = 0;
								decimal ttl_tax_sum = decimal.Zero;
								DataRow[] drsTaxSum = this.dtPrdTaxSum.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "' AND (MRP='" + drOrdPrd["MRP"].ToString() + "' OR MRP='" + roundedMRP + "')");
								//DataRow[] drsTaxSum = this.dtPrdTaxSum.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "' AND MRP='" + drOrdPrd["MRP"].ToString() + "'");
								if (drsTaxSum.Length > 0)
								{
									ttl_tax_sum = gcs_Promo_Global.ToDecimal(drsTaxSum[0]["TAX_SUM"].ToString());
								}
								else
								{
									obj.PRD_CD = drOrdPrd["PRD_CD"].ToString();
									obj.HSN_CD = drOrdPrd["HSN_CD"].ToString();
									obj.MRP = gcs_Promo_Global.ToDecimal(drOrdPrd["MRP"].ToString());
									SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTr = obj.CalculateTax(this.taxList);
									DataRow newPrdTax = this.dtPrdTaxSum.NewRow();
									newPrdTax["PRD_CD"] = drOrdPrd["PRD_CD"].ToString();
									newPrdTax["MRP"] = drOrdPrd["MRP"].ToString();
									newPrdTax["TAX_SUM"] = obj.TaxSumPerc;
									if (dtAll != dtOrdPrdHq)
									this.dtPrdTaxSum.Rows.Add(newPrdTax);
									ttl_tax_sum = obj.TaxSumPerc;
								}
								promoDiscAmt = promoDiscAmt / (1 + (ttl_tax_sum / 100));
								prd_disc = prd_disc / (1 + (ttl_tax_sum / 100));
								unit_disc = prd_disc;
							}
							else if (!this.gFeatures.gIndiaTax)
							{
								// per product disc amt will segregate to all UOMs
								for (int lvl2 = 1; lvl2 <= 4; lvl2++)
								{
    								uomXUomConvfactor = (drOrdPrd.IsNull("UOM" + lvl2 + "_UOM_CONVFACTOR") || drOrdPrd["UOM" + lvl2 + "_UOM_CONVFACTOR"].ToString() == "")
    								? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl2 + "_UOM_CONVFACTOR"]);//80185
									uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl2 + "_PRD_QTY") || drOrdPrd["UOM" + lvl2 + "_PRD_QTY"].ToString() == "")
									? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl2 + "_PRD_QTY"]);

									if (uomXPrdQty > decimal.Zero)
									{
										prdListPrc = (drOrdPrd.IsNull("UOM" + lvl2 + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl2 + "_UOM_LISTPRC"].ToString() == "")
											? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl2 + "_UOM_LISTPRC"]);
										prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl2 + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl2 + "_UOM_LISTPRCDISC"].ToString() == "")
											? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl2 + "_UOM_LISTPRCDISC"]);
										unit_disc = prd_disc * uomXUomConvfactor / defUomConvFactor;//80185
										drOrdPrd["UOM" + lvl2 + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;
									}
								}
							}
						}
						else if (!this.gFeatures.gIndiaTax && applyOn == "4") //Per Invoice
						{
							grossRatio = decimal.Zero;
							decimal prdUomGrossAmt = decimal.Zero;
							decimal uomDisc = decimal.Zero;
							decimal ttlGrossAmt = gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]);
							promoDiscAmt = decimal.Zero;
							InvPromoDiscAmt = decimal.Zero;

							// get tier total disc amount
							if (schemeProrata == "False")
							{
								//forevery
								if (schemeFOREVERY == "True")
									totalDisc = factorValue * promoForEveryRecurCount;
								else
									totalDisc = factorValue;
							}
							else
							{
								// not multiple with promoForEveryRecurCount coz rounding issue
								//forevery
								if (schemeFOREVERY == "True")
									totalDisc = (ttlGrossAmt / promoForEveryEnt) * factorValue;
								else
									totalDisc = (ttlGrossAmt / ttlGrossAmt) * factorValue;
							}
							// accumulate each uom disc amt for this sku
							for (int lvl = 1; lvl <= 4; lvl++)
							{
								uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
													? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
								if (uomXPrdQty > decimal.Zero)
								{
									prdUomGrossAmt = (drOrdPrd.IsNull("UOM" + lvl + "_GROSS_AMT") || drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString() == "")
										? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);
									grossRatio = prdUomGrossAmt / ttlGrossAmt;
									InvPromoDiscAmt = InvPromoDiscAmt + gcs_Promo_Global.ToDecimal((totalDisc * grossRatio).ToString("F" + this.gSetting.amtDecimal));
									uomDisc = gcs_Promo_Global.ToDecimal((totalDisc * grossRatio).ToString("F" + this.gSetting.amtDecimal));
									unit_disc = uomDisc / uomXPrdQty;
									prdListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
										? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
									prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
										? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);
									drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;

									DataRow newDtInvlvlPromo1 = dtInvLvlPromoPerUOM.NewRow();
									newDtInvlvlPromo1["PROMO_CD"] = drOrdPromoDiscApplied["PROMO_CD"];
									newDtInvlvlPromo1["PRD_CD"] = drOrdPrd["PRD_CD"];
									newDtInvlvlPromo1["UOM_CD"] = drOrdPrd["UOM" + lvl + "_UOM_CD"];//UOM3_UOM_CD
									newDtInvlvlPromo1["UOM_INVDISC"] = uomDisc;
									if (dtAll != dtOrdPrdHq)
									dtInvLvlPromoPerUOM.Rows.Add(newDtInvlvlPromo1);
								}
							}
							//Fix 50125
							promoDiscAmt = InvPromoDiscAmt;
							prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
						}
					}

					if (mechanicType == "3")//Discount by Percentage
					{
						if (promoType == "P")//Dynamic Scheme
						{
							for (int lvl = 1; lvl <= 4; lvl++)
							{
								uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
										? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
								if (uomXPrdQty > decimal.Zero)
								{
									prdListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
										  ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
									if (schemeTDR == "True")
										prdListPrc = gcs_Promo_Global.ToDecimal(prdListPrc * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100));
									prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
										  ? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);
									decimal prdListPrc2 = prdListPrc;
	//                                if (discMethod == "True")
	//                                    prdListPrc = prdListPrcDisc;
	//                                prdListPrc = cpuPromoPriceGroup(prdListPrc,custChnlDiscPerc);
									//fix 57970 handle cust group disc
									listAccuPrcDisc = prdListPrc - prdListPrcDisc;
									prdListPrc = cpuPromoPriceGroup(prdListPrc,custChnlDiscPerc);
									if (discMethod == "True")
										prdListPrc = prdListPrc - listAccuPrcDisc;

									if (prdListPrc2 == gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_LISTPRC"]))
										prd_disc = gcs_Promo_Global.ToDecimal((prdListPrc * factorValue / 100));
									prd_disc_uom = gcs_Promo_Global.ToDecimal((prdListPrc * factorValue / 100));
									promoDiscAmt = promoDiscAmt + gcs_Promo_Global.ToDecimal((prd_disc_uom * uomXPrdQty).ToString("F" + this.gSetting.amtDecimal));
									unit_disc = prd_disc_uom;
									drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;

									if (this.gFeatures.gIndiaTax)
									{
										prd_disc = prd_disc_uom
										   * gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"].ToString())
											/ gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString());

										//rateAfterDisc = Math.Round(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]), 4);
										rateAfterDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]).ToString("F4"));// + this.gSetting.amtDecimal);
										custDiscAmt = custDiscAmt + gcs_Promo_Global.ToDecimal((obj.CUST_DISC_AMT * (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]))).ToString("F" + this.gSetting.amtDecimal));
										uomPrdDisc[lvl - 1] = unit_disc.ToString();
									}
								}
							}
							if (this.gFeatures.gIndiaTax)
							{
								if (drOrdPrd.Table.Columns.Contains("CUST_DISC_AMT"))
								{
									drOrdPrd["CUST_DISC_AMT"] = gcs_Promo_Global.ToDecimal(custDiscAmt.ToString("F" + this.gSetting.amtDecimal));
								}
							}
						}
						else
						{
							if (schemeQPS == "False")
							{
								if (applyOn != "4")
								{
									if (schemeProrata == "False") //Pro-rata No
									{
										if (buyType == "Q") // Buy Type = Quantity
										{
											prd_disc = factorValue;
											//promoDiscAmt = getPrdProRataDiscQ(Eng, drOrdPrd, buyUOM_CD, qpsEntTtlBuy, ProrataBuyQty, factorValue, prd_Cd, mechanicType); //69847
											promoDiscAmt = getPrdProRataDiscQ(Eng, drOrdPrd, buyUOM_CD, qpsEntTtlBuy, ProrataBuyQty, factorValue, prd_Cd, mechanicType, applyOn, schemeFOREVERY, promoForEveryEnt); //69847//10061
											decimal q = gethePrdAmount(drOrdPrd, defUomConvFactor); //TODO:TDR
											prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / q);
										}
										else if (buyType == "A")
										{
											prd_disc = factorValue;
											promoDiscAmt = getPrdProRataDiscA(Eng, drOrdPrd, buyUOM_CD, qpsEntTtlBuy, ProrataBuyAmt, factorValue, prd_Cd, mechanicType, schemeTDR, schemeFOREVERY, promoForEveryEnt);//80182
											prd_disc = gcs_Promo_Global.ToDecimal(promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor));
										}

										promoDiscAmt = decimal.Zero;//fix 20385

										for (int lvl = 1; lvl <= 4; lvl++)
										{
											uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
											? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
											if (uomXPrdQty > decimal.Zero)
											{
												prdListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
													? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
												decimal tax = 0;
												prdListPrcDisc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
													? prdListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);

												if (schemeTDR == "True")//TODO:TDR2
												{
													tax = gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"]);
													prdGrossTotalTax = (uomXPrdQty * prdListPrc) * (1 + (tax / 100));

													if (schemeProrata == "False")
													{
														if (buyType == "Q")
														{
															prdDiscTDR = prdGrossTotalTax / ProrataBuyQty * (factorValue / 100);
														}
														else
														{
															prdDiscTDR = prdGrossTotalTax / allProductGrossAmtWithTax * (factorValue / 100);
														}
														decimal r = 0;
														if(schemeFOREVERY == "True")
														{
															if (buyType == "Q")
																r = (decimal)EnhancedMath.RoundDown((double)(ProrataBuyQty / promoForEveryEnt), 0) * ttlBuy_Qty;
															else
																r = (decimal)EnhancedMath.RoundDown((double)(allProductGrossAmtWithTax / promoForEveryEnt), 0) * ttlBuy_Qty;
														}
														else
														{
															r = ttlBuy_Qty;
														}
														prd_disc_uom = prdDiscTDR * r / (1 + (tax / 100));
														//promoDiscAmt += Math.Round(prd_disc_uom, 4);
														promoDiscAmt += gcs_Promo_Global.ToDecimal((prd_disc_uom).ToString("F" + this.gSetting.amtDecimal));
													}
													//else
													//
													//	prd_disc_uom = prdGrossTotalTax * (factorValue / 100);
													//	//promoDiscAmt += Math.Round(prd_disc_uom, 4);
													//	promoDiscAmt += gcs_Promo_Global.ToDecimal((prd_disc_uom).ToString("F" + this.gSetting.amtDecimal));
													//
													prdListPrc = gcs_Promo_Global.ToDecimal(prdListPrc * (1 + tax) / 100);
													unit_disc = prd_disc_uom / uomXPrdQty;
												}
												if (schemeTDR == "False")
												{
													decimal prdListPrc2 = prdListPrc;
	//                                                if (discMethod == "True")
	//                                                    prdListPrc = prdListPrcDisc;
	//
	//                                                prdListPrc = cpuPromoPriceGroup(prdListPrc,custChnlDiscPerc);
													if (prdListPrc2 == gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_LISTPRC"]))
														prd_disc = gcs_Promo_Global.ToDecimal((prdListPrc * factorValue / 100));

													//fix 57970 handle cust group disc
													listAccuPrcDisc = prdListPrc - prdListPrcDisc;
													prdListPrc = cpuPromoPriceGroup(prdListPrc,custChnlDiscPerc);
													if (discMethod == "True")
														prdListPrc = prdListPrc - listAccuPrcDisc;

													prd_disc_uom = gcs_Promo_Global.ToDecimal((prdListPrc * factorValue / 100));
													unit_disc = prd_disc_uom;
												}

												drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = prdListPrcDisc - unit_disc;

												if (this.gFeatures.gIndiaTax)
												{
													if (schemeTDR == "False")//TODO:TDR
														prd_disc = prd_disc_uom
															* gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"].ToString())
															/ gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString());
													//rateAfterDisc = Math.Round(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]), 4);
													rateAfterDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM1_UOM_LISTPRCDISC"]).ToString("F4"));// + this.gSetting.amtDecimal);
													custDiscAmt = custDiscAmt + gcs_Promo_Global.ToDecimal((obj.CUST_DISC_AMT * (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]))).ToString("F" + this.gSetting.amtDecimal));
													uomPrdDisc[lvl - 1] = unit_disc.ToString();
												}

												//fix 34838
												decimal GrossAmt = decimal.Zero;
												decimal DiscQUOM = decimal.Zero;
												decimal DefaultUOMConv = decimal.Zero;
												decimal DiscAmt = decimal.Zero;
												decimal TotalDiscAmt = decimal.Zero;
												decimal GrossAmtRatio = decimal.Zero;
												decimal DiscQtyInBuyUOM = decimal.Zero;
												decimal DiscQtyInDEFUOM = decimal.Zero;
												decimal DCONV = gcs_Promo_Global.ToDecimal(1);
												decimal DefaultUOMLVL = decimal.Zero;
												decimal UnitDiscBuyTypeUOM = decimal.Zero;
												string DefaultUOM = "";
												int BuyTypeLvl = 0;
												string BuyUOM = "";
												if (buyType == "Q")
												{
													foreach (DataRow drDisclevel in this.dtSDiscList.Select("UOM_CD = '" + buyUOM_CD + "'" + " AND PRD_CD = '" + prd_Cd + "'"))
													{
														BuyTypeLvl = gcs_Promo_Global.ToInt(drDisclevel["UOM_LEVEL"].ToString());
													}

													foreach (DataRow drDiscDefault in this.dtSDiscList.Select("DEFAULT_UOM = 'True'" + " AND PRD_CD = '" + prd_Cd + "'"))
													{
														//DefaultUOMConv = gcs_Global.ToDecimal(drDiscDefault["CONV_FACTOR"]);
														DefaultUOM = drDiscDefault["UOM_CD"].ToString();
														DefaultUOMLVL = gcs_Promo_Global.ToDecimal(drDiscDefault["UOM_LEVEL"]);
													}

													decimal DiscQD = decimal.Zero;
													BuyUOM = drOrdPrd["UOM" + lvl + "_UOM_CD"].ToString();
													//DefaultUOMConv = gcs_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
													DefaultUOMConv = gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);

//													if (BuyTypeLvl > lvl || BuyTypeLvl < lvl)//64872
//													{
														decimal LvlConvSML = decimal.Zero;
														decimal BuyTypeConvSML = decimal.Zero;

														foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "'" + " AND PRD_CD = '" + prd_Cd + "'"))
														{
															LvlConvSML = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
														}

//														foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + BuyTypeLvl + "'" + " AND PRD_CD = '" + prd_Cd + "'"))//64872
//														{
//															BuyTypeConvSML = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
//														}

														DiscQUOM = ((uomXPrdQty * LvlConvSML) / gcs_Promo_Global.ToDecimal(ProrataBuyQty)) * qpsEntTtlBuy;//64872
														//DiscQUOM = (((uomXPrdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(ProrataBuyQty)) * qpsEntTtlBuy;//64872

//													}//64872
//													else
//													{
//														DiscQUOM = (gcs_Promo_Global.ToDecimal(uomXPrdQty) / gcs_Promo_Global.ToDecimal(ProrataBuyQty)) * qpsEntTtlBuy;
//													}

													if (lvl > BuyTypeLvl)
													{
														for (int j = lvl; j > BuyTypeLvl; j--)
														{
															//DCONV = DCONV * gcs_Global.ToDecimal(drOrdPrd["UOM" + j + "_UOM_CONVFACTOR"]);
															if(j<=DefaultUOMLVL)//fix 34379
																DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + prd_Cd + "'")[0]["CONV_FACTOR"]);
														}
													}
													else if (lvl < BuyTypeLvl)
													{
														for (int k = lvl; k <= BuyTypeLvl; k++)
														{
															//DCONV = DCONV * gcs_Global.ToDecimal(drOrdPrd["UOM" + k + "_UOM_CONVFACTOR"]);
															DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + prd_Cd + "'")[0]["CONV_FACTOR"]);
														}
													}
													else
													{
														DCONV = gcs_Promo_Global.ToDecimal(1);
													}

//													if (lvl > BuyTypeLvl || lvl < BuyTypeLvl)//64872
//													{
                                                    foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "'" + " AND PRD_CD = '" + prd_Cd + "'"))//64872
                                                    {
                                                        DCONV = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                                                        UnitDiscBuyTypeUOM = (prdListPrc * gcs_Promo_Global.ToDecimal(factorValue)) / gcs_Promo_Global.ToDecimal(100);
														UnitDiscBuyTypeUOM = UnitDiscBuyTypeUOM / DCONV;
													}
//													else//64872
//													{
//														UnitDiscBuyTypeUOM = (prdListPrc * gcs_Promo_Global.ToDecimal(factorValue)) / gcs_Promo_Global.ToDecimal(100);
//													}

													//TODO:TDR
													if (schemeTDR == "False")
													{
														DiscAmt = gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM) * gcs_Promo_Global.ToDecimal(DiscQUOM);
														//promoDiscAmt = gcs_Promo_Global.ToDecimal(promoDiscAmt) + (gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM) * gcs_Promo_Global.ToDecimal(DiscQUOM));
														promoDiscAmt = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(promoDiscAmt) + gcs_Promo_Global.ToDecimal(DiscAmt)).ToString("F" + this.gSetting.amtDecimal));
													}
												}
												else if (buyType == "A")
												{
													UnitDiscBuyTypeUOM = (prdListPrc * gcs_Promo_Global.ToDecimal(factorValue)) / gcs_Promo_Global.ToDecimal(100);//fix 20385
													GrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);
													GrossAmtRatio = (gcs_Promo_Global.ToDecimal(qpsEntTtlBuy) * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(ProrataBuyAmt);
													//fix 57970 change prdListPrc to prdListPrcDisc
													//DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / prdListPrcDisc;//prdListPrc;
													//75032 fix incorrect prd discount greater than expected
													if (discMethod == "True")
													    DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / prdListPrcDisc;
													else
													    DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / prdListPrc;
													if (schemeTDR == "False")//64705 tdr promo and prd disc not tally
													    promoDiscAmt = gcs_Promo_Global.ToDecimal(promoDiscAmt) + gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM);
												}

												//end fix 34838
												//fix 57970 calculate prd_disc_uom for prorata no
												prd_disc_uom = gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM) / uomXPrdQty;
