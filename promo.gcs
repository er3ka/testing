                rowPrdExists["UOM1_PRD_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["UOM1_PRD_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["UOM1_PRD_QTY"].ToString());


                rowPrdExists["ORG_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["ORG_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["ORG_QTY"].ToString());
                rowPrdExists["PRD_QTY_SML"] = gcs_Promo_Global.ToInt(rowPrdExists["PRD_QTY_SML"].ToString()) + gcs_Promo_Global.ToInt(row["PRD_QTY_SML"].ToString());

                rowPrdExists["PRD_QTY"] = "";
