                rowPrdExists["UOM4_PRD_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["UOM4_PRD_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["UOM4_PRD_QTY"].ToString());

                rowPrdExists["UOM3_ORG_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["UOM3_ORG_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["UOM3_ORG_QTY"].ToString());
                rowPrdExists["UOM3_PRD_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["UOM3_PRD_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["UOM3_PRD_QTY"].ToString());

                rowPrdExists["UOM2_ORG_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["UOM2_ORG_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["UOM2_ORG_QTY"].ToString());
                rowPrdExists["UOM2_PRD_QTY"] = gcs_Promo_Global.ToInt(rowPrdExists["UOM2_PRD_QTY"].ToString()) + gcs_Promo_Global.ToInt(row["UOM2_PRD_QTY"].ToString());

