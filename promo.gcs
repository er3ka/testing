												uomDisc = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM)).ToString("F" + this.gSetting.amtDecimal));//75585
                                                InvPromoDiscAmt = gcs_Promo_Global.ToDecimal(InvPromoDiscAmt) + uomDisc;

