											qpsDiffAccuDiscAmt = qpsAccuDiscAmt;

										promoDiscAmt = (qpsDiffAccuDiscAmt * gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]));
										prd_disc = promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor);
                                        this.UpdateBenefit(promo_Cd, promoDiscAmt, promoDiscAmt);//64769
                                    }
								}
								else if (buyType == "A")
								{
									if(schemeTDR == "True") //TODO:TDR7
									{
										decimal benefit= 0;
										if(schemeProrata == "True")
											benefit = prdGrossAmtTax * (factorValue / 100);
										else benefit = (decimal)EnhancedMath.RoundDown((double)(allProductGrossAmtWithTax / promoForEveryEnt), 0) * promoForEveryEnt * (factorValue / 100);

										// fix 45833
										decimal benefitGiven = decimal.Zero;
										if ((this.txnMode == Enum.TxnMode.INVOCE_NEW || this.txnMode == Enum.TxnMode.INVOICE_EDIT ||
											this.txnMode == Enum.TxnMode.ORDER_NEW || this.txnMode == Enum.TxnMode.ORDER_EDIT) || qpsAccuDiscAmt != decimal.Zero)
											benefitGiven = benefit - qpsAccuDiscAmt;
										else
											benefitGiven = qpsAccuDiscAmt;
										decimal part1 = prdGrossAmtTax * benefitGiven / allProductGrossAmtWithTax;
										decimal part2 = part1 / (1 + (prdTax / 100));
										decimal qty = gethePrdAmount(drOrdPrd, defUomConvFactor);

										promoDiscAmt = qpsNewAccuDiscAmt = part2;
										prd_disc = part2 / qty;
										this.UpdateBenefit(promo_Cd, benefit ,part2);
									}
									else
									{
										if (schemeProrata == "False")
											qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsEntTtlBuy * factorValue / 100).ToString("F" + this.gSetting.amtDecimal));
										else if (schemeProrata == "True")    // chin tong qps prorata = yes
											qpsNewAccuDiscAmt = gcs_Promo_Global.ToDecimal((qpsNewAccuTtlBuyAmt * factorValue / 100).ToString("F" + this.gSetting.amtDecimal));

										qpsDiffAccuDiscAmt = qpsNewAccuDiscAmt - qpsAccuDiscAmt;
										// fix 45833
										if ((this.txnMode == Enum.TxnMode.INVOCE_NEW || this.txnMode == Enum.TxnMode.INVOICE_EDIT ||
											this.txnMode == Enum.TxnMode.ORDER_NEW || this.txnMode == Enum.TxnMode.ORDER_EDIT) || qpsAccuDiscAmt != decimal.Zero)
											qpsDiffAccuDiscAmt = getQpsDiffAccuDiscAmt(promo_Cd, factorValue, qpsNewAccuDiscAmt, qpsAccuDiscAmt, qpsDiffAccuDiscAmt);
										else
											qpsDiffAccuDiscAmt = qpsAccuDiscAmt;
										promoDiscAmt = (qpsDiffAccuDiscAmt * gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["PRD_GROSS_AMT"]) / gcs_Promo_Global.ToDecimal(drOrdPromoDiscApplied["TTL_GROSS_AMT"]));
										prd_disc = promoDiscAmt / gethePrdAmount(drOrdPrd, defUomConvFactor);
                                        this.UpdateBenefit(promo_Cd, promoDiscAmt ,promoDiscAmt);//64769
									}
								}
								//TODO:TDR7 - Remove
							}
						}
					}
				}

				//TODO:TDR7 - removed

				DataRow newOrdPromo = dtPromo.NewRow();
				newOrdPromo["PRD_CD"] = drOrdPrd["PRD_CD"];
				newOrdPromo["PRD_INDEX"] = drOrdPrd["PRD_INDEX"];
				newOrdPromo["PRD_SLSTYPE"] = "S";
				newOrdPromo["PROMO_CD"] = drOrdPromoDiscApplied["PROMO_CD"].ToString();
				newOrdPromo["PROMO_INDEX"] = drOrdPromoDiscApplied["PROMO_INDEX"];
				newOrdPromo["PROMO_SEQ"] = drOrdPromoDiscApplied["PROMO_SEQ"].ToString();
				newOrdPromo["MECHANIC_TYPE"] = mechanicType;
				/*
					ISSUE 39242
					 newOrdPromo["DISC_PERC"]        = (mechanicType == "2" || schemeQPS == "True") ?  "0.0000" : factorValue.ToString("F" + this.gSetting.amtDecimal);
				*/
				//newOrdPromo["DISC_PERC"] = (mechanicType == "2" || schemeQPS == "True") ? "0.0000" : factorValue.ToString();
				newOrdPromo["DISC_PERC"] = (mechanicType == "2") ? "0.0000" : factorValue.ToString();//66961
				newOrdPromo["DISC_AMT"] = promoDiscAmt.ToString("F" + this.gSetting.amtDecimal);
				newOrdPromo["PRD_DISC"] = prd_disc;

				totalDiscAmt+=promoDiscAmt;//fix 57970

				if (!this.gFeatures.gIndiaTax)
				{
					newOrdPromo["INV_DISC_AMT"] = InvPromoDiscAmt.ToString("F" + this.gSetting.amtDecimal);
				}
				else
				{
					newOrdPromo["UOM1_PRD_DISC"] = uomPrdDisc[0];
					newOrdPromo["UOM2_PRD_DISC"] = uomPrdDisc[1];
					newOrdPromo["UOM3_PRD_DISC"] = uomPrdDisc[2];
					newOrdPromo["UOM4_PRD_DISC"] = uomPrdDisc[3];
				}
				newOrdPromo["DISC_SPENT_AMT"] = newOrdPromo["DISC_AMT"];
				newOrdPromo["ORDPRD_INDEX"] = drOrdPrd["PRD_INDEX"];
				newOrdPromo["ORDPRD_INDEX_TMP"] = drOrdPrd["PRD_INDEX"];
				newOrdPromo["TTL_DISC_AMT"] = totalDisc; // need for per tier
				newOrdPromo["AVG_SLS"] = avg_Sls;
				newOrdPromo["MSL_IND"] = msl_Ind;
				dtPromo.Rows.Add(newOrdPromo);

				DataRow newPromoDtl = dtPromoDetail.NewRow();
				newPromoDtl["PROMO_CD"] = drOrdPromoDiscApplied["PROMO_CD"];
				newPromoDtl["PRD_CD"] = drOrdPrd["PRD_CD"];
				newPromoDtl["PRD_INDEX"] = drOrdPrd["PRD_INDEX"];
				newPromoDtl["PROMO_INDEX"] = drOrdPromoDiscApplied["PROMO_INDEX"];
				if (dtAll != dtOrdPrdHq)
				dtPromoDetail.Rows.Add(newPromoDtl);
			}
		}

		//TODO:TDR7 - sum the acumulated disc with previous
		SumBenefitWithPreviousBenefit();

		this.calcOrdPrdPromoDisc(Eng, dtAll);

        this.calc_hq = false;//pricing
    }
}


private decimal gethePrdAmount(DataRow drOrdPrd, decimal defUomConvFactor)
{
    decimal prdQty = decimal.Zero;
    for (int lvl = 1; lvl <= 4; lvl++)
    {
        if (!drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") &&
            drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() != "" &&
            gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) > decimal.Zero)
        {
            prdQty += gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
        }
    }
    if (defUomConvFactor > decimal.Zero)
        return prdQty / defUomConvFactor;
    else
        return decimal.Zero;
}


private decimal getPrdProRataDiscA(OfficeEngine eng, DataRow drOrdPrd, string BuyTypeUOM, decimal TotalBuy_Amt, decimal TBuy_Amt, decimal factorvalue, string Prd_cd, string DicsType, string schemeTDR, string schemeFOREVERY, decimal promoForEveryEnt)//80182
{
    return getPrdProRataDiscA(eng, drOrdPrd, BuyTypeUOM, TotalBuy_Amt, TBuy_Amt, factorvalue, Prd_cd, DicsType, schemeTDR, schemeFOREVERY, promoForEveryEnt, "False", 0);
}

private decimal getPrdProRataDiscA(OfficeEngine eng, DataRow drOrdPrd, string BuyTypeUOM, decimal TotalBuy_Amt, decimal TBuy_Amt, decimal factorvalue, string Prd_cd, string DicsType, string schemeTDR, string schemeFOREVERY, decimal promoForEveryEnt, string promo_progress, decimal TotalBuy_Qty)//80182
{
    decimal GrossAmt = decimal.Zero;
    decimal DiscQUOM = decimal.Zero;
    decimal DefaultUOMConv = decimal.Zero;
    decimal DiscAmt = decimal.Zero;
    decimal TotalDiscAmt = decimal.Zero;
    decimal GrossAmtRatio = decimal.Zero;
    decimal DiscQtyInBuyUOM = decimal.Zero;
    decimal DiscQtyInDEFUOM = decimal.Zero;
    decimal DCONV = gcs_Promo_Global.ToDecimal(1);
    decimal DefaultUOMLVL = decimal.Zero;
    decimal UnitDiscBuyTypeUOM = decimal.Zero;

    DataRow[] tbl = this.dtOrdPrdUOMInfo.Select("PRD_CD='" + Prd_cd + "'");

    this.dtSDiscList.Clear();

    foreach (DataRow srcDr in tbl)
    {
        DataRow destDr = this.dtSDiscList.NewRow();
        destDr["PRD_CD"] = srcDr["PRD_CD"];
        destDr["UOM_CD"] = srcDr["UOM_CD"];
        destDr["BASEUOM_CD"] = srcDr["BASEUOM_CD"];
        destDr["UOM_LEVEL"] = srcDr["UOM_LEVEL"];
        destDr["CONV_FACTOR"] = srcDr["CONV_FACTOR"];
        destDr["CONV_FACTOR_SML"] = srcDr["CONV_FACTOR_SML"];
        destDr["SML_UOM"] = srcDr["SML_UOM"];
        destDr["SALE_UOM"] = srcDr["SALE_UOM"];
        destDr["DEFAULT_UOM"] = srcDr["DEFAULT_UOM"];
        this.dtSDiscList.Rows.Add(destDr);
    }

    foreach (DataRow drDiscDefault in this.dtSDiscList.Select("DEFAULT_UOM = 'True'" + " AND PRD_CD = '" + Prd_cd + "'"))
    {
        DefaultUOMLVL = gcs_Promo_Global.ToDecimal(drDiscDefault["UOM_LEVEL"]);
    }

    for (int lvl = 1; lvl <= 4; lvl++)
    {
        decimal DiscQD = decimal.Zero;
        if (!drOrdPrd.IsNull("UOM" + lvl + "_GROSS_AMT") && drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString() != "" && gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]) > decimal.Zero)
        {
            UnitDiscBuyTypeUOM = decimal.Zero;

            if (DicsType == "2")
            {
                DCONV = gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR_SML"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"].ToString());
            }
            else if (DicsType == "3")
            {
                UnitDiscBuyTypeUOM = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]) * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);
            }

            GrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);

            if (schemeTDR == "True")
            {
                GrossAmt = gcs_Promo_Global.ToDecimal((GrossAmt * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100)).ToString("F" + this.gSetting.amtDecimal));
                TBuy_Amt = gcs_Promo_Global.ToDecimal((TBuy_Amt * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100)).ToString("F" + this.gSetting.amtDecimal));
            }

            if (schemeFOREVERY == "True")//80182
            {
			    decimal for_every = (decimal)EnhancedMath.RoundDown((double)(TBuy_Amt / promoForEveryEnt),0) * promoForEveryEnt;
                GrossAmtRatio = (for_every * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(TBuy_Amt);
            }
            else
                GrossAmtRatio = (gcs_Promo_Global.ToDecimal(TotalBuy_Amt) * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(TBuy_Amt);

            if (schemeTDR == "True")
                DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / (gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]) * (1 + gcs_Promo_Global.ToDecimal(drOrdPrd["TAX_SUM_PERC"].ToString()) / 100)));
            else
                DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);

            if (promo_progress == "True")
                DiscQtyInBuyUOM = DiscQtyInBuyUOM / TotalBuy_Qty * TotalBuy_Amt;

            if (DicsType == "2")
            {
                /*if (lvl < DefaultUOMLVL)
                {
                    DiscQtyInDEFUOM = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) / gcs_Promo_Global.ToDecimal(DCONV));
                }
                else if (lvl >= DefaultUOMLVL)
                {
                    DiscQtyInDEFUOM = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(DCONV));
                }*/
                DiscQtyInDEFUOM  = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(DCONV));
                TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(DiscQtyInDEFUOM) * gcs_Promo_Global.ToDecimal(factorvalue)).ToString("F" + this.gSetting.amtDecimal));
            }
            else if (DicsType == "3")
            {
                TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM)).ToString("F" + this.gSetting.amtDecimal));
            }
        }
    }
    return TotalDiscAmt;
}


private decimal getPrdProRataDiscQ(OfficeEngine eng, DataRow drOrdPrd, string BuyTypeUOM, decimal TotalBuy_Qty, decimal TBuy_Qty, decimal factorvalue, string Prd_cd, string DicsType, string applyOn, string schemeFOREVERY, decimal promoForEveryEnt)
{
    DataRow[] tbl = this.dtOrdPrdUOMInfo.Select("PRD_CD='" + Prd_cd + "'");

    this.dtSDiscList.Clear();
    foreach (DataRow srcDr in tbl)
    {
        DataRow destDr = this.dtSDiscList.NewRow();
        destDr["PRD_CD"] = srcDr["PRD_CD"];
        destDr["UOM_CD"] = srcDr["UOM_CD"];
        destDr["BASEUOM_CD"] = srcDr["BASEUOM_CD"];
        destDr["UOM_LEVEL"] = srcDr["UOM_LEVEL"];
        destDr["CONV_FACTOR"] = srcDr["CONV_FACTOR"];
        destDr["CONV_FACTOR_SML"] = srcDr["CONV_FACTOR_SML"];
        destDr["SML_UOM"] = srcDr["SML_UOM"];
        destDr["SALE_UOM"] = srcDr["SALE_UOM"];
        destDr["DEFAULT_UOM"] = srcDr["DEFAULT_UOM"];
        this.dtSDiscList.Rows.Add(destDr);
    }

    int BuyTypeLvl = 0;
    decimal prdQty = decimal.Zero;
    string BuyUOM = "";

    decimal BuyQPTttlBuyQ = gcs_Promo_Global.ToDecimal(TBuy_Qty) / gcs_Promo_Global.ToDecimal(TotalBuy_Qty);
    decimal DiscQUOM = decimal.Zero;
    decimal DefaultUOMConv = decimal.Zero;
    decimal DiscAmt = decimal.Zero;
    decimal TotalDiscAmt = decimal.Zero;
    string DefaultUOM = "";
    decimal DefaultUOMLVL = decimal.Zero;
    decimal CDEFUOMLVL = decimal.Zero;
    decimal forEveryFactor = decimal.Zero;

    foreach (DataRow drDisclevel in this.dtSDiscList.Select("UOM_CD = '" + BuyTypeUOM + "'" + " AND PRD_CD = '" + Prd_cd + "'"))
    {
        BuyTypeLvl = gcs_Promo_Global.ToInt(drDisclevel["UOM_LEVEL"].ToString());
    }

    foreach (DataRow drDiscDefault in this.dtSDiscList.Select("DEFAULT_UOM = 'True'" + " AND PRD_CD = '" + Prd_cd + "'"))
    {
        DefaultUOM = drDiscDefault["UOM_CD"].ToString();
        DefaultUOMLVL = gcs_Promo_Global.ToDecimal(drDiscDefault["UOM_LEVEL"]);
    }

    if (schemeFOREVERY == "True")//10061
    {
	    forEveryFactor = (decimal)EnhancedMath.RoundDown((double)(TBuy_Qty / promoForEveryEnt),0) * promoForEveryEnt;
    }


    for (int lvl = 1; lvl <= 4; lvl++)
    {
        decimal DiscQD = decimal.Zero;

        if (!drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") && drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() != "" && gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) > decimal.Zero)
        {
            prdQty = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
            BuyUOM = drOrdPrd["UOM" + lvl + "_UOM_CD"].ToString();
            DefaultUOMConv = gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);
            decimal DCONV = gcs_Promo_Global.ToDecimal(1);
            decimal UnitDiscBuyTypeUOM = decimal.Zero;

//            if (BuyTypeLvl > lvl || BuyTypeLvl < lvl)//64872
//            {
                decimal LvlConvSML = decimal.Zero;
                decimal BuyTypeConvSML = decimal.Zero;

                foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "'" + " AND PRD_CD = '" + Prd_cd + "'"))
                {
                    LvlConvSML = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                }

                foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + BuyTypeLvl + "'" + " AND PRD_CD = '" + Prd_cd + "'"))//64872
                {
                    BuyTypeConvSML = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                }

                if(applyOn == "1" && DicsType == "2")
                    //DiscQUOM =  Convert.ToInt32((((prdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(TotalBuy_Qty))); // * TotalBuy_Qty;//64872 //69847
                    //DiscQUOM =  (((prdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(TotalBuy_Qty)); // * TotalBuy_Qty;//64872 //69847 //78468
                    DiscQUOM =  (((prdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(TBuy_Qty)) * TotalBuy_Qty;//64872 //69847 //78468
                else
                    DiscQUOM = ((prdQty * LvlConvSML) / gcs_Promo_Global.ToDecimal(TBuy_Qty)) * TotalBuy_Qty;//64872


//            }//64872
//            else
//            {
//                DiscQUOM = (gcs_Promo_Global.ToDecimal(prdQty) / gcs_Promo_Global.ToDecimal(TBuy_Qty)) * TotalBuy_Qty;
//            }

            if (DicsType == "2") // by value
            {
                if (lvl > BuyTypeLvl)
                {
                    for (int j = lvl; j > BuyTypeLvl; j--)
                    {
                        if(j<=DefaultUOMLVL)//fix 34379
                        {
                            DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                        }
                    }
                }
                else if (lvl < BuyTypeLvl)
                {
                    for (int k = lvl; k <= BuyTypeLvl; k++)
                    {
                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                    }
                }
                else
                {
                    if (BuyTypeLvl < DefaultUOMLVL)
                    {
                        for (int l = lvl; l <= DefaultUOMLVL; l++)
                        {
                            DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + l + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                        }
                    }
                    else if (BuyTypeLvl > DefaultUOMLVL)
                    {
                        for (int m = lvl; m > DefaultUOMLVL; m--)
                        {
                            DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + m + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                        }
                    }
                    else
                    {
                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                    }
                }
            }

            if (DicsType == "3") // by percentage
            {
                if (lvl > BuyTypeLvl)
                {
                    for (int j = lvl; j > BuyTypeLvl; j--)
                    {
                        if(j<=DefaultUOMLVL)//fix 34379
                        {
                            DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                        }
                    }
                }
                else if (lvl < BuyTypeLvl)
                {
                    for (int k = lvl; k <= BuyTypeLvl; k++)
                    {
                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + Prd_cd + "'")[0]["CONV_FACTOR"]);
                    }
                }
                else
                {
                    DCONV = gcs_Promo_Global.ToDecimal(1);
                }

//                if (lvl > BuyTypeLvl || lvl < BuyTypeLvl){//64872
                foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "'" + " AND PRD_CD = '" + Prd_cd + "'"))//64872
                {
                    DCONV = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                    UnitDiscBuyTypeUOM = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]) * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);
                    UnitDiscBuyTypeUOM = UnitDiscBuyTypeUOM / DCONV;
                }
//                }else{//64872
//                    UnitDiscBuyTypeUOM = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]) * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);
//                }
            }

            if (DefaultUOMLVL < BuyTypeLvl)//64872//80247
            {
                DiscQD = gcs_Promo_Global.ToDecimal(DiscQUOM) * gcs_Promo_Global.ToDecimal(DCONV);
            }
            else if (DefaultUOMLVL > BuyTypeLvl)
            {
                DiscQD = gcs_Promo_Global.ToDecimal(DiscQUOM) / gcs_Promo_Global.ToDecimal(DCONV);
            }
            else
            {
                DiscQD = gcs_Promo_Global.ToDecimal(DiscQUOM);
            }

            if (DicsType == "3") // by percentage
            {
                DiscAmt = gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM) * gcs_Promo_Global.ToDecimal(DiscQUOM);
            }
            else if (DicsType == "2") // by value
            {
                if (schemeFOREVERY == "True")//10061
                    DiscAmt = gcs_Promo_Global.ToDecimal(factorvalue) * gcs_Promo_Global.ToDecimal(DiscQD) * (forEveryFactor / promoForEveryEnt);
                else
                    DiscAmt = gcs_Promo_Global.ToDecimal(factorvalue) * gcs_Promo_Global.ToDecimal(DiscQD);
            }
            TotalDiscAmt = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal(DiscAmt)).ToString("F" + this.gSetting.amtDecimal));
        }
    }
    return TotalDiscAmt;
}

private decimal getQpsDiffAccuDiscAmt(string promo_Cd, decimal factorValue, decimal qpsNewAccuDiscAmt, decimal qpsAccuDiscAmt, decimal qpsDiffAccuDiscAmt)
{
    if (((DataRow[])this.dtReturnPromoQPSFinal.Select("PROMO_CD='" + promo_Cd + "'")).Length > 0)
    {
        if (factorValue == -1)
            qpsNewAccuDiscAmt = decimal.Zero;

        qpsDiffAccuDiscAmt = qpsAccuDiscAmt - qpsNewAccuDiscAmt;

        if (qpsDiffAccuDiscAmt <= 0)
            qpsDiffAccuDiscAmt = 0;
    }
    return qpsDiffAccuDiscAmt;
}





//---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ----------
//
// 3. Check budget for every selected Promotion
//    This function must be declared in every page as the pop up page need to use page variable this.dtPromoSelectedTemp and counters
internal void checkSelectedFocPromoBudget(OfficeEngine Eng, string distCd, string slsmanCd)
{
    DataRow drPromoBudget = null;

    decimal var_promoDiscAmt = decimal.Zero;

    // Order Product details
    string var_prd_cd = "";
    int var_prd_index = 0;

    // Promotion budget that already allocate to temporary invoice
    decimal var_promoBudgetSoftAllocated = decimal.Zero;

    string toApply = "Y";
    string toApplyFOC = "N";

    // Temporary variable
    DataRow drPromoSelected = null;

    this.maxPromoSelected = ((DataRow[])dtPromoSelected.Select("HasFocPromo='Y'")).Length;

    this.assignFOCProductList = new Dictionary<string, DBXmlDataTable>();

    while (this.countPromoSelected < this.maxPromoSelected) // 0
    {
        toApply = "Y";
        toApplyFOC = "N";

        this.countPromoSelectedStop = this.countPromoSelected;
        var_promoBudgetSoftAllocated = decimal.Zero;

        drPromoSelected = (dtPromoSelected.Select("HasFocPromo='Y'", "PROMO_SEQ ASC"))[this.countPromoSelected];

        // For update PRD_DISC purpose
        string selPromoCd = drPromoSelected["PROMO_CD"].ToString();

        DBXmlDataTable dtFocPrd = null;
        DBXmlDataTable dtFocMappingPrd = null;
        DBXmlDataTable dtFocMaxCount = null;
        ///UI must move later
        getAssignFocPrdList(Eng, drPromoSelected["DIST_CD"].ToString(), selPromoCd, out dtFocPrd, out dtFocMappingPrd, out dtFocMaxCount);

        if (assignFOCProductList.ContainsKey(selPromoCd))
        {
            assignFOCProductList[selPromoCd] = dtFocPrd;
        }
        else
        {
            assignFOCProductList.Add(selPromoCd, dtFocPrd);
        }

        drPromoBudget = null;
        var_promoDiscAmt = decimal.Zero;

        string promo_Cd = drPromoSelected["PROMO_CD"].ToString();

        //Check product has been used in other promotion
        if (this.single_promo.Contains("S"))
        {
            bool notApplyPromo = false;
            foreach (DataRow drOrdPromoTemp in dtFocMappingPrd.Select("PROMO_CD = '" + promo_Cd + "'"))
            {
                string prd_Cd = drOrdPromoTemp["PRD_CD"].ToString();
                if (((DataRow[])dtOrdPromoDiscApplied.Select("PRD_CD = '" + prd_Cd + "'")).Length > 0)
                {
                    notApplyPromo = true;
                    break;
                }
            }
            if (notApplyPromo)
            {
                this.countPromoSelected = this.countPromoSelected + 1;
                continue;
            }
        }

        //TODO:Known Bug: not yet to do:1. Validate FOC product, not entitle to this promotion if FOC product is inactive or not assigned to this salesman
        //                              2. Check available stock
        //Refer to: Old Promotion: pag_TI_EditGeneral
        // added by sung chun 20121123 - issue 0041693: Transaction > Order/ Invoice > promotion> found NO foc rebate prd is added in the listing after applied.
        //DataRow[] drOrdPromoTemps = dtOrdPromoMappingPrd.Select("PROMO_CD = '" + promo_Cd + "'");
        DataRow[] drOrdPromoTemps = dtFocMappingPrd.Select("PROMO_CD = '" + promo_Cd + "'");
        if (drOrdPromoTemps.Length <= 0)
        {
            toApply = "Y";
            toApplyFOC = "Y";
        }
        // end issue 0041693

        decimal prdBuyQty;

        foreach (DataRow drOrdPromoTemp in drOrdPromoTemps) // 2
        {
            var_prd_cd = drOrdPromoTemp["PRD_CD"].ToString();
            string filter = "PRD_CD             = '" + var_prd_cd + "'"
                          + " AND PROMO_IND     = 'True'";

            if (gFeatures.gIndiaTax == true)
            {
                filter = filter + " AND PRD_SLSTYPE   = 'S' AND ISNULL(CHARGEFOC_IND,'False') <> 'True'"
                                 + filterOutSBY();
            }
            else
            {
                filter = filter + " AND PRD_SLSTYPE   = 'S'"
                                 + filterOutSBY();
            }

            foreach (DataRow drOrdPrdTemp in dtOrdPrd.Select(filter)) // 3
            {
                var_prd_index = Convert.ToInt32(drOrdPrdTemp["PRD_INDEX"]);//94631
                if (((DataRow[])dtOrdPromoDiscApplied.Select("PROMO_CD = '" + promo_Cd + "' AND PRD_CD = '" + var_prd_cd + "' AND PRD_INDEX = '" + var_prd_index + "' AND PROMO_INDEX = '" + drOrdPromoTemp["PROMO_INDEX"].ToString() + "'")).Length > 0)
                {
                    toApply = "N";
                }
                else
                {
                    toApply = "Y";
                    toApplyFOC = "Y";
                }

                if (toApply == "Y")
                {
                    // filter out zero qty to avoid division error when ttl buy is zero
                    prdBuyQty = getheSameUOMPrdQty(drOrdPrdTemp, drOrdPromoTemp["UOM_CD"].ToString());

                    if (prdBuyQty > 0)
                    {
                        // Insert into dtOrdPromo (FOC), if it was overbudget and not selected, record will be deleted
                        DataRow newOrdPromo = dtOrdPromo.NewRow();
                        newOrdPromo["PRD_CD"] = var_prd_cd;
                        newOrdPromo["PRD_INDEX"] = var_prd_index;
                        newOrdPromo["PRD_SLSTYPE"] = "S";
                        newOrdPromo["PROMO_CD"] = drPromoSelected["PROMO_CD"];
                        newOrdPromo["PROMO_INDEX"] = drOrdPromoTemp["PROMO_INDEX"];
                        newOrdPromo["PROMO_SEQ"] = drPromoSelected["PROMO_SEQ"];
                        newOrdPromo["MECHANIC_TYPE"] = "1";
                        newOrdPromo["DISC_PERC"] = "0.0000";
                        newOrdPromo["DISC_AMT"] = "0.0000";
                        newOrdPromo["PRD_BUY"] = prdBuyQty.ToString("F" + this.gSetting.amtDecimal);
                        newOrdPromo["ORDPRD_INDEX"] = var_prd_index;
                        newOrdPromo["ORDPRD_INDEX_TMP"] = var_prd_index;
                        newOrdPromo["AVG_SLS"] = "0.0000";

                        DataRow[] dtMSL = this.dtOrdPromoMappingPrd.Select("PROMO_CD = '" + promo_Cd + "' AND PRD_CD ='" + var_prd_cd + "'");
                        string msl_Ind = "";
                        if (dtMSL.Length > 0){
                            msl_Ind = dtMSL[0]["MSL_IND"].ToString();
                        }

                        //string msl_Ind = this.dtOrdPromoMappingPrd.Select("PROMO_CD = '" + promo_Cd + "' AND PRD_CD ='" + var_prd_cd + "'")[0]["MSL_IND"].ToString();// fix 48191
                        newOrdPromo["MSL_IND"] = msl_Ind;// fix 48191
                        dtOrdPromo.Rows.Add(newOrdPromo);

                        DataRow OrdPromoDiscApplied = dtOrdPromoDiscApplied.NewRow();
                        OrdPromoDiscApplied["PROMO_CD"] = drPromoSelected["PROMO_CD"];
                        OrdPromoDiscApplied["PRD_CD"] = var_prd_cd;
                        ///c "PRD_INDEX" for india only
                        OrdPromoDiscApplied["PRD_INDEX"] = var_prd_index;
                        OrdPromoDiscApplied["MECHANIC_TYPE"] = "1";
                        OrdPromoDiscApplied["PROMO_INDEX"] = drOrdPromoTemp["PROMO_INDEX"];
                        dtOrdPromoDiscApplied.Rows.Add(OrdPromoDiscApplied);
                    }

                }
            } // 3d
            updateFocPromoTotalBuy(drPromoSelected["PROMO_CD"].ToString());
        }
        if (toApplyFOC == "N") // To give FOC or not
        {
            this.countPromoSelected = this.countPromoSelected + 1;
        }
        else
        {
            if (gcs_Promo_Global.ToDecimal(drPromoSelected["BUDGET"]) > decimal.Zero)
            {
                if (this.dtTxnOrdPromo != null && this.dtTxnOrdPromo.Rows.Count > 0 && this.txnMode == Enum.TxnMode.INVOICE_EDIT)
                {
                    var_promoBudgetSoftAllocated = gcs_Promo_Global.ToDecimal(this.dtTxnOrdPromo.Compute("SUM(BUDGET_AMT)", "PROMO_CD = '" + drPromoSelected["PROMO_CD"].ToString() + "'"));
                }

                DataRow[] drPromoBudgets = this.dtPromoSelectedBudget.Select("DIST_CD='" + drPromoSelected["DIST_CD"].ToString() + "' AND PROMO_CD='" + drPromoSelected["PROMO_CD"].ToString() + "'");
                if (drPromoBudgets.Length > 0)
                    drPromoBudget = drPromoBudgets[0];
                else
                    drPromoBudget = null;

                //                drPromoBudget = usp_Promo_Fun.getPromoBudget(Eng
                //                                                      , drPromoSelected["DIST_CD"].ToString()
                //                                                      , drPromoSelected["PROMO_CD"].ToString()
                //                                                      , distCd
                //                                                      , slsmanCd
                //                                                      , this.Cust_cd
                //                                                      );

                if (var_promoDiscAmt > (gcs_Promo_Global.ToDecimal(drPromoBudget["BALANCE"]) + gcs_Promo_Global.ToDecimal(drPromoBudget["SOFT_ALLOC"])))
                {
                    Eng.API.Alert(Eng.Localization.GetText("Budget for Promotion ") + promo_Cd + Eng.Localization.GetText(" is exceeded."));
                    DataRow drPromoNotApply = dtPromoNotApply.NewRow();
                    drPromoNotApply["PROMO_SEQ"] = drPromoSelected["PROMO_SEQ"];
                    drPromoNotApply["DIST_CD"] = drPromoSelected["DIST_CD"];
                    drPromoNotApply["PROMO_CD"] = drPromoSelected["PROMO_CD"];
                    drPromoNotApply["PROMO_DEdSC"] = drPromoSelected["PROMO_DESC"];
                    drPromoNotApply["START_DT"] = drPromoSelected["START_DT"];
                    drPromoNotApply["END_DT"] = drPromoSelected["END_DT"];
                    drPromoNotApply["BUDGET"] = drPromoSelected["BUDGET"];
                    drPromoNotApply["FOC_RATIO"] = drPromoSelected["FOC_RATIO"];
                    //2012-02-14 - Fixed support - 0035189: The system non- responded when applying promotion to Sales Order
                    drPromoNotApply["NOT_APPLY_TYPE"] = 2;
                    dtPromoNotApply.Rows.Add(drPromoNotApply);

                    // Delete Promotion from dtOrdPromo which will not be applied
                    foreach (DataRow drOrdPromo in dtOrdPromo.Select("PROMO_CD = '" + promo_Cd + "'"))
                    {
                        dtOrdPromo.Rows.Remove(drOrdPromo);
                    }

                    // Delete Promotion from dtOrdPromoTempApplied which will not be applied
                    foreach (DataRow drOrdPromoDiscApplied in dtOrdPromoDiscApplied.Select("PROMO_CD = '" + promo_Cd + "'"))
                    {
                        dtOrdPromoDiscApplied.Rows.Remove(drOrdPromoDiscApplied);
                    }

                    this.countPromoSelected = this.countPromoSelected + 1;

                    ///if(this.auto_promo != "A" || this.applyManualPromo == "Y")
                    ///if(this.auto_promo != "A" || this.applyManualPromo == "Y" || (this.auto_promo == "A" && this.CheckInvLvlPromo(Eng) == "Y"))
                    ///{
                    ///this.closeSelPromo(Eng);
                    ///}
                }
                else
                {
                    DataRow drPromoToApply = dtPromoToApply.NewRow();
                    drPromoToApply["PROMO_SEQ"] = drPromoSelected["PROMO_SEQ"];
                    drPromoToApply["DIST_CD"] = drPromoSelected["DIST_CD"];
                    drPromoToApply["PROMO_CD"] = drPromoSelected["PROMO_CD"];
                    drPromoToApply["PROMO_DESC"] = drPromoSelected["PROMO_DESC"];
                    drPromoToApply["START_DT"] = drPromoSelected["START_DT"];
                    drPromoToApply["END_DT"] = drPromoSelected["END_DT"];
                    drPromoToApply["BUDGET"] = drPromoSelected["BUDGET"];
                    drPromoToApply["FOC_RATIO"] = drPromoSelected["FOC_RATIO"];
                    dtPromoToApply.Rows.Add(drPromoToApply);

                    this.countPromoSelected = this.countPromoSelected + 1;
                }
            }
            else
            {
                DataRow drPromoToApply = dtPromoToApply.NewRow();
                drPromoToApply["PROMO_SEQ"] = drPromoSelected["PROMO_SEQ"];
                drPromoToApply["DIST_CD"] = drPromoSelected["DIST_CD"];
                drPromoToApply["PROMO_CD"] = drPromoSelected["PROMO_CD"];
                drPromoToApply["PROMO_DESC"] = drPromoSelected["PROMO_DESC"];
                drPromoToApply["START_DT"] = drPromoSelected["START_DT"];
                drPromoToApply["END_DT"] = drPromoSelected["END_DT"];
                drPromoToApply["BUDGET"] = drPromoSelected["BUDGET"];
                drPromoToApply["FOC_RATIO"] = drPromoSelected["FOC_RATIO"];
                dtPromoToApply.Rows.Add(drPromoToApply);

                this.countPromoSelected = this.countPromoSelected + 1;
            }
        } // To give FOC or not
    } // 0
    this.addPromoFOCPrd(Eng);
    ///this.sortOrdPrd(this.grd_List,dtOrdPrd);
}


