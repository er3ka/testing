												decimal UnitDiscBuyTypeUOM = decimal.Zero;
												decimal CustGrpDisc = decimal.Zero;
												decimal CustChnlDisc = decimal.Zero;

												UnitDiscBuyTypeUOM = (prdListPrc * gcs_Promo_Global.ToDecimal(factorValue)) / gcs_Promo_Global.ToDecimal(100);//fix 20385
												GrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);
												CustGrpDisc = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_GRP_DISC"]);
												CustChnlDisc = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_CHNL_DISC"]);

											    GrossAmtRatio = (gcs_Promo_Global.ToDecimal(qpsEntTtlBuy) * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(ProrataBuyAmt);
									//fix 57970
