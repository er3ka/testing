    //foreach(DataRow focDr in dt.Select("", "PRD_CD"))
    foreach (DataRow focDr in tempDT.Select("", "PRD_CD"))
    {
        PRD_CD_CURRENT = focDr["PRD_CD"].ToString();
        ///confirm???
        if (this.gFeatures.gIndiaTax == true)
            MRP_CURRENT = focDr["MRP"].ToString();
        else
            MRP_CURRENT = "";

        int currConvfSml = 0;
        int nextConvfSml = 0;

        for (int i = 1; i < 4; i++)
        {
            int convqty = 0;
            int j = i + 1;
            if (j <= 4)
            {
                if (currConvfSml == 0 && nextConvfSml == 0)
                {
                    currConvfSml = gcs_Promo_Global.ToInt(focDr["UOM" + i + "_UOM_CONVFACTOR"].ToString());
                }
                else
                {
                    currConvfSml = nextConvfSml;
                }
                nextConvfSml = gcs_Promo_Global.ToInt(focDr["UOM" + i + "_UOM_CONVFACTOR"].ToString()) * gcs_Promo_Global.ToInt(focDr["UOM" + j + "_UOM_CONVFACTOR"].ToString());
                int nextqty = gcs_Promo_Global.ToInt(focDr["UOM" + j + "_PRD_QTY"].ToString());
                if (nextConvfSml > 0)
                {
                    int smlqty = gcs_Promo_Global.ToInt(focDr["UOM" + i + "_PRD_QTY"].ToString()) * currConvfSml;
                    int qtyf = smlqty / nextConvfSml;
                    int qtyr = smlqty % nextConvfSml;

                    if (qtyr > 0)
                    {
                        focDr["UOM" + i + "_PRD_QTY"] = qtyr / currConvfSml;
                        focDr["UOM" + i + "_ORG_QTY"] = qtyr;
                        focDr["UOM" + i + "_UOM_LISTPRC"] = 0.0000;

                        focDr["UOM" + i + "_GROSS_AMT"] = 0.0000;
                        focDr["UOM" + i + "_PROMO_DISC"] = 0.0000;
                        focDr["UOM" + i + "_SLS_DISC"] = 0.0000;
                        focDr["UOM" + i + "_DISC_AMT"] = 0.0000;
                        focDr["UOM" + i + "_NET_AMT"] = 0.0000;
                        focDr["UOM" + i + "_NET_AMT_TAX"] = 0.0000;
                        focDr["UOM" + i + "_TAX_PERC1"] = 0.0;
                        focDr["UOM" + i + "_TAX_PERC2"] = 0.0;
                        focDr["UOM" + i + "_TAX_PERC3"] = 0.0000;
                        focDr["UOM" + i + "_TAX_AMT1"] = 0.0000;
                        focDr["UOM" + i + "_TAX_AMT2"] = 0.0000;
                        focDr["UOM" + i + "_TAX_AMT3"] = 0.0000;
                        focDr["UOM" + i + "_TAX_AMT"] = 0.0000;
                    }
                    else
                    {
                        focDr["UOM" + i + "_PRD_QTY"] = System.DBNull.Value;
                        focDr["UOM" + i + "_ORG_QTY"] = System.DBNull.Value;
                        focDr["UOM" + i + "_UOM_LISTPRC"] = System.DBNull.Value;

                        focDr["UOM" + i + "_GROSS_AMT"] = System.DBNull.Value;
                        focDr["UOM" + i + "_PROMO_DISC"] = System.DBNull.Value;
                        focDr["UOM" + i + "_SLS_DISC"] = System.DBNull.Value;
                        focDr["UOM" + i + "_DISC_AMT"] = System.DBNull.Value;
                        focDr["UOM" + i + "_NET_AMT"] = System.DBNull.Value;
                        focDr["UOM" + i + "_NET_AMT_TAX"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_PERC1"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_PERC2"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_PERC3"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_AMT1"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_AMT2"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_AMT3"] = System.DBNull.Value;
                        focDr["UOM" + i + "_TAX_AMT"] = System.DBNull.Value;
                    }

                    if (qtyf > 0)
                    {
                        nextqty += qtyf;
                        focDr["UOM" + j + "_PRD_QTY"] = nextqty;
                        focDr["UOM" + j + "_ORG_QTY"] = nextqty * nextConvfSml;
                        focDr["UOM" + j + "_UOM_LISTPRC"] = 0.0000;

                        focDr["UOM" + j + "_GROSS_AMT"] = 0.0000;
                        focDr["UOM" + j + "_PROMO_DISC"] = 0.0000;
                        focDr["UOM" + j + "_SLS_DISC"] = 0.0000;
                        focDr["UOM" + j + "_DISC_AMT"] = 0.0000;
                        focDr["UOM" + j + "_NET_AMT"] = 0.0000;
                        focDr["UOM" + j + "_NET_AMT_TAX"] = 0.0000;
                        focDr["UOM" + j + "_TAX_PERC1"] = 0.0;
                        focDr["UOM" + j + "_TAX_PERC2"] = 0.0;
                        focDr["UOM" + j + "_TAX_PERC3"] = 0.0000;
                        focDr["UOM" + j + "_TAX_AMT1"] = 0.0000;
                        focDr["UOM" + j + "_TAX_AMT2"] = 0.0000;
                        focDr["UOM" + j + "_TAX_AMT3"] = 0.0000;
                        focDr["UOM" + j + "_TAX_AMT"] = 0.0000;
                    }
                }
            }
        }

        focDr["PRD_QTY"] = "";
        for (int i = 1; i <= 4; i++)
        {
            if (gcs_Promo_Global.ToInt(focDr["UOM" + i + "_PRD_QTY"].ToString()) > 0)
            {
                focDr["PRD_QTY"] = (focDr["PRD_QTY"].ToString() == "") ?
                                    Eng.Culture.GetValue(focDr["UOM" + i + "_PRD_QTY"]) + " " + focDr["UOM" + i + "_UOM_CD"] :
                                    Eng.Culture.GetValue(focDr["UOM" + i + "_PRD_QTY"]) + " " + focDr["UOM" + i + "_UOM_CD"] + "<BR>" + focDr["PRD_QTY"];//decimal separator
            }
        }

        for (int i = 4; i >= 1; i--)
        {
            if (gcs_Promo_Global.ToInt(focDr["UOM" + i + "_PRD_QTY"].ToString()) > 0)
            {
                UOM_CD_CURRENT = focDr["UOM" + i + "_UOM_CD"].ToString();
            }

            if (UOM_CD_CURRENT != "")
                break;
        }

        // Same FOC product with different sequence should be grouped together
        //if(PRD_CD_CURRENT == PRD_CD_PREVIOUS && fodDr_Previous != null && PROMO_INDEX_CURRENT == PROMO_INDEX_PREVIOUS)
        if (PRD_CD_CURRENT == PRD_CD_PREVIOUS && MRP_CURRENT == MRP_PREVIOUS && fodDr_Previous != null)
        {
            string PRD_QTY_FORMATTED = "";
            string strUomCd = "";
            string strPrdQty = "";
            string strPrdQtyPrevious = "";
            string strOrgQty = "";
            string strOrgQtyPrevious = "";

            for (int j = 4; j >= 1; j--)
            {
                strUomCd = focDr["UOM" + j + "_UOM_CD"].ToString();
                strPrdQty = focDr["UOM" + j + "_PRD_QTY"].ToString();
                strPrdQtyPrevious = fodDr_Previous["UOM" + j + "_PRD_QTY"].ToString();

                if (strPrdQty != "" && strUomCd != "")
                {
                    if (strPrdQtyPrevious != "")
                    {
                        strPrdQty = (gcs_Promo_Global.ToDecimal(strPrdQty) + gcs_Promo_Global.ToDecimal(strPrdQtyPrevious)).ToString("F0");
                    }
                    fodDr_Previous["UOM" + j + "_PRD_QTY"] = strPrdQty;

                    // Edit invoice will have additional UOMx_ORG_QTY column
                    if (fodDr_Previous.Table.Columns.Contains("UOM" + j + "_ORG_QTY"))
                    {
                        strOrgQty = focDr["UOM" + j + "_ORG_QTY"].ToString();
                        strOrgQty = (gcs_Promo_Global.ToDecimal(strOrgQty) + gcs_Promo_Global.ToDecimal(fodDr_Previous["UOM" + j + "_ORG_QTY"])).ToString("F0");
                        fodDr_Previous["UOM" + j + "_ORG_QTY"] = strOrgQty;
                    }
                    PRD_QTY_FORMATTED = PRD_QTY_FORMATTED + " " + strPrdQty + " " + strUomCd;
                }
                else
                {
                    if (strPrdQtyPrevious != "")
                    {
                        PRD_QTY_FORMATTED = PRD_QTY_FORMATTED + " " + strPrdQtyPrevious + " " + fodDr_Previous["UOM" + j + "_UOM_CD"].ToString();
                    }
                }
            }
            fodDr_Previous["PRD_QTY"] = PRD_QTY_FORMATTED;
            fodDr_Previous["PRD_QTY_SML"] = gcs_Promo_Global.ToDecimal(fodDr_Previous["PRD_QTY_SML"]) + gcs_Promo_Global.ToDecimal(focDr["PRD_QTY_SML"]);
        }
        else
        {
            DataRow drNewOrdPrd = dtOrdPrd.NewRow();
            foreach (string colName in cols)
            {
                drNewOrdPrd[colName] = focDr[colName];
            }

            ///confirm????
            if (this.gFeatures.gIndiaTax == true)
            {
                drNewOrdPrd["UOM"] = UOM_CD_CURRENT + this.gSetting.gTxnUOMDisplayFormat;
                drNewOrdPrd["DISC_PERC"] = decimal.Zero.ToString("F" + this.gSetting.amtDecimal);
                drNewOrdPrd["MRP"] = focDr["MRP"];//RETURN BY BATCH
            }
            else
            {
                if (this.storeTaxCd == false)
                {
                    drNewOrdPrd["PRD_MYTAX_CD"] = "";
                    drNewOrdPrd["UOM4_TAX_PERC"] = "";
                    drNewOrdPrd["UOM3_TAX_PERC"] = "";
                    drNewOrdPrd["UOM2_TAX_PERC"] = "";
                    drNewOrdPrd["UOM1_TAX_PERC"] = "";
                }
                else if (drNewOrdPrd["TAX_IND"].ToString() != "True")
                {
                    drNewOrdPrd["PRD_MYTAX_CD"] = "";
                    drNewOrdPrd["UOM4_TAX_PERC"] = "";
                    drNewOrdPrd["UOM3_TAX_PERC"] = "";
                    drNewOrdPrd["UOM2_TAX_PERC"] = "";
                    drNewOrdPrd["UOM1_TAX_PERC"] = "";
                }
            }

            drNewOrdPrd["PRD_INDEX"] = Convert.ToInt32(focDr["PRD_INDEX"]) + increase++;

            for (int k = dtOrdPrd.Rows.Count - 1; k >= 0; k--)
            {
                DataRow drOrdPrdUpdIdx = dtOrdPrd.Rows[k];
                if (Convert.ToInt32(drOrdPrdUpdIdx["PRD_INDEX"]) >= focPrdIndex)
                {
                    DataRow[] drPromoDiscs = null;
                    DataRow[] drPromoAllocFocs = null;
                    //update prd_index of ordpromo
                    DataRow[] drPromos = dtOrdPromo.Select("ORDPRD_INDEX = '" + drOrdPrdUpdIdx["PRD_INDEX"].ToString() + "'"
                        + " AND PRD_CD = '" + drOrdPrdUpdIdx["PRD_CD"].ToString() + "'"
                        + " AND PRD_SLSTYPE = '" + drOrdPrdUpdIdx["PRD_SLSTYPE"].ToString() + "'", "PRD_INDEX DESC");

                    drPromoDiscs = dtOrdPromoDiscApplied.Select("PRD_INDEX = '" + drOrdPrdUpdIdx["PRD_INDEX"].ToString() + "'"
                        + " AND PRD_CD = '" + drOrdPrdUpdIdx["PRD_CD"].ToString() + "'", "PRD_INDEX DESC");

                    drPromoAllocFocs = dtSelectedFocList.Select("PRD_INDEX = '" + drOrdPrdUpdIdx["PRD_INDEX"].ToString() + "'"
                        + " AND PRD_CD = '" + drOrdPrdUpdIdx["PRD_CD"].ToString() + "'", "PRD_INDEX DESC");

                    drOrdPrdUpdIdx["PRD_INDEX"] = Convert.ToInt32(drOrdPrdUpdIdx["PRD_INDEX"]) + 1;
                    foreach (DataRow drPromo in drPromos)
                    {
                        DataRow[] drPromoDtls = dtPromoDetail.Select("PRD_INDEX = '" + drPromo["PRD_INDEX"].ToString() + "'"
                        + " AND PRD_CD = '" + drPromo["PRD_CD"].ToString() + "'", "PRD_INDEX DESC");

                        foreach (DataRow drPromoDtl in drPromoDtls)
                        {
                            drPromoDtl["PRD_INDEX"] = gcs_Promo_Global.ToInt(drPromoDtl["PRD_INDEX"].ToString()) + 1;
                        }

                        ///confirm???
                        if (this.gFeatures.gIndiaTax == true)
                        {
                            //return by batch
                            DataRow[] drSelectedFocLists = dtSelectedFocList.Select("PRD_INDEX = '" + drPromo["PRD_INDEX"].ToString() + "'"
                            + " AND PRD_CD = '" + drPromo["PRD_CD"].ToString() + "'", "PRD_INDEX DESC");

                            foreach (DataRow drSelectedFocList in drSelectedFocLists)
                            {
                                //drPromoDtl["PRD_INDEX"] = drOrdPrdUpdIdx["PRD_INDEX"];
                                drSelectedFocList["PRD_INDEX"] = gcs_Promo_Global.ToInt(drSelectedFocList["PRD_INDEX"].ToString()) + 1;
                            }
                        }

                        drPromo["PRD_INDEX"] = gcs_Promo_Global.ToInt(drPromo["PRD_INDEX"].ToString()) + 1;
                        drPromo["ORDPRD_INDEX"] = drOrdPrdUpdIdx["PRD_INDEX"];
                        drPromo["ORDPRD_INDEX_TMP"] = drOrdPrdUpdIdx["PRD_INDEX"];
                    }

                    foreach (DataRow drPromoDisc in drPromoDiscs)
                    {
                        drPromoDisc["PRD_INDEX"] = drOrdPrdUpdIdx["PRD_INDEX"];
                    }

                    foreach (DataRow drPromoAllocFoc in drPromoAllocFocs)
                    {
                        drPromoAllocFoc["PRD_INDEX"] = drOrdPrdUpdIdx["PRD_INDEX"];
                    }
                }
            }
            // Display available stock in uom
            if (txnMode == Enum.TxnMode.ORDER_NEW || txnMode == Enum.TxnMode.ORDER_EDIT)
            {
                drNewOrdPrd["AVAILABLE_STK_FORMATTED"] = focDr["AVAILABLE_STK_FORMATTED"];
            }

            drNewOrdPrd["PRD_QTY_SML"] = focDr["PRD_QTY_SML"];
            if (!this.gFeatures.gIndiaTax)
            {
                ///confirm in std only???
                drNewOrdPrd["IS_SAMPLE"] = "0";//sampling
            }
            dtOrdPrd.Rows.InsertAt(drNewOrdPrd, focPrdIndex - 1);

            PRD_CD_PREVIOUS = PRD_CD_CURRENT;
            UOM_CD_PREVIOUS = UOM_CD_CURRENT;

            if (this.gFeatures.gIndiaTax == true)
                MRP_PREVIOUS = MRP_CURRENT;
            else
                MRP_PREVIOUS = "";

            PROMO_INDEX_PREVIOUS = PROMO_INDEX_CURRENT;

            fodDr_Previous = drNewOrdPrd;
            focPrdIndex++;
        }
    }

    return dbXmldtFocPrds;
}


private DBXmlDataTable getSelFocPrdList2(OfficeEngine Eng, string promoDistCd, string promoCd)
{
    DBXmlDataTable focPrd = null;
    if (assignFOCProductList.ContainsKey(promoCd))
    {

        focPrd = assignFOCProductList[promoCd];
        focPrd.DefaultView.Sort = "PRD_CD ASC";
        focPrd.AcceptChanges();

    }
    if (focPrd == null || focPrd.Rows.Count == 0)
    {
        focPrd = getPromoFocListFromDB(Eng, promoDistCd, promoCd);
    }
    return focPrd;
}


// 5. Update Promotion Discount Amount
// 把 PRD_DISC 所設的值 ,分別設定到 真要要顯示的 UOM_X_PROMO_DISC , UOM_X_DISC_AMT , DISC_AMT
//private void calcOrdPrdPromoDisc(OfficeEngine Eng,gcs_INDTax.INDTax obj,gcs_INDTax.TaxInfoArray taxList,DataTable dtOrdPrd, DBXmlDataTable promoEntitled, DBXmlDataTable dtOrdPromo, DBXmlDataTable dtOrdPromoDiscApplied, DBXmlDataTable dtSDiscList, DBXmlDataTable dtPromoUnitDiscCalc, DBXmlDataTable dtPromoDiscExceeded, DBXmlDataTable taxDetail,Enum.TxnMode txnMode, string sales_disc_ind, decimal cust_grp_disc_perc,  bool promo_price_group, decimal CustDisc,int this.gSetting.amtDecimal, string gTxnUOMDisplayFormat)
private void calcOrdPrdPromoDisc(OfficeEngine Eng, DataTable dtOrdPrd)
{
    string filter = "PRD_SLSTYPE = 'S'" + filterOutSBY();
    if (this.gFeatures.gIndiaTax)
    {
        filter += " AND ISNULL(CHARGEFOC_IND,'False') <> 'True'";
    }
    foreach (DataRow drOrdPrd in dtOrdPrd.Select(filter)) //S-Sales | F-FOC
    {
        drOrdPrd["DISC_AMT"] = "";

        //2011-03-30 Discount Amout does not clear from listing
        //Set all discount to defualt as empty
        for (int lvl = 4; lvl > 0; lvl--)
        {
            drOrdPrd["UOM" + lvl + "_PROMO_DISC"] = 0;
            //drOrdPrd["UOM" + lvl + "_DISC_AMT"] = ""; TODO:TDR2
            //fix 57970 add in cust grp and chnl disc before promo
            if (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString())>0)
            drOrdPrd["PRD_DISC" + lvl] = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_GRP_DISC"].ToString()) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString()))
                                        + (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_CHNL_DISC"].ToString()) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString()));//0;

            drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = "";

            if (!this.gFeatures.gIndiaTax)
            {
                drOrdPrd["UOM" + lvl + "_INVPROMO_DISC"] = 0;
                drOrdPrd["UOM" + lvl + "_INVDISC_AMT"] = "0";
            }
        }

        DBXmlDataTable dtOrdPromoDiscApplied = this.dtOrdPromoDiscApplied;
        if (dtOrdPrd == this.dtOrdPrdHq)
            dtOrdPromoDiscApplied = this.dtOrdPromoDiscAppliedHq;

        DataRow[] prdPromoDiscs = dtOrdPromoDiscApplied.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "' AND MECHANIC_TYPE<>'1' AND PRD_INDEX='" + drOrdPrd["PRD_INDEX"].ToString() + "'", "PROMO_SEQ ASC");
        if (prdPromoDiscs.Length > 0)
        {
            //decimal sumDiscAmt = decimal.Zero; // sungchun 20130117:move into the loop
            decimal sumPrdDiscAmt = decimal.Zero;
            foreach (DataRow drPrdPromoDisc in prdPromoDiscs)
            {
                if (this.gFeatures.gIndiaTax)
                {
                    getSchemeTDR(this.Eng, drPrdPromoDisc["PROMO_CD"].ToString());
                }
                decimal sumDiscAmt = decimal.Zero; // sungchun 20130117:make sure no value was bring into the calculation.
                bool bPerInvoice = (drPrdPromoDisc["APPLY_ON"].Equals("2") || drPrdPromoDisc["APPLY_ON"].Equals("3"));
                string mechanicType = drPrdPromoDisc["MECHANIC_TYPE"].ToString();
                sumDiscAmt = setOrdPrdDiscAmtDisp(drOrdPrd
                                                  , bPerInvoice
                                                  , sumDiscAmt
                                                  , drPrdPromoDisc["PROMO_CD"].ToString()
                                                  , mechanicType
                                                  , ref sumPrdDiscAmt
                                                  , Eng
                                                  );
            }
        }
        else
            setOrdPrdDiscAmtDisp(drOrdPrd, false, 0, string.Empty, Eng);

        // fix 43458
        decimal TotalUnitDiscAmt = 0;
        for (int lvl = 4; lvl > 0; lvl --)
        {
            decimal UnitDiscAmt = gcs_Promo_Global.ToDecimal( drOrdPrd["UOM" + lvl + "_DISC_AMT"].ToString() );
            int convFactor = gcs_Promo_Global.ToInt( drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString() );
            int buyQty = gcs_Promo_Global.ToInt( drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() );

            if (buyQty > 0){
                UnitDiscAmt = UnitDiscAmt / convFactor / buyQty;
                TotalUnitDiscAmt = TotalUnitDiscAmt + UnitDiscAmt;
            }
        }

        if (this.gFeatures.gIndiaTax)
        {
            drOrdPrd["UNIT_DISC"] = TotalUnitDiscAmt;
        }

    }

    if (sales_disc_ind == "True")
    {
        //this.applyOrdPrdSlsDisc(this.cust_hier3,dtOrdPrd);
    }
    else
    {
        this.calcOrdPrdAllAmt(Eng, dtOrdPrd);
    }
}


private void getSchemeTDR(OfficeEngine Eng, string promo_cd)
{
    try
    {
        DataRow[] drs = dtPromoEntitled.Select("PROMO_CD='" + promo_cd + "'");
        if (drs.Length > 0)
        {
            this.scheme_TDR = drs[0]["SCHEME_TDR"].ToString();
            obj.scheme_TDR = drs[0]["SCHEME_TDR"].ToString();
        }
        else
        {
            this.scheme_TDR = "False";
            obj.scheme_TDR = "False";
        }

    }
    catch
    {
        Eng.API.Alert(Eng.Localization.GetText("Error found when getting scheme TDR."));
    }
}


decimal setOrdPrdDiscAmtDisp(DataRow drOrdPrd, bool bPerInvoice, decimal sumPrepPromoDisc, string promoCd, OfficeEngine Eng)
{
    decimal tmp = decimal.Zero;
    return setOrdPrdDiscAmtDisp(drOrdPrd, bPerInvoice, sumPrepPromoDisc, promoCd, "", ref tmp, Eng);
}


decimal setOrdPrdDiscAmtDisp(DataRow drOrdPrd, bool bPerInvoice, decimal sumPrepPromoDisc, string promoCd, string mechanicType, ref decimal sumPrdDiscAmt, OfficeEngine Eng)
{
	DBXmlDataTable dtPromoEntitled = this.dtPromoEntitled;
	DBXmlDataTable dtOrdPromoDiscApplied = this.dtOrdPromoDiscApplied;
	DBXmlDataTable dtOrdPromo = this.dtOrdPromo;

	if (this.calc_hq == true)
	{
		dtPromoEntitled = this.dtPromoEntitledHq;
		dtOrdPromoDiscApplied = this.dtOrdPromoDiscAppliedHq;
		dtOrdPromo = this.dtOrdPromoHq;
	}

    if (promoCd == "")
    {
        if (this.gFeatures.gIndiaTax)
        {
            drOrdPrd["UNIT_DISC"] = gcs_Promo_Global.ToDecimal(decimal.Zero.ToString("F" + this.gSetting.amtDecimal));
            drOrdPrd["DISC_PERC"] = decimal.Zero.ToString("F" + this.gSetting.amtDecimal);
        }
        return 0;
    }

    if (sumPrdDiscAmt == null)
        sumPrdDiscAmt = decimal.Zero;

    decimal defUomConvfactor = gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);
    decimal uomXListPrc, uomXPrdQty, uomXUomConvfactor, uomXCustGrpDisc, uomXCustChnlDisc;
    decimal uomXPromoDisc = decimal.Zero;
    decimal uomXInvPromoDisc = decimal.Zero;
    decimal sumDiscAmt = decimal.Zero;
    decimal sumDistPerc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(decimal.Zero).ToString("F" + this.gSetting.amtDecimal));
    string buyUomCd = "";
    decimal buyUomConvFactor = decimal.Zero;
    string scheme_QPS = "False";
    string scheme_prorata = "False";
    string scheme_combi = "False";
    string schemeRange = "False"; //fix 52955
    string schemeForEvery = "False"; //80182
    string promotype = "";
    string ApplyOn = dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + drOrdPrd["PRD_CD"].ToString() + "'")[0]["APPLY_ON"].ToString();
    string discMethod = dtPromoEntitled.Select("PROMO_CD = '" + promoCd + "'")[0]["DISC_METHOD"].ToString();
    decimal list_prc_disc = decimal.Zero;
    decimal listAccuPrcDisc = decimal.Zero;//fix 57970
    decimal unit_disc = decimal.Zero;
    decimal custChnlDiscPerc = decimal.Zero;
    string promo_progress = "False";
    string ttlbuy_type = "M";
    decimal forEveryFactor = decimal.Zero;


    if(drOrdPrd.Table.Columns.Contains("CUST_CHNL_DISC_PERC"))
        custChnlDiscPerc = gcs_Promo_Global.ToDecimal(drOrdPrd["CUST_CHNL_DISC_PERC"]);

    DataRow[] tmpRow = dtPromoEntitled.Select("PROMO_CD='" + promoCd + "'");

    if (tmpRow.Length > 0)
    {
        promotype = tmpRow[0]["TYPE"].ToString();

        if (promotype == "P")
        {
            buyUomCd = tmpRow[0]["TTLBUY_UOM_CD"].ToString();
            scheme_QPS = "N";
            scheme_prorata = "N";
            scheme_combi = "N";
        }
        else
        {
            buyUomCd = tmpRow[0]["TTLBUY_UOM_CD"].ToString();
            scheme_QPS = tmpRow[0]["SCHEME_QPS"].ToString();
            scheme_prorata = tmpRow[0]["SCHEME_PRORATA"].ToString();
            scheme_combi = tmpRow[0]["SCHEME_COMBI"].ToString();
        }
        schemeRange = tmpRow[0]["SCHEME_RANGE"].ToString();//fix 52955
        schemeForEvery = tmpRow[0]["FOR_EVERY_FLAG"].ToString();//80182
        promo_progress = tmpRow[0]["PROMO_PROGRESS"].ToString();
        ttlbuy_type = tmpRow[0]["TTLBUY_TYPE"].ToString();
    }

    DataRow[] drOrdPromos = dtOrdPromo.Select("ORDPRD_INDEX='" + drOrdPrd["PRD_INDEX"].ToString()
                                            + "' AND PRD_CD='" + drOrdPrd["PRD_CD"].ToString()
                                            + "' AND PROMO_CD='" + promoCd + "'");

    decimal dPrdDisc = drOrdPromos.Length > 0 ? gcs_Promo_Global.ToDecimal(drOrdPromos[0]["PRD_DISC"]) : decimal.Zero;
    decimal dDiscAmt = drOrdPromos.Length > 0 ? gcs_Promo_Global.ToDecimal(drOrdPromos[0]["DISC_AMT"]) : decimal.Zero;
    decimal totalPromoDiscAmt = drOrdPromos.Length > 0 ? gcs_Promo_Global.ToDecimal(drOrdPromos[0]["TTL_DISC_AMT"]) : decimal.Zero;
    decimal dPrdDiscPerc = drOrdPromos.Length > 0 ? gcs_Promo_Global.ToDecimal(drOrdPromos[0]["DISC_PERC"]) : decimal.Zero;

    if (this.gFeatures.gIndiaTax)
    {
        drOrdPrd["UNIT_DISC"] = gcs_Promo_Global.ToDecimal(dPrdDisc / defUomConvfactor);
        drOrdPrd["DISC_PERC"] = gcs_Promo_Global.ToDecimal(dPrdDiscPerc.ToString("F" + this.gSetting.amtDecimal));

        foreach(DataRow drOrdPromo in dtOrdPromo.Select("MECHANIC_TYPE='3' AND ORDPRD_INDEX ='" + drOrdPrd["PRD_INDEX"].ToString() +
                 "' AND PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "'"))
        {
            sumDistPerc += gcs_Promo_Global.ToDecimal(drOrdPromo["DISC_PERC"]);
        }

        string filter = "PRD_CD='" + drOrdPrd["PRD_CD"].ToString()
                        + "' AND PROMO_CD='" + promoCd + "'"
                        + " AND MRP = '" + drOrdPrd["MRP"].ToString() + "'";

        if (((DataRow[])dtPromoUnitDiscCalc.Select(filter)).Length <= 0)
        {
            DataRow drPromoUnitDiscCalc = dtPromoUnitDiscCalc.NewRow();
            drPromoUnitDiscCalc["PRD_CD"] = drOrdPrd["PRD_CD"].ToString();
            drPromoUnitDiscCalc["PROMO_CD"] = promoCd;
            drPromoUnitDiscCalc["UNIT_DISC"] = drOrdPrd["UNIT_DISC"];
            drPromoUnitDiscCalc["MRP"] = drOrdPrd["MRP"];
            drPromoUnitDiscCalc["MECHANIC_TYPE"] = mechanicType;
            if (mechanicType == "2" && ApplyOn == "2")
                drPromoUnitDiscCalc["PER_PRODUCT"] = true; //bPerInvoice;
            else
                drPromoUnitDiscCalc["PER_PRODUCT"] = false;

            dtPromoUnitDiscCalc.Rows.Add(drPromoUnitDiscCalc);
        }
    }

    //UOM4~1
    bool perInvoiceHasApply = false;
    for (int lvl = 4; lvl > 0; lvl--)
    {
        if (drOrdPrd["UOM" + lvl + "_UOM_CD"].ToString() == buyUomCd)
        {
            buyUomConvFactor = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
        }
    }

    string PRD_CD = drOrdPrd["PRD_CD"].ToString();
    DataRow[] tbl = this.dtOrdPrdUOMInfo.Select("PRD_CD='" + PRD_CD + "'");

    foreach (DataRow srcDr in tbl)
    {
        DataRow destDr = this.dtSDiscList.NewRow();
        destDr["PRD_CD"] = srcDr["PRD_CD"];
        destDr["UOM_CD"] = srcDr["UOM_CD"];
        destDr["BASEUOM_CD"] = srcDr["BASEUOM_CD"];
        destDr["UOM_LEVEL"] = srcDr["UOM_LEVEL"];
        destDr["CONV_FACTOR"] = srcDr["CONV_FACTOR"];
        destDr["CONV_FACTOR_SML"] = srcDr["CONV_FACTOR_SML"];
        destDr["SML_UOM"] = srcDr["SML_UOM"];
        destDr["SALE_UOM"] = srcDr["SALE_UOM"];
        destDr["DEFAULT_UOM"] = srcDr["DEFAULT_UOM"];
        this.dtSDiscList.Rows.Add(destDr);
    }

    string BuyTypeUOM = dtPromoEntitled.Select("PROMO_CD='" + promoCd + "'")[0]["TTLBUY_UOM_CD"].ToString();
    decimal TotalBuy_Qty = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + PRD_CD + "'")[0]["TTLBUY_ENTITLED"]);
    decimal TBuy_Qty = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + PRD_CD + "'")[0]["TBUY_QTY"]);
    decimal factorvalue = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + PRD_CD + "'")[0]["FACTOR_VALUE"]);
    string buyType = dtPromoEntitled.Select("PROMO_CD='" + promoCd + "'")[0]["DTL_TYPE"].ToString();
    decimal TBuy_Amt = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + PRD_CD + "'")[0]["TBUY_AMT"]);
    decimal prdGrossAmt = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + PRD_CD + "'")[0]["PRD_GROSS_AMT"]);
    decimal totalPromoGrossAmt = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'" + " AND PRD_CD = '" + PRD_CD + "'")[0]["TTL_GROSS_AMT"]);
	decimal promoForEveryEnt = gcs_Promo_Global.ToDecimal(dtOrdPromoDiscApplied.Select("PROMO_CD='" + promoCd + "'")[0]["FOR_EVERY"]);//80182

    //fix 52955
    if(schemeRange == "True")
    {
        if(buyType == "Q")
            TotalBuy_Qty = TBuy_Qty;

        else if (buyType == "A")
            TotalBuy_Qty = TBuy_Amt;
    }
    //Prorata

    //Use gross amt with tax to calculate
    if(schemeForEvery == "True" && scheme_prorata == "False")//10061
    {
        if (buyType == "A")
    		forEveryFactor = (decimal)EnhancedMath.RoundDown((double)(TBuy_Amt / promoForEveryEnt), 0) * promoForEveryEnt;
        else if (buyType == "Q")
    		forEveryFactor = (decimal)EnhancedMath.RoundDown((double)(TBuy_Qty / promoForEveryEnt), 0) * promoForEveryEnt;
    }

    // fix 43458
	decimal unitDiscSml = 0;
    decimal prd_listprc = gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_LISTPRC"]);
    for (int lvl = 4; lvl > 0; lvl--)
    {
        uomXPrdQty = (drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") || drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() == "")
            ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
        uomXListPrc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"].ToString() == "")
            ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
        list_prc_disc = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_LISTPRCDISC") || drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"].ToString() == "")
            ? uomXListPrc : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"]);
//        if (discMethod == "True")
//            uomXListPrc = list_prc_disc;
//        uomXListPrc = cpuPromoPriceGroup(uomXListPrc,custChnlDiscPerc);
        //fix 57970 handle cust group disc
        listAccuPrcDisc = uomXListPrc - list_prc_disc;
        uomXListPrc = cpuPromoPriceGroup(uomXListPrc,custChnlDiscPerc);

        if (discMethod == "True")
            uomXListPrc = uomXListPrc - listAccuPrcDisc;

        if (uomXPrdQty > decimal.Zero)
        {
            uomXUomConvfactor = (drOrdPrd.IsNull("UOM" + lvl + "_UOM_CONVFACTOR") || drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"].ToString() == "")
                   ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
            uomXCustGrpDisc = (drOrdPrd.IsNull("UOM" + lvl + "_CUST_GRP_DISC") || drOrdPrd["UOM" + lvl + "_CUST_GRP_DISC"].ToString() == "")
                   ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_GRP_DISC"]);
            uomXCustChnlDisc = decimal.Zero;
            if(drOrdPrd.Table.Columns.Contains("UOM" + lvl + "_CUST_CHNL_DISC"))
             uomXCustChnlDisc = (drOrdPrd.IsNull("UOM" + lvl + "_CUST_CHNL_DISC") || drOrdPrd["UOM" + lvl + "_CUST_CHNL_DISC"].ToString() == "")
                   ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_CHNL_DISC"]);

            if (bPerInvoice && mechanicType == "2" && ApplyOn == "3")
            {
                if (this.gFeatures.gIndiaTax)
                {
                    uomXPromoDisc = dPrdDisc * uomXPrdQty * uomXUomConvfactor / defUomConvfactor;
                }
                else
                {
                    decimal uomGrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString());
                    decimal uomGrossRatio = (uomGrossAmt / totalPromoGrossAmt);
                    uomXPromoDisc = gcs_Promo_Global.ToDecimal((uomGrossRatio * totalPromoDiscAmt).ToString("F" + this.gSetting.amtDecimal));
                }
                unit_disc = uomXPromoDisc / uomXPrdQty;
            }
            else if (mechanicType == "2" && ApplyOn == "4")
            {
                decimal uomGrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString());
                decimal uomGrossRatio = (uomGrossAmt / totalPromoGrossAmt);
                uomXInvPromoDisc = gcs_Promo_Global.ToDecimal((uomGrossRatio * totalPromoDiscAmt).ToString("F" + this.gSetting.amtDecimal));
                unit_disc = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(uomXInvPromoDisc) / gcs_Promo_Global.ToDecimal(uomXPrdQty)).ToString("F" + this.gSetting.amtDecimal));
            }
            // disc by percentage
            else if (mechanicType == "3" && scheme_QPS == "False" && ApplyOn != "4")
            {
                uomXPromoDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(uomXListPrc * uomXPrdQty * dPrdDiscPerc / 100).ToString("F" + this.gSetting.amtDecimal));
                unit_disc = uomXPromoDisc / uomXPrdQty;
            }
            else if (mechanicType == "3" && scheme_QPS == "False" && ApplyOn == "4")
            {
                uomXInvPromoDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(uomXListPrc * uomXPrdQty * dPrdDiscPerc / 100).ToString("F" + this.gSetting.amtDecimal));
                unit_disc = uomXInvPromoDisc / uomXPrdQty;
            }
            else if (mechanicType == "3" && promotype == "P")
            {
                uomXPromoDisc = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(uomXListPrc * uomXPrdQty * dPrdDiscPerc / 100).ToString("F" + this.gSetting.amtDecimal));
                unit_disc = uomXListPrc * dPrdDiscPerc / 100;
            }
            // disc by value per product or uom
            else
            {
                uomXPromoDisc = dPrdDisc * uomXPrdQty * uomXUomConvfactor / defUomConvfactor;
                unit_disc = uomXPromoDisc / uomXPrdQty;
            }

            if ((mechanicType == "2" && scheme_prorata == "False" && scheme_QPS == "False" && scheme_combi == "False" && ApplyOn == "1") ||
                (mechanicType == "3" && scheme_prorata == "False" && scheme_QPS == "False" && scheme_combi == "False" && ApplyOn != "4"))
            {
                //Calculation By UOM
                if (buyType == "Q")
                {
                    int BuyTypeLvl = 0;
                    decimal prdQty = decimal.Zero;
                    string BuyUOM = "";
                    decimal BuyQPTttlBuyQ = gcs_Promo_Global.ToDecimal(TBuy_Qty) * gcs_Promo_Global.ToDecimal(TotalBuy_Qty);
                    decimal DiscQUOM = decimal.Zero;
                    decimal DefaultUOMConv = decimal.Zero;
                    decimal DiscAmt = decimal.Zero;
                    decimal TotalDiscAmt = decimal.Zero;
                    string DefaultUOM = "";
                    decimal DefaultUOMLVL = decimal.Zero;

                    foreach (DataRow drDisclevel in dtSDiscList.Select("UOM_CD = '" + BuyTypeUOM + "'" + " AND PRD_CD = '" + PRD_CD + "'"))
                    {
                        BuyTypeLvl = gcs_Promo_Global.ToInt(drDisclevel["UOM_LEVEL"].ToString());
                    }

                    foreach (DataRow drDiscDefault in dtSDiscList.Select("DEFAULT_UOM = 'True'" + " AND PRD_CD = '" + PRD_CD + "'"))
                    {
                        DefaultUOM = drDiscDefault["UOM_CD"].ToString();
                        DefaultUOMLVL = gcs_Promo_Global.ToDecimal(drDiscDefault["UOM_LEVEL"]);
                    }

                    decimal DiscQD = decimal.Zero;
                    if (!drOrdPrd.IsNull("UOM" + lvl + "_PRD_QTY") && drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString() != "" && gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) > decimal.Zero)
                    {
                        prdQty = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);
                        BuyUOM = drOrdPrd["UOM" + lvl + "_UOM_CD"].ToString();
                        DefaultUOMConv = gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);
                        decimal DCONV = gcs_Promo_Global.ToDecimal(1);
                        decimal UnitDiscBuyTypeUOM = decimal.Zero;

                        if (mechanicType == "2")
                        {
                            if (lvl > BuyTypeLvl)
                            {
                                for (int j = lvl; j > BuyTypeLvl; j--)
                                {
                                    if(j<=DefaultUOMLVL)//fix 34379
                                    {
                                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                    }
                                }
                            }
                            else if (lvl < BuyTypeLvl)
                            {

                                for (int k = lvl; k <= BuyTypeLvl; k++)
                                {
                                    DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                }
                            }
                            else
                            {
                                if (BuyTypeLvl < DefaultUOMLVL)
                                {
                                    for (int l = lvl; l <= DefaultUOMLVL; l++)
                                    {
                                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + l + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                    }
                                }
                                else if (BuyTypeLvl > DefaultUOMLVL)
                                {
                                    for (int m = lvl; m > DefaultUOMLVL; m--)
                                    {
                                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + m + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                    }
                                }
                                else
                                {
                                    DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + lvl + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                }
                            }
                        }
                        else if (mechanicType == "3")
                        {
                            if (lvl > BuyTypeLvl)
                            {
                                for (int j = lvl; j > BuyTypeLvl; j--)
                                {
                                    if(j<=DefaultUOMLVL)//fix 34379
                                    {
                                        DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                    }
                                }
                            }
                            else if (lvl < BuyTypeLvl)
                            {
                                for (int k = lvl; k <= BuyTypeLvl; k++)
                                {
                                    DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                                }
                            }
                            else
                            {
                                DCONV = gcs_Promo_Global.ToDecimal(1);
                            }

//                            if (lvl > BuyTypeLvl || lvl < BuyTypeLvl)//64872
//                            {
                            foreach (DataRow drDisc in this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "'" + " AND PRD_CD = '" + PRD_CD + "'"))
                            {
                                DCONV = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                                UnitDiscBuyTypeUOM = (uomXListPrc * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);//fix 20385
                                UnitDiscBuyTypeUOM = UnitDiscBuyTypeUOM / DCONV;
                            }
//                            else//64872
//                                UnitDiscBuyTypeUOM = (uomXListPrc * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);//fix 20385
                        }

//                        if (BuyTypeLvl > lvl || BuyTypeLvl < lvl)//64872
//                        {
                        decimal LvlConvSML = decimal.Zero;
                        decimal BuyTypeConvSML = decimal.Zero;

                        foreach (DataRow drDisc in dtSDiscList.Select("UOM_LEVEL = '" + lvl + "'" + " AND PRD_CD = '" + PRD_CD + "'"))
                        {
                            LvlConvSML = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                        }

                        foreach (DataRow drDisc in dtSDiscList.Select("UOM_LEVEL = '" + BuyTypeLvl + "'" + " AND PRD_CD = '" + PRD_CD + "'"))
                        {
                            BuyTypeConvSML = gcs_Promo_Global.ToDecimal(drDisc["CONV_FACTOR_SML"]);
                        }

                        if(mechanicType == "2" && ApplyOn == "1")
                            //DiscQUOM = Convert.ToInt32((((prdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(TotalBuy_Qty))); // * TotalBuy_Qty;//64872//78468
                            //DiscQUOM = (((prdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(TotalBuy_Qty)); // * TotalBuy_Qty;//78468
                            DiscQUOM = (((prdQty * LvlConvSML) / BuyTypeConvSML) / gcs_Promo_Global.ToDecimal(TBuy_Qty)) * TotalBuy_Qty;//78468//64872//69847
                        else
                                DiscQUOM = ((prdQty * LvlConvSML) / gcs_Promo_Global.ToDecimal(TBuy_Qty)) * TotalBuy_Qty;//64872//69847
//                        }//64872
//                        else
//                        {
//                            DiscQUOM = (gcs_Promo_Global.ToDecimal(prdQty) / gcs_Promo_Global.ToDecimal(TBuy_Qty)) * TotalBuy_Qty;
//                        }

                        if (DefaultUOMLVL < BuyTypeLvl)//64872//80247
                        {
                            DiscQD = gcs_Promo_Global.ToDecimal(DiscQUOM) * gcs_Promo_Global.ToDecimal(DCONV);
                        }
                        else if (DefaultUOMLVL > BuyTypeLvl)
                        {
                            DiscQD = gcs_Promo_Global.ToDecimal(DiscQUOM) / gcs_Promo_Global.ToDecimal(DCONV);
                        }
                        else
                        {
                            DiscQD = gcs_Promo_Global.ToDecimal(DiscQUOM);
                        }

                        if (mechanicType == "3") // by percentage
                        {
                            DiscAmt = gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM) * gcs_Promo_Global.ToDecimal(DiscQUOM);
                        }
                        else if (mechanicType == "2") // by value
                        {
                            if(schemeForEvery == "True" && scheme_prorata == "False")//10061
                                DiscAmt = gcs_Promo_Global.ToDecimal(factorvalue) * gcs_Promo_Global.ToDecimal(DiscQD) * (forEveryFactor / promoForEveryEnt);
                            else
                                DiscAmt = gcs_Promo_Global.ToDecimal(factorvalue) * gcs_Promo_Global.ToDecimal(DiscQD);
                        }
                        TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal(DiscAmt);
                    }
                    uomXPromoDisc = gcs_Promo_Global.ToDecimal(TotalDiscAmt);
                    unit_disc = gcs_Promo_Global.ToDecimal(uomXPromoDisc) / gcs_Promo_Global.ToDecimal(prdQty);
                }
                else if (buyType == "A")
                {
                    decimal GrossAmt = decimal.Zero;
                    decimal DiscQUOM = decimal.Zero;
                    decimal DefaultUOMConv = decimal.Zero;
                    decimal DiscAmt = decimal.Zero;
                    decimal TotalDiscAmt = decimal.Zero;
                    decimal GrossAmtRatio = decimal.Zero;
                    decimal DiscQtyInBuyUOM = decimal.Zero;
                    decimal DiscQtyInDEFUOM = decimal.Zero;
                    decimal prdQty = decimal.Zero;
                    decimal DCONV = gcs_Promo_Global.ToDecimal(1);
                    decimal DefaultUOMLVL = decimal.Zero;
                    decimal UnitDiscBuyTypeUOM = decimal.Zero;

                    prdQty = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);

                    foreach (DataRow drDiscDefault in this.dtSDiscList.Select("DEFAULT_UOM = 'True'" + " AND PRD_CD = '" + PRD_CD + "'"))
                    {
                        DefaultUOMLVL = gcs_Promo_Global.ToDecimal(drDiscDefault["UOM_LEVEL"]);
                    }

                    decimal DiscQD = decimal.Zero;
                    if (!drOrdPrd.IsNull("UOM" + lvl + "_GROSS_AMT") && drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString() != "" && gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]) > decimal.Zero)
                    {
                        if (mechanicType == "2")
                        {
                            DCONV = gcs_Promo_Global.ToDecimal(this.dtSDiscList.Select("UOM_LEVEL = '" + lvl + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR_SML"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"].ToString());
//                            if (lvl > DefaultUOMLVL)
//                            {
//                                for (int j = lvl; j > DefaultUOMLVL; j--)
//                                {
//                                    DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
//                                }
//                            }
//                            else if (lvl < DefaultUOMLVL)
//                            {
//                                for (int k = lvl; k <= DefaultUOMLVL; k++)
//                                {
//                                    DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
//                                }
//                            }
//                            else
//                            {
//                                DCONV = gcs_Promo_Global.ToDecimal(1);
//                            }
                        }
                        else if (mechanicType == "3")
                        {
                            UnitDiscBuyTypeUOM = (uomXListPrc * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);//fix 20385
                        }

                        GrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);

                        if (schemeForEvery == "True")//80182
                        {
                            decimal for_every = (decimal)EnhancedMath.RoundDown((double)(TBuy_Amt / promoForEveryEnt),0) * promoForEveryEnt;
                            GrossAmtRatio = (for_every * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(TBuy_Amt);
                        }
                        else
                            GrossAmtRatio = (gcs_Promo_Global.ToDecimal(TotalBuy_Qty) * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(TBuy_Amt);

                        //71272
                        //DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
                        DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / gcs_Promo_Global.ToDecimal(uomXListPrc);

                        if (promo_progress == "True")
                            DiscQtyInBuyUOM = DiscQtyInBuyUOM / TBuy_Qty * TBuy_Amt;

                        if (mechanicType == "2")
                        {
//                            if (lvl < DefaultUOMLVL)
//                            {
//                                DiscQtyInDEFUOM = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) / gcs_Promo_Global.ToDecimal(DCONV));
//                            }
//                            else if (lvl >= DefaultUOMLVL)
//                            {
//                                DiscQtyInDEFUOM = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(DCONV));
//                            }
                            DiscQtyInDEFUOM  = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(DCONV));
                            TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal(DiscQtyInDEFUOM) * gcs_Promo_Global.ToDecimal(factorvalue);
                        }
                        else if (mechanicType == "3")
                        {
                            TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM);
                        }
                    }
                    uomXPromoDisc = gcs_Promo_Global.ToDecimal(TotalDiscAmt);
                    unit_disc = gcs_Promo_Global.ToDecimal(uomXPromoDisc) / gcs_Promo_Global.ToDecimal(prdQty);
                }
            }

            if (mechanicType == "3" && scheme_prorata == "False" && scheme_QPS == "False" && scheme_combi == "False" && ApplyOn == "4")
            {
                decimal GrossAmt = decimal.Zero;
                decimal DiscQUOM = decimal.Zero;
                decimal DefaultUOMConv = decimal.Zero;
                decimal DiscAmt = decimal.Zero;
                decimal TotalDiscAmt = decimal.Zero;
                decimal GrossAmtRatio = decimal.Zero;
                decimal DiscQtyInBuyUOM = decimal.Zero;
                decimal DiscQtyInDEFUOM = decimal.Zero;
                decimal prdQty = decimal.Zero;
                decimal DCONV = gcs_Promo_Global.ToDecimal(1);
                decimal DefaultUOMLVL = decimal.Zero;
                decimal UnitDiscBuyTypeUOM = decimal.Zero;

                prdQty = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]);

                foreach (DataRow drDiscDefault in this.dtSDiscList.Select("DEFAULT_UOM = 'True'" + " AND PRD_CD = '" + PRD_CD + "'"))
                {
                    DefaultUOMLVL = gcs_Promo_Global.ToDecimal(drDiscDefault["UOM_LEVEL"]);
                }

                decimal DiscQD = decimal.Zero;
                if (!drOrdPrd.IsNull("UOM" + lvl + "_GROSS_AMT") && drOrdPrd["UOM" + lvl + "_GROSS_AMT"].ToString() != "" && gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]) > decimal.Zero)
                {
                    if (mechanicType == "2")
                    {
                        if (lvl > DefaultUOMLVL)
                        {
                            for (int j = lvl; j > DefaultUOMLVL; j--)
                            {
                                DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + j + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                            }
                        }
                        else if (lvl < DefaultUOMLVL)
                        {
                            for (int k = lvl; k <= DefaultUOMLVL; k++)
                            {
                                DCONV = DCONV * gcs_Promo_Global.ToDecimal(dtSDiscList.Select("UOM_LEVEL = '" + k + "' AND PRD_CD = '" + PRD_CD + "'")[0]["CONV_FACTOR"]);
                            }
                        }
                        else
                        {
                            DCONV = gcs_Promo_Global.ToDecimal(1);
                        }
                    }
                    else if (mechanicType == "3")
                    {
                        UnitDiscBuyTypeUOM = (uomXListPrc * gcs_Promo_Global.ToDecimal(factorvalue)) / gcs_Promo_Global.ToDecimal(100);//fix 20385
                    }

                    GrossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);
                    GrossAmtRatio = (gcs_Promo_Global.ToDecimal(TotalBuy_Qty) * gcs_Promo_Global.ToDecimal(GrossAmt)) / gcs_Promo_Global.ToDecimal(TBuy_Amt);
//fix 57970
//                    if(this.promo_price_group)
//                        GrossAmtRatio = GrossAmtRatio - ( uomXCustGrpDisc + uomXCustChnlDisc);
//                     if(GrossAmtRatio <0)
//                        GrossAmtRatio = 0;
                    //75452 incorrect price when promo_price_group = yes
                    //DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);
                    DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / uomXListPrc;
                    ////DiscQtyInBuyUOM = gcs_Promo_Global.ToDecimal(GrossAmtRatio) / uomXListPrc;// gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_LISTPRC"]);

                    if (mechanicType == "2")
                    {
                        if (lvl < DefaultUOMLVL)
                        {
                            DiscQtyInDEFUOM = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) / gcs_Promo_Global.ToDecimal(DCONV));
                        }
                        else if (lvl >= DefaultUOMLVL)
                        {
                            DiscQtyInDEFUOM = (gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(DCONV));
                        }
                        TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal(DiscQtyInDEFUOM) * gcs_Promo_Global.ToDecimal(factorvalue);
                    }
                    else if (mechanicType == "3")
                    {
                        TotalDiscAmt = gcs_Promo_Global.ToDecimal(TotalDiscAmt) + gcs_Promo_Global.ToDecimal(DiscQtyInBuyUOM) * gcs_Promo_Global.ToDecimal(UnitDiscBuyTypeUOM);
                    }
                }
                uomXInvPromoDisc = gcs_Promo_Global.ToDecimal(TotalDiscAmt);
                unit_disc = gcs_Promo_Global.ToDecimal(uomXInvPromoDisc) / Convert.ToDecimal(prdQty);
            }

            //calculate TDR
            if (scheme_TDR == "True")
            {
                if (mechanicType == "2") // Discount by Value
                {
                    //ApplyOn = Product
                    if(ApplyOn == "2")
                    { //TODO:TDR2
                     /*   uomXPromoDisc = (drOrdPrd.IsNull("UOM" + lvl + "_DISC_AMT") || drOrdPrd["UOM" + lvl + "_DISC_AMT"].ToString() == "")
                                            ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_DISC_AMT"]);

                    */
                        decimal ttlDiscAmt = 0;
                        foreach(DataRow row in drOrdPromos)
                        {
                            ttlDiscAmt += gcs_Promo_Global.ToDecimal(row["DISC_AMT"]);
                        }
                        uomXPromoDisc = ttlDiscAmt ;
                        drOrdPrd["UOM" + lvl + "_DISC_AMT"] =0 ;
                    }
                    //ApplyOn=UOM
                    else if(ApplyOn == "1") //TODO:TDR3
                    {
                        uomXPromoDisc = (drOrdPrd.IsNull("UOM" + lvl + "_DISC_AMT") || drOrdPrd["UOM" + lvl + "_DISC_AMT"].ToString() == "")
                                            ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_DISC_AMT"]);
                        drOrdPrd["UOM" + lvl + "_DISC_AMT"] =0 ;//Not sure why? Need to investigate further.
                    }
                    else
                    {
                        uomXPromoDisc = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(dPrdDisc / defUomConvfactor) * uomXPrdQty * uomXUomConvfactor).ToString("F" + this.gSetting.amtDecimal));

                        if(scheme_QPS == "True") //TODO:TDR7
                        {
                            uomXPromoDisc = (drOrdPrd.IsNull("UOM" + lvl + "_DISC_AMT") || drOrdPrd["UOM" + lvl + "_DISC_AMT"].ToString() == "")
                                            ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_DISC_AMT"]);
                        }
                    }

                }
                else if (mechanicType == "3" && scheme_QPS == "True")
                {
                    uomXPromoDisc = gcs_Promo_Global.ToDecimal((gcs_Promo_Global.ToDecimal(dPrdDisc / defUomConvfactor) * uomXPrdQty * uomXUomConvfactor).ToString("F" + this.gSetting.amtDecimal));
                }
                else if (mechanicType == "3" && scheme_QPS == "False") // Discount by Percentage
                {
                    uomXPromoDisc = gcs_Promo_Global.ToDecimal(drOrdPromos[0]["UOM" + lvl + "_PRD_DISC"]) * uomXPrdQty;
                }
            }

            //Only apply per invoice promo, and discount by value, on highest UOM leval
            if ((bPerInvoice && mechanicType == "2" && ApplyOn == "2") ||
                (!bPerInvoice && ApplyOn != "4") ||
                (mechanicType != "2" && ApplyOn != "4") ||
                (bPerInvoice && mechanicType == "2" && ApplyOn == "3"))
            {
                perInvoiceHasApply = true;
                drOrdPrd["UOM" + lvl + "_PROMO_DISC"] = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PROMO_DISC"]) + gcs_Promo_Global.ToDecimal((sumPrepPromoDisc + uomXPromoDisc).ToString("F" + this.gSetting.amtDecimal));
                drOrdPrd["UOM" + lvl + "_DISC_AMT"] = ((drOrdPrd.IsNull("UOM" + lvl + "_DISC_AMT") || drOrdPrd["UOM" + lvl + "_DISC_AMT"].ToString() == "")
                                 ? decimal.Zero :  gcs_Promo_Global.ToDecimal((sumPrepPromoDisc + uomXPromoDisc + uomXCustGrpDisc + uomXCustChnlDisc).ToString("F" + this.gSetting.amtDecimal)));  //gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_DISC_AMT"]) +
                drOrdPrd["DISC_AMT"] = (sumPrepPromoDisc + uomXPromoDisc + uomXCustGrpDisc + uomXCustChnlDisc).ToString("F" + this.gSetting.amtDecimal) + this.gSetting.gTxnUOMDisplayFormat;
                sumPrdDiscAmt = dPrdDisc;
                //drOrdPrd["PRD_DISC" + lvl] = gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_DISC" + lvl]) + sumPrdDiscAmt + (uomXCustGrpDisc/(uomXUomConvfactor*uomXPrdQty)) + (uomXCustChnlDisc/(uomXUomConvfactor*uomXPrdQty));
                drOrdPrd["PRD_DISC" + lvl] = gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_DISC" + lvl]) + sumPrdDiscAmt;//fix 57970 remove increasing cust group disc and chnl disc
                sumDiscAmt = sumPrepPromoDisc + gcs_Promo_Global.ToDecimal(uomXPromoDisc.ToString("F" + this.gSetting.amtDecimal));
                if (this.gFeatures.gIndiaTax)
                {
                    drOrdPrd["DISC_PERC"] = sumDistPerc;
                }
            }

            if ((!bPerInvoice && ApplyOn == "4") ||
                (mechanicType != "2" && ApplyOn == "4") ||
                (bPerInvoice && mechanicType == "2" && ApplyOn == "4"))
            {
                perInvoiceHasApply = true;
                drOrdPrd["UOM" + lvl + "_INVPROMO_DISC"] = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_INVPROMO_DISC"]) + gcs_Promo_Global.ToDecimal((uomXInvPromoDisc).ToString("F" + this.gSetting.amtDecimal));
                drOrdPrd["UOM" + lvl + "_INVDISC_AMT"] = ((drOrdPrd.IsNull("UOM" + lvl + "_INVDISC_AMT") || drOrdPrd["UOM" + lvl + "_INVDISC_AMT"].ToString() == "")
                                ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_INVDISC_AMT"])) + gcs_Promo_Global.ToDecimal((uomXInvPromoDisc).ToString("F" + this.gSetting.amtDecimal));

                drOrdPrd["UOM" + lvl + "_PROMO_DISC"] = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PROMO_DISC"]) + gcs_Promo_Global.ToDecimal((sumPrepPromoDisc + uomXPromoDisc).ToString("F" + this.gSetting.amtDecimal));
                drOrdPrd["UOM" + lvl + "_DISC_AMT"] = ((drOrdPrd.IsNull("UOM" + lvl + "_DISC_AMT") || drOrdPrd["UOM" + lvl + "_DISC_AMT"].ToString() == "")
                                ? decimal.Zero : gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_DISC_AMT"])) + gcs_Promo_Global.ToDecimal((sumPrepPromoDisc + uomXPromoDisc + uomXCustGrpDisc + uomXCustChnlDisc).ToString("F" + this.gSetting.amtDecimal));

                drOrdPrd["DISC_AMT"] = (sumPrepPromoDisc + uomXPromoDisc + uomXInvPromoDisc + uomXCustGrpDisc + uomXCustChnlDisc).ToString("F" + this.gSetting.amtDecimal) + this.gSetting.gTxnUOMDisplayFormat;

                sumPrdDiscAmt = dPrdDisc;
                //drOrdPrd["PRD_DISC" + lvl] = gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_DISC" + lvl]) + sumPrdDiscAmt + (uomXCustGrpDisc/uomXUomConvfactor*uomXPrdQty) + (uomXCustChnlDisc/uomXUomConvfactor*uomXPrdQty);
                drOrdPrd["PRD_DISC" + lvl] = gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_DISC" + lvl]) + sumPrdDiscAmt;//fix 57970 remove increasing cust group disc and chnl disc
                sumDiscAmt = sumPrepPromoDisc + gcs_Promo_Global.ToDecimal(uomXPromoDisc.ToString("F" + this.gSetting.amtDecimal)) + gcs_Promo_Global.ToDecimal(uomXInvPromoDisc.ToString("F" + this.gSetting.amtDecimal));
            }
            drOrdPrd["UOM" + lvl + "_UOM_LISTPRCDISC"] = list_prc_disc - unit_disc;
            // fix 43458
			unitDiscSml = unit_disc / uomXUomConvfactor;
        }
    }

    // fix 43458
//////    if(this.gFeatures.gIndiaTax)
//////    {
//////        DataRow[] drsPromoUnitDiscCalc = dtPromoUnitDiscCalc.Select("PRD_CD='" + drOrdPrd["PRD_CD"].ToString() + "'" +
//////        " AND PROMO_CD='" + promoCd + "' AND MRP='" + drOrdPrd["MRP"].ToString() + "'");
//////
//////        if( drsPromoUnitDiscCalc.Length > 0){
//////        	drsPromoUnitDiscCalc[0]["UNIT_DISC"] =unitDiscSml;
//////        }
//////    }

    return sumDiscAmt;
}


private decimal cpuPromoPriceGroup(decimal prdListPrc,decimal custChnlDiscPerc)
{
    if (promo_price_group)
    {
        // SC 20130523 - get prdListPrc base on decimal setting for calculation
        if (this.gFeatures.gIndiaTax == true)
            prdListPrc = prdListPrc -
            ( gcs_Promo_Global.ToDecimal((prdListPrc * (cust_grp_disc_perc+custChnlDiscPerc)  / 100).ToString("F" + this.gSetting.amtDecimal))
           // + gcs_Promo_Global.ToDecimal((prdListPrc * cust_chnl_disc_perc / 100).ToString("F" + this.gSetting.amtDecimal))
                );
        else
            prdListPrc = prdListPrc -
            ( gcs_Promo_Global.ToDecimal((prdListPrc * (this.cust_grp_disc_perc+custChnlDiscPerc) / 100))
            //+ gcs_Promo_Global.ToDecimal((prdListPrc * this.cust_chnl_disc_perc / 100))
            );
    }
    return prdListPrc;
}


// 7. Apply Tax and Re-calculate Amount
private void calcOrdPrdAllAmt(OfficeEngine Eng, DataTable dtOrdPrd)
{
    // Clear instead of delete one by one because prd_index will changed if new FOC is added
    if (this.gFeatures.gIndiaTax == true)
    {
        if (taxDetail != null)
            taxDetail.Clear();
    }
    else
    {
        // invoice level promotion adjustment
        this.adjustInvLvlDisc();
    }

    //for non-India
    decimal[] taxAmt = new decimal[4];
    decimal[] taxPerc = new decimal[3];
    string[] taxAccum = new string[3];

    //for india
    bool perInvoiceHasApply = false;
    bool perInvoice = false;
    decimal unit_tax_amt_tdr = decimal.Zero;

    // Flag for exceeded disc amount
    bool isDiscExceeded = false;
    string myfilter = "";

    if (this.gFeatures.gIndiaTax == true)
    {
        myfilter = "PRD_SLSTYPE = 'S' AND ISNULL(CHARGEFOC_IND,'False') <> 'True'";
    }
    else
    {
        myfilter = "PRD_SLSTYPE = 'S'";
    }

    foreach (DataRow drOrdPrd in dtOrdPrd.Select(myfilter + filterOutSBY())) // 0
    {
        //for india only
        SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTRUsed = new SortedDictionary<string, gcs_INDTax.INDTax.TaxRate>();
        SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTR = new SortedDictionary<string, gcs_INDTax.INDTax.TaxRate>();
        gcs_INDTax.INDTax.TaxRate TR = new gcs_INDTax.INDTax.TaxRate();
        string unitTaxOnGrid = "";
        string taxAmtOnGrid = "";
        string trKey = "";
        decimal prd_rate = decimal.Zero;
        decimal prd_unit_tax = decimal.Zero;
        if (this.gFeatures.gIndiaTax == true)
        {
            // reset for each sku
            perInvoiceHasApply = false;

            obj.PRD_CD = drOrdPrd["PRD_CD"].ToString();
            obj.MRP = gcs_Promo_Global.ToDecimal(drOrdPrd["MRP"]);
            obj.HSN_CD = drOrdPrd["HSN_CD"].ToString();
            // Mantis 0060585 : did not sum up the unit_disc accordingly.
            // use obj.UNIT_DISCOUNT to replace gcs_Promo_Global.ToDecimal(drOrdPrd["UNIT_DISC"]), and reset back to zero after the assignment to obj.DISCOUNT
            // 0060585 : sum up unit disc accordingly from dataTable dtPromoUnitDiscCalc for same product before tax calculation.
           foreach (DataRow drPromoUnitDiscCalc in dtPromoUnitDiscCalc.Select("PRD_CD = '" + drOrdPrd["PRD_CD"].ToString() + "' AND MRP = '" + drOrdPrd["MRP"].ToString() + "'"))
            {
                string per_product = drPromoUnitDiscCalc["PER_PRODUCT"].ToString();

                string schemeMRP = dtPromoEntitled.Select("PROMO_CD = '" + drPromoUnitDiscCalc["PROMO_CD"].ToString() + "'")[0]["SCHEME_MRP"].ToString();
                if (schemeMRP != "True" ||
                    (schemeMRP == "True" && drPromoUnitDiscCalc["MRP"].ToString() == drOrdPrd["MRP"].ToString()))
                {
                    obj.UNIT_DISCOUNT = obj.UNIT_DISCOUNT + gcs_Promo_Global.ToDecimal(drPromoUnitDiscCalc["UNIT_DISC"]);
                }

                // TDR DISCOUNT
                getSchemeTDR(Eng, drPromoUnitDiscCalc["PROMO_CD"].ToString());
                if (this.scheme_TDR == "True")
                {
                    decimal tax_sum = decimal.Zero;
                    decimal ttl_tax_sum = decimal.Zero;

                    SortedDictionary<string, gcs_INDTax.INDTax.TaxRate> dicTR_Sum = new SortedDictionary<string, gcs_INDTax.INDTax.TaxRate>();
                    gcs_INDTax.INDTax.TaxRate TR_Sum = new gcs_INDTax.INDTax.TaxRate();
                    dicTR_Sum = obj.CalculateTax(taxList);
                    foreach (KeyValuePair<string, gcs_INDTax.INDTax.TaxRate> kvp in dicTR_Sum)
                    {
                        TR_Sum = kvp.Value;
                        if (TR_Sum.APPLY_SEQ == "1")
                            tax_sum = (TR_Sum.TAX_PERC / 100) * 100;
                        else
                            tax_sum = (TR_Sum.TAX_PERC / 100) * tax_sum;

                        ttl_tax_sum += tax_sum;
                    }

                    if (drPromoUnitDiscCalc["MECHANIC_TYPE"].ToString() == "2")
                    {
                        unit_tax_amt_tdr = unit_tax_amt_tdr + gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drPromoUnitDiscCalc["UNIT_DISC"])); //.ToString("F" + this.gSetting.amtDecimal));
                        obj.UNIT_DISCOUNT = unit_tax_amt_tdr;
                    }
                }
            }


            //for channel and extra discount
            decimal unit_disc_chnl =decimal.Zero;

             decimal unit_disc_extra =decimal.Zero;
            decimal unit_disc =decimal.Zero;
            for(int lvl=1 ;lvl<=4;lvl++)
            {
                if(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_PRD_QTY"])>0)
                {
                if (drOrdPrd.Table.Columns.Contains("UOM"+lvl+"_CUST_CHNL_DISC"))
                     unit_disc_chnl = gcs_Promo_Global.ToDecimal( drOrdPrd["UOM"+lvl+"_CUST_CHNL_DISC"])/
                        (gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"])* gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_UOM_CONVFACTOR"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_PRD_QTY"]) )
                        * gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);

                if (drOrdPrd.Table.Columns.Contains("UOM"+lvl+"_CUST_EXTRA_DISC"))
                     unit_disc_extra = gcs_Promo_Global.ToDecimal( drOrdPrd["UOM"+lvl+"_CUST_EXTRA_DISC"])/
                        (gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_UOM_CONVFACTOR"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_PRD_QTY"]) )
                        * gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);

                 if (drOrdPrd.Table.Columns.Contains("UOM"+lvl+"_DISC_AMT"))
                     unit_disc = gcs_Promo_Global.ToDecimal( drOrdPrd["UOM"+lvl+"_DISC_AMT"])/
                        (gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_UOM_CONVFACTOR"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM"+lvl+"_PRD_QTY"]) )
                        * gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"]);

            }
            }

            obj.DISCOUNT = unit_disc  + unit_disc_extra ; ///Assuming unit_disc is containing unit_chnl_disc
            obj.CUST_DISC_PERC = CustDisc;
            unit_tax_amt_tdr = decimal.Zero;
            obj.UNIT_DISCOUNT = decimal.Zero;

            dicTR = obj.CalculateTax(taxList);
            prd_rate = obj.Rate;
            prd_unit_tax = obj.UnitTax;
        }


        drOrdPrd["NET_AMT"] = "";
        decimal netAmt = decimal.Zero, grossAmt = decimal.Zero, promoDisc = decimal.Zero, slsDisc = decimal.Zero;
        decimal custGrpDisc = decimal.Zero, totalCustGrpDisc = decimal.Zero;
        decimal custChnlDisc = decimal.Zero, totalCustChnlDisc = decimal.Zero;
        decimal uomXDiscAmt = decimal.Zero;
        decimal prdListPric = decimal.Zero;
        decimal tmp_custGrpDisc = decimal.Zero;
        decimal tmp_custChnlDisc = decimal.Zero;

        //invoice level
        decimal uomXInvDiscAmt = decimal.Zero;
        decimal InvpromoDisc = decimal.Zero;

        // Reset flag
        isDiscExceeded = false;

        //UOM4~1
        decimal custDiscAmt = decimal.Zero;
        for (int lvl = 4; lvl > 0; lvl--)
        {
            int uomPrdQty = 0;
            int.TryParse(drOrdPrd["UOM" + lvl + "_PRD_QTY"].ToString(), out uomPrdQty);
            if (uomPrdQty > 0)
            {
                grossAmt = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_GROSS_AMT"]);
                promoDisc = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PROMO_DISC"]);
                slsDisc = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_SLS_DISC"]);

                if (this.gFeatures.gIndiaTax != true)
                    InvpromoDisc = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_INVPROMO_DISC"].ToString());

                // added by SC - 20130523 to solve decimal issue
                prdListPric = gcs_Promo_Global.ToDecimal(drOrdPrd["PRD_LISTPRC"]);
                decimal d_cust_chnl_disc_perc = decimal.Zero;
                 if(drOrdPrd.Table.Columns.Contains("CUST_CHNL_DISC_PERC"))
                   d_cust_chnl_disc_perc= gcs_Promo_Global.ToDecimal(drOrdPrd["CUST_CHNL_DISC_PERC"]);

                if (this.gFeatures.gIndiaTax == true)
                {
                    tmp_custGrpDisc = gcs_Promo_Global.ToDecimal((prdListPric * (this.cust_grp_disc_perc) / 100));
                    tmp_custGrpDisc = gcs_Promo_Global.ToDecimal((tmp_custGrpDisc * gcs_Promo_Global.ToDecimal(uomPrdQty) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"])).ToString("F" + this.gSetting.amtDecimal));

                    tmp_custChnlDisc = gcs_Promo_Global.ToDecimal((prdListPric * (d_cust_chnl_disc_perc) / 100));
                    tmp_custChnlDisc = gcs_Promo_Global.ToDecimal((tmp_custChnlDisc * gcs_Promo_Global.ToDecimal(uomPrdQty) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) / gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"])).ToString("F" + this.gSetting.amtDecimal));
                }
                else
                {
                    tmp_custGrpDisc = gcs_Promo_Global.ToDecimal(
                        (gcs_Promo_Global.ToDecimal(
                            (prdListPric * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) /
                                gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"])).ToString("F" + this.gSetting.amtDecimal)) *
                                gcs_Promo_Global.ToDecimal(uomPrdQty) * this.cust_grp_disc_perc / 100).ToString("F" + this.gSetting.amtDecimal)
                             );

                    tmp_custChnlDisc = gcs_Promo_Global.ToDecimal(
                        (gcs_Promo_Global.ToDecimal(
                            (prdListPric * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) /
                                gcs_Promo_Global.ToDecimal(drOrdPrd["DEF_UOM_CONVFACTOR"])).ToString("F" + this.gSetting.amtDecimal)) *//75585
                                gcs_Promo_Global.ToDecimal(uomPrdQty) * d_cust_chnl_disc_perc / 100).ToString("F" + this.gSetting.amtDecimal)
                             );
                }

                custGrpDisc = tmp_custGrpDisc;
                totalCustGrpDisc += custGrpDisc;

                custChnlDisc = tmp_custChnlDisc;
                totalCustChnlDisc += custChnlDisc;

                uomXDiscAmt = promoDisc + custGrpDisc + slsDisc + custChnlDisc;

                if (this.gFeatures.gIndiaTax == true)
                {
                    netAmt = grossAmt - uomXDiscAmt;
                }
                else
                {
                    uomXInvDiscAmt = InvpromoDisc;
                    netAmt = grossAmt - (uomXDiscAmt + uomXInvDiscAmt);
                }

                // once one of its uom net amt is negative, whole sku is not taxed.
                // tax amt should not set to zero, should tax sku without disc
                if (netAmt < 0)
                {
                    if (this.gFeatures.gIndiaTax == true)
                    {
                        // Reset tax amount to zero to avoid -ve tax amt
                        drOrdPrd["UOM" + lvl + "_UNIT_TAX"] = gcs_Promo_Global.ToRoundDecimal(decimal.Zero, this.gSetting.amtDecimal);
                        drOrdPrd["UOM" + lvl + "_TAX_AMT"] = gcs_Promo_Global.ToRoundDecimal(decimal.Zero, this.gSetting.amtDecimal);
                        drOrdPrd["UOM" + lvl + "_TAX_AMT_DISP"] = gcs_Promo_Global.ToRoundDecimal(decimal.Zero, this.gSetting.amtDecimal);
                    }
                    isDiscExceeded = true;

                }
                else // still need to tax sku with unit tax without disc for india
                {
                    if (this.gFeatures.gIndiaTax == true)
                    {
                        drOrdPrd["UOM" + lvl + "_UNIT_TAX"] = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]) * gcs_Promo_Global.ToDecimal(prd_unit_tax)); //.ToString("F4");
                        dicTRUsed = dicTR;

                        unitTaxOnGrid += gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UNIT_TAX"]).ToString("F" + this.gSetting.amtDecimal) + this.gSetting.gTxnUOMDisplayFormat;
                        //round here
                        decimal unit_tax_amt = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UNIT_TAX"].ToString()) * gcs_Promo_Global.ToDecimal(uomPrdQty)).ToString("F" + this.gSetting.amtDecimal));
                        drOrdPrd["UOM" + lvl + "_TAX_AMT"] = unit_tax_amt;
                        drOrdPrd["UOM" + lvl + "_TAX_AMT_DISP"] = unit_tax_amt;
                        taxAmtOnGrid += unit_tax_amt + this.gSetting.gTxnUOMDisplayFormat;

                        // insert records for TXN_ORDPRD_TAX
                        foreach (KeyValuePair<string, gcs_INDTax.INDTax.TaxRate> kvp in dicTRUsed)
                        {
                            trKey = kvp.Key;
                            TR = kvp.Value;

                            if (taxDetail == null)
                            {
                                taxDetail = new DBXmlDataTable();
                                taxDetail.Columns.Add("PRD_CD");
                                taxDetail.Columns.Add("PRD_INDEX",Type.GetType("System.Int32"));
                                taxDetail.Columns.Add("UOM_CD");
                                taxDetail.Columns.Add("UNIT_TAX");
                                taxDetail.Columns.Add("TAX_AMT");
                                taxDetail.Columns.Add("TAXRATE_CD");
                                taxDetail.Columns.Add("TAXSTRUCT_CD");
                                taxDetail.Columns.Add("TAX_PERC");
                                taxDetail.Columns.Add("CALON_1");
                                taxDetail.Columns.Add("CALON_2");
                                taxDetail.Columns.Add("CALON_3");
                                taxDetail.Columns.Add("APPLY_SEQ");
                                taxDetail.Columns.Add("TAX_CD");
                                taxDetail.Columns.Add("TAXRATE_DESC");
                                taxDetail.Columns.Add("TAXDEF_LEVEL");
                            }

                            DataRow tdRow = taxDetail.NewRow();
                            tdRow["PRD_CD"] = drOrdPrd["PRD_CD"];
                            tdRow["PRD_INDEX"] = drOrdPrd["PRD_INDEX"];
                            tdRow["UOM_CD"] = drOrdPrd["UOM" + lvl + "_UOM_CD"];
                            tdRow["UNIT_TAX"] = TR.UNIT_TAX * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]);
                            //round here
                            tdRow["TAX_AMT"] = gcs_Promo_Global.ToDecimal(gcs_Promo_Global.ToDecimal(tdRow["UNIT_TAX"]) * gcs_Promo_Global.ToDecimal(uomPrdQty)).ToString("F" + this.gSetting.amtDecimal);
                            tdRow["TAXRATE_CD"] = TR.TAXRATE_CD;
                            tdRow["TAXSTRUCT_CD"] = TR.TAXSTRUCT_CD;
                            tdRow["TAX_PERC"] = TR.TAX_PERC;
                            tdRow["CALON_1"] = TR.CALON_1;
                            tdRow["CALON_2"] = TR.CALON_2;
                            tdRow["CALON_3"] = TR.CALON_3;
                            tdRow["APPLY_SEQ"] = TR.APPLY_SEQ;
                            tdRow["TAX_CD"] = TR.TAX_CD;
                            tdRow["TAXRATE_DESC"] = TR.TAXRATE_DESC;
                            tdRow["TAXDEF_LEVEL"] = TR.TAXDEF_LEVEL;
                            taxDetail.Rows.Add(tdRow);
                        }
                    }
                }

                drOrdPrd["UOM" + lvl + "_CUST_GRP_DISC"] = gcs_Promo_Global.ToDecimal(custGrpDisc);
                if(drOrdPrd.Table.Columns.Contains("UOM" + lvl + "_CUST_CHNL_DISC"))
                    drOrdPrd["UOM" + lvl + "_CUST_CHNL_DISC"] = gcs_Promo_Global.ToDecimal(custChnlDisc).ToString("F" + this.gSetting.amtDecimal);
                drOrdPrd["UOM" + lvl + "_DISC_AMT"] = uomXDiscAmt;
                drOrdPrd["UOM" + lvl + "_DISC_AMT_DISP"] = drOrdPrd["UOM" + lvl + "_DISC_AMT"];
                drOrdPrd["UOM" + lvl + "_NET_AMT"] = (netAmt < 0 ? 0 : netAmt).ToString("F" + this.gSetting.amtDecimal);
                drOrdPrd["UOM" + lvl + "_NET_AMT_DISP"] = drOrdPrd["UOM" + lvl + "_NET_AMT"];

                if (this.gFeatures.gIndiaTax == true)
                {
                    drOrdPrd["UOM" + lvl + "_NET_AMT_TAX"] = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"]) + gcs_Promo_Global.ToRoundDecimal(drOrdPrd["UOM" + lvl + "_TAX_AMT"], this.gSetting.amtDecimal));
                    drOrdPrd["UOM" + lvl + "_NET_AMT_TAX_DISP"] = drOrdPrd["UOM" + lvl + "_NET_AMT_TAX"];
                    drOrdPrd["NET_AMT"] += gcs_Promo_Global.ToRoundDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"], this.gSetting.amtDecimal).ToString() + this.gSetting.gTxnUOMDisplayFormat;
                    drOrdPrd["NET_AMT_DISP"] = drOrdPrd["NET_AMT"];
                }
                else
                {
                    drOrdPrd["UOM" + lvl + "_INVDISC_AMT"] = uomXInvDiscAmt;
                    drOrdPrd["UOM" + lvl + "_INVDISC_AMT_DISP"] = drOrdPrd["UOM" + lvl + "_INVDISC_AMT"];
                    if (drOrdPrd["TAX_IND"].ToString() == "True")
                    {
                        if(!this.gFeatures.gIndiaTax)//QPS Process Order
                        {
                            drOrdPrd["UOM" + lvl + "_CUST_DISC"] = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"]) * this.CustDisc / 100 ;
                        }

                        if (this.gFeatures.gMyTax)
                        {
                            taxPerc[0] = gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_TAX_PERC"]);
                            taxPerc[1] = 0;
                            taxPerc[2] = 0;

                            taxAccum[0] = "N";
                            taxAccum[1] = "N";
                            taxAccum[2] = "N";

                            drOrdPrd["UOM" + lvl + "_TAX_PERC1"] = drOrdPrd["UOM" + lvl + "_TAX_PERC"];
                            drOrdPrd["UOM" + lvl + "_TAX_PERC2"] = "0.0000";
                            drOrdPrd["UOM" + lvl + "_TAX_PERC3"] = "0.0000";
                            taxAmt = gcs_Promo_TXNController.calcTaxAmt(this.gSetting.amtDecimal, Eng, taxPerc, taxAccum, gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"]) - gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_DISC"]));
                            drOrdPrd["UOM" + lvl + "_TAX_AMT1"] = taxAmt[0];
                            drOrdPrd["UOM" + lvl + "_TAX_AMT2"] = "0.0000";
                            drOrdPrd["UOM" + lvl + "_TAX_AMT3"] = "0.0000";
                        }
                        else
                        {
                            taxPerc[0] = this.dist_tax_perc1;
                            taxPerc[1] = this.dist_tax_perc2;
                            taxPerc[2] = this.dist_tax_perc3;

                            taxAccum[0] = this.dist_tax_accumulative1;
                            taxAccum[1] = this.dist_tax_accumulative2;
                            taxAccum[2] = this.dist_tax_accumulative3;

                            drOrdPrd["UOM" + lvl + "_TAX_PERC1"] = this.dist_tax_perc1;
                            drOrdPrd["UOM" + lvl + "_TAX_PERC2"] = this.dist_tax_perc2;
                            drOrdPrd["UOM" + lvl + "_TAX_PERC3"] = this.dist_tax_perc3;
                            taxAmt = gcs_Promo_TXNController.calcTaxAmt(this.gSetting.amtDecimal, Eng, taxPerc, taxAccum, gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"]) - gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_CUST_DISC"]));
                            drOrdPrd["UOM" + lvl + "_TAX_AMT1"] = taxAmt[0];
                            drOrdPrd["UOM" + lvl + "_TAX_AMT2"] = taxAmt[1];
                            drOrdPrd["UOM" + lvl + "_TAX_AMT3"] = taxAmt[2];
                        }
                    }
                    else
                    {
                        drOrdPrd["UOM" + lvl + "_TAX_PERC1"] = "0.0000";
                        drOrdPrd["UOM" + lvl + "_TAX_PERC2"] = "0.0000";
                        drOrdPrd["UOM" + lvl + "_TAX_PERC3"] = "0.0000";
                        drOrdPrd["UOM" + lvl + "_TAX_AMT1"] = "0.0000";
                        drOrdPrd["UOM" + lvl + "_TAX_AMT2"] = "0.0000";
                        drOrdPrd["UOM" + lvl + "_TAX_AMT3"] = "0.0000";
                    }
                    drOrdPrd["UOM" + lvl + "_TAX_AMT"] = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_TAX_AMT1"]) + gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_TAX_AMT2"]) + gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_TAX_AMT3"])).ToString("F" + this.gSetting.amtDecimal);
                    drOrdPrd["UOM" + lvl + "_NET_AMT_TAX"] = (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"]) + gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_TAX_AMT"])).ToString("F" + this.gSetting.amtDecimal);
                    drOrdPrd["NET_AMT"] += (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_NET_AMT"])).ToString("F" + this.gSetting.amtDecimal) + this.gSetting.gTxnUOMDisplayFormat;
                    drOrdPrd["NET_AMT_DISP"] = drOrdPrd["NET_AMT"];
                }

            }
            else
            {
                drOrdPrd["UOM" + lvl + "_DISC_AMT"] = System.DBNull.Value;
            }
        }

        if (this.gFeatures.gIndiaTax == true)
        {
            for (int lvl = 1; lvl <= 4; lvl++)
            {
                //decimal rateAfterDisc = Math.Round((obj.Rate - obj.UNIT_DISCOUNT), 4);
                decimal rateAfterDisc = gcs_Promo_Global.ToDecimal((obj.Rate - obj.UNIT_DISCOUNT).ToString("F4"));// + this.gSetting.amtDecimal);
                if (!DBNull.Value.Equals(drOrdPrd["UOM" + lvl + "_PRD_QTY"]))
                {
                    custDiscAmt = custDiscAmt + gcs_Promo_Global.ToDecimal((obj.CUST_DISC_AMT * (gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_PRD_QTY"]) * gcs_Promo_Global.ToDecimal(drOrdPrd["UOM" + lvl + "_UOM_CONVFACTOR"]))).ToString("F" + this.gSetting.amtDecimal));
                }
            }
            if (drOrdPrd.Table.Columns.Contains("CUST_DISC_AMT"))
            {
                drOrdPrd["CUST_DISC_AMT"] = gcs_Promo_Global.ToDecimal(custDiscAmt).ToString("F" + this.gSetting.amtDecimal);
            }
        }
        drOrdPrd["CUST_GRP_DISC"] =  gcs_Promo_Global.ToDecimal(totalCustGrpDisc).ToString("F" + this.gSetting.amtDecimal);
        if(drOrdPrd.Table.Columns.Contains("CUST_CHNL_DISC"))
            drOrdPrd["CUST_CHNL_DISC"] = gcs_Promo_Global.ToDecimal(totalCustChnlDisc).ToString("F" + this.gSetting.amtDecimal);

        // Check if item's net amount is negative
        if (isDiscExceeded)
        {
            // Find discount promotions applied on this product
            string filter = string.Format("PRD_CD='{0}' AND MECHANIC_TYPE<>'1' AND PRD_INDEX='{1}'", drOrdPrd["PRD_CD"].ToString(), drOrdPrd["PRD_INDEX"].ToString());
            DataRow[] prdPromoDiscs = dtOrdPromoDiscApplied.Select(filter);

            if (prdPromoDiscs.Length > 0)
            {
                foreach (DataRow dr in prdPromoDiscs)
                {
                    // Avoid duplicate
                    DataRow[] dt = dtPromoDiscExceeded.Select("PROMO_CD = '" + dr["PROMO_CD"].ToString() + "'");
                    if (dt.Length == 0)
                    {
                        // Add to dtPromoDiscExceeded (alert message will be prompted in SaveData() instead of checkSelectedPromoBudget() )
                        DataRow drPromoDiscExceeded = dtPromoDiscExceeded.NewRow();
                        drPromoDiscExceeded["PROMO_SEQ"] = dr["PROMO_SEQ"].ToString();
                        drPromoDiscExceeded["PROMO_CD"] = dr["PROMO_CD"].ToString();
                        drPromoDiscExceeded["PRD_CD"] = dr["PRD_CD"].ToString();
                        drPromoDiscExceeded["PRD_INDEX"] = dr["PRD_INDEX"].ToString();
                        dtPromoDiscExceeded.Rows.Add(drPromoDiscExceeded);
                    }
                }
            }
        }
    }
}



private void adjustInvLvlDisc()
{
    DataTable dtOrdPrd, dtOrdPromo, dtInvLvlPromoPerUOM;
    if (this.calc_hq == true)
    {
        dtOrdPrd = this.dtOrdPrdHq;
        dtOrdPromo = this.dtOrdPromoHq;
        dtInvLvlPromoPerUOM = this.dtInvLvlPromoPerUOMHq;
    }
    else
    {
        dtOrdPrd = this.dtOrdPrd;
        dtOrdPromo = this.dtOrdPromo;
        dtInvLvlPromoPerUOM = this.dtInvLvlPromoPerUOM;
    }
    decimal invLvlDiscSum = 0, invLvlDiscAtFooter = 0;
    int uomLvl = 1;
    string promoCd = "";
    DataRow drChanged = null;

    // identify SKU UOM line to be applied difference
    if (this.gSetting.gCustDiscAdj == "A")
    {
        int prdIdx = 0;
        decimal largestAmt = 0;
        foreach (DataRow dr in dtOrdPrd.Select("PRD_SLSTYPE='S' AND PARENT_PRD=''", ""))
        {
            for (int i = 4; i > 0; i--)
            {
                if (gcs_Promo_Global.ToDecimal(dr["UOM" + i + "_NET_AMT"]) >= largestAmt)
                {
                    largestAmt = gcs_Promo_Global.ToDecimal(dr["UOM" + i + "_NET_AMT"]);
                    uomLvl = i;
                    prdIdx = gcs_Promo_Global.ToInt32(dr["PRD_INDEX"].ToString());
                }
            }
        }
        if( prdIdx > 0 )
            drChanged = ((DataTable)dtOrdPrd).Select("PRD_SLSTYPE='S' AND PARENT_PRD='' AND PRD_INDEX=" + prdIdx, "")[0];
    }
    // carry difference to last sku uom
    else if (this.gSetting.gCustDiscAdj == "L")
    {
        if(dtOrdPrd.Rows.Count>0)
        {
            drChanged = ((DataTable)dtOrdPrd).Select("PRD_SLSTYPE='S' AND  PARENT_PRD=''", "PRD_INDEX DESC, PRD_CD ASC")[0];
            for (int i = 4; i > 0; i--)
            {
                if (gcs_Promo_Global.ToDecimal(drChanged["UOM" + i + "_NET_AMT"]) > 0)
                {
                    uomLvl = i;
                    break;
                }
            }
        }
    }
    else
    {
        // do nothing
        return;
    }

    foreach (DataRow drPromoEntitledDtl in dtPromoEntitledDtl.Select("MECHANIC_TYPE<>1 AND APPLY_ON=4"))
    {
        promoCd = drPromoEntitledDtl["PROMO_CD"].ToString();

        // get total inv disc of the promo
        DataRow[] drTtlInv = dtOrdPromo.Select("PROMO_CD='" + promoCd + "'");
        if (drTtlInv != null && drTtlInv.Length > 0)
        {
            invLvlDiscAtFooter = gcs_Promo_Global.ToDecimal(drTtlInv[0]["TTL_DISC_AMT"].ToString());
        }
        else
        {
            invLvlDiscAtFooter = gcs_Promo_Global.ToDecimal("0");
        }
        invLvlDiscSum = decimal.Zero;//Fix 50125
        // get sum of each inv disc of uom
        foreach (DataRow dr in dtInvLvlPromoPerUOM.Select("PROMO_CD='" + promoCd + "'"))
        {
            invLvlDiscSum += gcs_Promo_Global.ToDecimal(dr["UOM_INVDISC"]);
        }

        // compare
        if (invLvlDiscSum != invLvlDiscAtFooter)
        {
            // get difference
            decimal invDiscDiff = (invLvlDiscSum - invLvlDiscAtFooter) * -1;

            // carry difference to the sku uom line
            drChanged["UOM" + uomLvl + "_INVDISC_AMT"] = gcs_Promo_Global.ToDecimal(drChanged["UOM" + uomLvl + "_INVDISC_AMT"]) + invDiscDiff;
            drChanged["UOM" + uomLvl + "_INVPROMO_DISC"] = drChanged["UOM" + uomLvl + "_INVDISC_AMT"];
        }
    }
}


//---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ----------

internal void checkSelectedPromoBudget(OfficeEngine Eng, string distCd, string slsmanCd)
{
    DataRow drPromoBudget = null;

    decimal var_promoDiscAmt = decimal.Zero;

    // Promotion Details
    string var_mechanic_type = "";
    string var_foc_prd_cd = "";
    string var_foc_uom_cd = "";
    int var_foc_qty = 0;
    decimal var_foc_listprc = decimal.Zero;
    decimal var_factor_value = decimal.Zero;
    int var_foc_ratio = 1;

    // Order Product details
    string var_prd_cd = "";
    int var_prd_index = 0;
    int var_prd_qty_sml = 0;
    int var_def_uom_convfactor = 0;
    int var_uom4_uom_convfactor = 0;
    int var_uom3_uom_convfactor = 0;
    int var_uom2_uom_convfactor = 0;
    int var_uom1_uom_convfactor = 0;
    decimal var_prd_listprc = decimal.Zero;
    decimal var_prd_disc = decimal.Zero;
    decimal var_disc_amt_temp = decimal.Zero;
    bool notApplyPromo = false;
    int notApplyType = 0;

    // Promotion budget that already allocate to temporary invoice
    decimal var_promoBudgetSoftAllocated = decimal.Zero;
    string insufficientFOCPromoCd = "", invalidFOCPromoCd = "", exceedBudgetPromoCd = "";
    string toApply = "Y";
    string toApplyFOC = "N";

    // Temporary variable
    DataRow drPromoSelectedTemp = null;
    DataRow drPromoSelected = null;
    DataRow[] drOrdPromos = null;
    DataRow[] drPromoDiscExceededs = null;

    this.countPromoSelected = 0;
    this.maxPromoSelected = dtPromoSelected.Rows.Count;

    while (this.countPromoSelected < this.maxPromoSelected) // 0
    {
        this.countPromoSelectedStop = this.countPromoSelected;
        var_promoBudgetSoftAllocated = decimal.Zero;

        drPromoSelected = (dtPromoSelected.Select("", "PROMO_SEQ ASC"))[countPromoSelected];

        // For update PRD_DISC purpose
        string selPromoCd = drPromoSelected["PROMO_CD"].ToString();

        drPromoBudget = null;
        var_promoDiscAmt = decimal.Zero;
        notApplyPromo = false;

        if ((drPromoSelected["HasFocPromo"].ToString() == "Y")) // if promotion has foc mechanic
        {
            string promo_Cd = drPromoSelected["PROMO_CD"].ToString();
            foreach (DataRow drOrdPromo in dtOrdPromo.Select("PROMO_CD = '" + promo_Cd + "'" + " AND PRD_SLSTYPE = 'F'"))
            {
                string prd_Cd = drOrdPromo["PRD_CD"].ToString();
                foreach (DataRow drOrdPrd in dtOrdPrd.Select("PRD_CD = '" + prd_Cd + "'" + " AND PRD_SLSTYPE = 'F'"))
                {
                    if (drOrdPrd.IsNull("DEF_UOM_CD") || drOrdPrd["DEF_UOM_CD"].ToString() == "")
                    {
                        notApplyPromo = true;
                        notApplyType = 1;
                        if (invalidFOCPromoCd != "")
                        {
                            invalidFOCPromoCd += "\n";
                        }
                        invalidFOCPromoCd = invalidFOCPromoCd + promo_Cd + " - " + drOrdPrd["PRD_CD"].ToString();
                        break;
                    }
                    //stock check only for invoice, order can proceed even not sufficient product
                    if ((this.txnMode != Enum.TxnMode.ORDER_NEW) && (this.txnMode != Enum.TxnMode.ORDER_EDIT))
                    {

                        if (this.txnMode == Enum.TxnMode.INVOCE_NEW)
                        {
                            if (Convert.ToInt32(drOrdPrd["PRD_QTY_SML"]) > Convert.ToInt32(drOrdPrd["AVAILABLE_STK"]))
                            {
                                notApplyPromo = true;
                                notApplyType = 1;
                                if (insufficientFOCPromoCd != "")
                                {
                                    insufficientFOCPromoCd += "\n";
                                }
                                insufficientFOCPromoCd = insufficientFOCPromoCd + promo_Cd + " - " + drOrdPrd["PRD_CD"].ToString();
                                break;
                            }
                        }
                        else if (this.txnMode == Enum.TxnMode.INVOICE_EDIT)
                        {
                            DataRow drAvailableStk = null;
                            int availableStk = 0;
                            int ttlQty = 0;

                            if (this.gFeatures.gIndiaTax == true)
                            {
                                ttlQty = Convert.ToInt32(drOrdPrd["PRD_QTY_SML"]);
                            }
                            else
                            {
                                foreach (DataRow dr in this.dtOrdPrd.Select("PRD_CD = '" + prd_Cd + "' AND PRD_SLSTYPE = 'S'"))
                                {
                                    ttlQty = ttlQty + Convert.ToInt32(dr["PRD_QTY_SML"]);
                                }

                                ttlQty = ttlQty + Convert.ToInt32(drOrdPrd["PRD_QTY_SML"]);
                            }

                            if (ttlQty > Convert.ToInt32(drOrdPrd["AVAILABLE_STK"]))
                            {
                                notApplyPromo = true;
                                notApplyType = 1;
                                if (insufficientFOCPromoCd != "")
                                {
                                    insufficientFOCPromoCd += "\n";
                                }
                                insufficientFOCPromoCd = insufficientFOCPromoCd + promo_Cd + " - " + drOrdPrd["PRD_CD"].ToString();
                                break;
                            }
                            else
                            {
                                foreach (DataRow drTxnAllocatedQty in dtTempTxnAllocatedQty.Select("PRD_CD = '" + drOrdPrd["PRD_CD"] + "'"))
                                {
                                    drTxnAllocatedQty["ALLOCATED_QTY"] = Convert.ToInt32(drTxnAllocatedQty["ALLOCATED_QTY"]) - Convert.ToInt32(drOrdPrd["PRD_QTY_SML"]);
                                }
                            }
                        }
                    }
                }
                if (notApplyPromo)
                    break;
            }
        } // end if promotion has foc mechanic

        drOrdPromos = (DataRow[])dtOrdPromo.Select("PROMO_CD='" + selPromoCd + "'");
        foreach (DataRow drOrdPromo in drOrdPromos)
        {
            var_promoDiscAmt = var_promoDiscAmt + gcs_Promo_Global.ToDecimal(drOrdPromo.IsNull("DISC_AMT") ? 0 : drOrdPromo["DISC_AMT"]);
        }

        if (this.dtTxnOrdPromo != null && txnMode == Enum.TxnMode.INVOICE_EDIT
            && ((DataRow[])dtTxnOrdPromo.Select("PROMO_CD = '" + drPromoSelected["PROMO_CD"].ToString() + "'")).Length > 0)
        {
            var_promoBudgetSoftAllocated = gcs_Promo_Global.ToDecimal(dtTxnOrdPromo.Compute("SUM(BUDGET_AMT)", "PROMO_CD = '" + drPromoSelected["PROMO_CD"].ToString() + "'"));
        }

        if (gcs_Promo_Global.ToDecimal(drPromoSelected["BUDGET"]) > decimal.Zero && notApplyPromo == false)
        {
            DataRow[] drPromoBudgets = this.dtPromoSelectedBudget.Select("DIST_CD='" + drPromoSelected["DIST_CD"].ToString() + "' AND PROMO_CD='" + drPromoSelected["PROMO_CD"].ToString() + "'");
            if (drPromoBudgets.Length > 0)
                drPromoBudget = drPromoBudgets[0];
            else
                drPromoBudget = null;
            //drPromoBudget = usp_Promo_Fun.getPromoBudget(Eng, drPromoSelected["DIST_CD"].ToString(), drPromoSelected["PROMO_CD"].ToString(), distCd, slsmanCd, this.Cust_cd);

            if (var_promoDiscAmt > gcs_Promo_Global.ToDecimal(drPromoBudget["BALANCE"]) + gcs_Promo_Global.ToDecimal(drPromoBudget["SOFT_ALLOC"]) + var_promoBudgetSoftAllocated)
            {
                notApplyPromo = true;
                notApplyType = 2;
                if (exceedBudgetPromoCd != "")
                {
                    exceedBudgetPromoCd += "\n";
                }
                exceedBudgetPromoCd = exceedBudgetPromoCd + drPromoSelected["PROMO_CD"].ToString();
            }
        }

        if (notApplyPromo)
        {
            DataRow drPromoNotApply = dtPromoNotApply.NewRow();
            drPromoNotApply["PROMO_SEQ"] = drPromoSelected["PROMO_SEQ"];
            drPromoNotApply["DIST_CD"] = drPromoSelected["DIST_CD"];
            drPromoNotApply["PROMO_CD"] = drPromoSelected["PROMO_CD"];
            drPromoNotApply["PROMO_DESC"] = drPromoSelected["PROMO_DESC"];
            drPromoNotApply["START_DT"] = drPromoSelected["START_DT"];
            drPromoNotApply["END_DT"] = drPromoSelected["END_DT"];
            drPromoNotApply["BUDGET"] = drPromoSelected["BUDGET"];
            drPromoNotApply["FOC_RATIO"] = drPromoSelected["FOC_RATIO"];
            drPromoNotApply["NOT_APPLY_TYPE"] = notApplyType;
            dtPromoNotApply.Rows.Add(drPromoNotApply);

            // Delete FOC product from dtOrdPrd
            string promo_Cd = drPromoSelected["PROMO_CD"].ToString();
            foreach (DataRow drOrdPromo in dtOrdPromo.Select("PROMO_CD = '" + promo_Cd + "'" + " AND PRD_SLSTYPE = 'F'"))
            {
                string prd_Cd = drOrdPromo["PRD_CD"].ToString();

                foreach (DataRow drOrdPrd in dtOrdPrd.Select("PRD_CD = '" + prd_Cd + "'" + " AND PRD_SLSTYPE = 'F'"))
                {
                    DataRow[] otherPromo = this.dtPromoFocPrd.Select("PROMO_CD <> '" + promo_Cd + "' AND FOC_PRD_CD = '" + prd_Cd + "'");
                    DataRow[] currentPromo = this.dtPromoFocPrd.Select("PROMO_CD = '" + promo_Cd + "' AND FOC_PRD_CD = '" + prd_Cd + "'");

                    if (otherPromo.Length <= 0)
                    {
                        dtOrdPrd.Rows.Remove(drOrdPrd);
                    }
                    if (currentPromo.Length > 0)
                        dtPromoFocPrd.Rows.Remove(currentPromo[0]);
                }
            }

            // Delete Promotion from dtOrdPromo which will not be applied
            foreach (DataRow drOrdPromo in dtOrdPromo.Select("PROMO_CD = '" + promo_Cd + "'"))
            {
                dtOrdPromo.Rows.Remove(drOrdPromo);
            }

            //2011-03-30 dtPromoDetail data not deleted when save order
            // Delete Promotion from dtPromoDetail which will not be applied
            foreach (DataRow drPromoDetail in dtPromoDetail.Select("PROMO_CD = '" + promo_Cd + "'"))
            {
                dtPromoDetail.Rows.Remove(drPromoDetail);
            }

            // Delete Promotion from dtOrdPromoTempApplied which will not be applied
            foreach (DataRow drOrdPromoDiscApplied in dtOrdPromoDiscApplied.Select("PROMO_CD = '" + promo_Cd + "'"))
            {
                dtOrdPromoDiscApplied.Rows.Remove(drOrdPromoDiscApplied);
            }

            foreach (DataRow drPromoToApply in dtPromoToApply.Select("PROMO_CD = '" + promo_Cd + "'"))
            {
                dtPromoToApply.Rows.Remove(drPromoToApply);
            }

            //2011-12-27
            //Fix Issue: 0036790: Transaction > Order > Add Order > Fail to apply promotion with correct quantity
            foreach (DataRow drSelectedFocList in dtSelectedFocList.Select("PROMO_CD = '" + Convert.ToString(drPromoSelected["PROMO_CD"]) + "'"))
            {
                dtSelectedFocList.Rows.Remove(drSelectedFocList);
            }

            // delete unit disc for india env
            if (this.gFeatures.gIndiaTax == true)
            {
                foreach (DataRow drPromoUnitDiscCalc in dtPromoUnitDiscCalc.Select("PROMO_CD = '" + Convert.ToString(drPromoSelected["PROMO_CD"]) + "'"))
                {
                    dtPromoUnitDiscCalc.Rows.Remove(drPromoUnitDiscCalc);
                }
            }

            countPromoSelected = countPromoSelected + 1;
        }
        else
        {
            countPromoSelected = countPromoSelected + 1;
        }
    }
    string errorMsg = "";
    if (invalidFOCPromoCd != "")
    {
        errorMsg = Eng.Localization.GetText("Promotion(s) below will not be applied due to invalid Free Product:") + "\n" + invalidFOCPromoCd;
    }
    if (insufficientFOCPromoCd != "")
    {
        if (errorMsg != "")
        {
            errorMsg += "\n";
        }
        errorMsg = errorMsg + Eng.Localization.GetText("Promotion(s) below will not be applied due to insufficient Free Product:") + "\n" + insufficientFOCPromoCd;
    }
    if (exceedBudgetPromoCd != "")
    {
        if (errorMsg != "")
        {
            errorMsg += "\n";
        }
        errorMsg = errorMsg + Eng.Localization.GetText("Promotion(s) below will not be applied due to promotion exceeded budget:") + "\n" + exceedBudgetPromoCd;
    }

    if (errorMsg != "")
    {
        Eng.API.Alert(errorMsg);
    }
    ///this.calcOrdPrdPromoDisc(Eng,obj,taxList,dtOrdPrd,dtPromoEntitled,dtOrdPromo, dtOrdPromoDiscApplied, dtSDiscList,dtPromoUnitDiscCalc,dtPromoDiscExceeded,taxDetail,txnMode, sales_disc_ind, cust_grp_disc_perc,promo_price_group,CustDisc,this.gSetting.amtDecimal,gTxnUOMDisplayFormat);
    this.calcOrdPrdPromoDisc(this.Eng, dtOrdPrd);
}


//---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ---------- ----------

internal void AssignPrevSelPromo()
{
    DBXmlDataTable tblTmp = dtPromoSelected;

    for (int i = tblTmp.Rows.Count - 1; i >= 0; i--)
    {
        DataRow[] drS = null;
        DataRow row = tblTmp.Rows[i];
        DataRow[] rowTmps = dtOrdPromoDiscApplied.Select("PROMO_CD = '" + row["PROMO_CD"].ToString() + "'");
        if (rowTmps.Length <= 0)
        {
            drS = this.dtOrdPromo.Select("PROMO_CD = '" + row["PROMO_CD"].ToString() + "'");
            if (drS.Length <= 0)
                tblTmp.Rows.RemoveAt(i);
        }
    }
    dtPromoSelectedPrev = tblTmp;
}

public decimal CalculateAllProductGrossAmtTax(DataRow[] products)
{
    decimal result = 0;

    foreach (DataRow row in products)
    {
        decimal tax = gcs_Promo_Global.ToDecimal(row["TAX_SUM_PERC"]);
        result += GetProductGrossAmtWithTax(row, tax);
    }

    return result;
}

public decimal GetProductGrossAmtWithTax(DataRow product, decimal tax)
{
    decimal prdGrossAmt = 0;
    decimal grossAmt = 0;

    //Bug 64705: fix prorata yes rounding issue
    prdGrossAmt = (product.IsNull("UOM1_GROSS_AMT") || product["UOM1_GROSS_AMT"].ToString() == "")
                        ? decimal.Zero : gcs_Promo_Global.ToDecimal(product["UOM1_GROSS_AMT"]);
    //grossAmt = Math.Round(prdGrossAmt * (1 + (tax / 100)), 4);
    grossAmt += gcs_Promo_Global.ToDecimal(((prdGrossAmt * (1 + (tax / 100)))).ToString());

    prdGrossAmt = (product.IsNull("UOM2_GROSS_AMT") || product["UOM2_GROSS_AMT"].ToString() == "")
                        ? decimal.Zero : gcs_Promo_Global.ToDecimal(product["UOM2_GROSS_AMT"]);
    //grossAmt += Math.Round(prdGrossAmt * (1 + (tax / 100)), 4);
    grossAmt += gcs_Promo_Global.ToDecimal(((prdGrossAmt * (1 + (tax / 100)))).ToString());

    prdGrossAmt = (product.IsNull("UOM3_GROSS_AMT") || product["UOM3_GROSS_AMT"].ToString() == "")
                        ? decimal.Zero : gcs_Promo_Global.ToDecimal(product["UOM3_GROSS_AMT"]);
    //grossAmt += Math.Round(prdGrossAmt * (1 + (tax / 100)), 4);
    grossAmt += gcs_Promo_Global.ToDecimal(((prdGrossAmt * (1 + (tax / 100)))).ToString());

    prdGrossAmt = (product.IsNull("UOM4_GROSS_AMT") || product["UOM4_GROSS_AMT"].ToString() == "")
                        ? decimal.Zero : gcs_Promo_Global.ToDecimal(product["UOM4_GROSS_AMT"]);
    //grossAmt += Math.Round(prdGrossAmt * (1 + (tax / 100)), 4);
    grossAmt += gcs_Promo_Global.ToDecimal(((prdGrossAmt * (1 + (tax / 100)))).ToString());

    return grossAmt;
}

public void UpdateBenefit(string promo_cd, decimal accu_disc, decimal accu_disc_tax)
{
    DataRow[] drsQPSTotalBenefit = dtOrdPromoQPSApplicableBenefit.Select("PROMO_CD='" + promo_cd +  "'");
    if (drsQPSTotalBenefit.Length == 0)
    {
        DataRow drNew = dtOrdPromoQPSApplicableBenefit.NewRow();
        drNew["PROMO_CD"] = promo_cd;
        drNew["ACCU_DISCAMT"] = accu_disc;
        drNew["ACCU_DISCAMT_TAX"] = accu_disc_tax;

        dtOrdPromoQPSApplicableBenefit.Rows.Add(drNew);
    }
    else
    {
        foreach (DataRow dr in drsQPSTotalBenefit)
        {
            dr["ACCU_DISCAMT"] = gcs_Promo_Global.ToDecimal(dr["ACCU_DISCAMT"].ToString()) + accu_disc;//64769
            dr["ACCU_DISCAMT_TAX"] = gcs_Promo_Global.ToDecimal(dr["ACCU_DISCAMT_TAX"].ToString()) + accu_disc_tax;
        }
    }
}

public void SumBenefitWithPreviousBenefit()
{
    if(!dtOrdPromoDiscApplied.Columns.Contains("ACCU_DISCAMT_TAX")) return;

    DataRow [] prdAndPromo = this.dtOrdPromoDiscApplied.Select("", "PROMO_CD");
    string previous = "", current = "";
    foreach(DataRow r in prdAndPromo)
    {
        current = r["PROMO_CD"].ToString();
        if(current != previous)
        {
            decimal accu_discamt_tax = gcs_Promo_Global.ToDecimal(r["ACCU_DISCAMT_TAX"]);

            DataRow[] drsQPSTotalBenefit = dtOrdPromoQPSApplicableBenefit.Select("PROMO_CD='" + current +  "'");

            foreach (DataRow dr in drsQPSTotalBenefit)
            {
                dr["ACCU_DISCAMT_TAX"] = gcs_Promo_Global.ToDecimal(dr["ACCU_DISCAMT_TAX"]) + accu_discamt_tax;
            }
        }

        previous = current;
    }
}

public static class EnhancedMath
{
    private delegate double RoundingFunction(double value);

    private enum RoundingDirection { Up, Down }

    public static double RoundUp(double value, int precision)
    {
        return Round(value, precision, RoundingDirection.Up);
    }

    public static double RoundDown(double value, int precision)
    {
        return Round(value, precision, RoundingDirection.Down);
    }

    private static double Round(double value, int precision,
                RoundingDirection roundingDirection)
    {
        RoundingFunction roundingFunction;
        if (roundingDirection == RoundingDirection.Up)
            roundingFunction = Math.Ceiling;
        else
            roundingFunction = Math.Floor;
        value *= Math.Pow(10, precision);
        value = roundingFunction(value);
        return value * Math.Pow(10, -1 * precision);
    }
}
